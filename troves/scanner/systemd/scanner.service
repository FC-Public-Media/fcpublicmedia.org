# The scanner's screen on tty1. `install` writes this with @TROVE@ and @STATE@ filled in.
[Unit]
Description=scanner screen (tty1)
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
User=fcpm
WorkingDirectory=@STATE@
ExecStartPre=+/usr/bin/setfont -C /dev/tty1 /usr/share/consolefonts/Uni2-TerminusBold28x14.psf.gz
ExecStart=/usr/bin/python3 @TROVE@/inbox.py
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux LANG=C.UTF-8 PYTHONUNBUFFERED=1 QR_STATE=@STATE@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
