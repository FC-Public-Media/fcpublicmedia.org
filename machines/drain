#!/usr/bin/env python3
"""drain -- the site-worker's tanks (KV) into ~/fcpm/answers/<tank>/ (or $FCPM_ANSWERS), emptied behind: its own
bin/drain.mjs from the checkout beside this one, with the keychain's `cloudflare` group. One machine's crew holds
the `drain` line at a time. See digitization/PROFILE.md#replies.
"""
import os
import pathlib
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
SW = pathlib.Path(os.environ.get("FCPM_SITE_WORKER") or HERE.parents[1] / "site-worker")
if not (SW / "bin" / "drain.mjs").is_file():
    sys.exit(f"drain: no site-worker checkout at {SW}")
sys.exit(subprocess.run([sys.executable, str(HERE / "keys"), "run", "cloudflare", "--",
                         "node", str(SW / "bin" / "drain.mjs")] + sys.argv[1:]).returncode)
