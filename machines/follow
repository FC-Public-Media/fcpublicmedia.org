#!/bin/sh
# follow -- a bay takes its orders from main on our origin. The crew's `follow` line, every 5 minutes,
# from bay 1's menu (production.yml), on every bay whose crew orders it: one way for all of them.
#
#   each pass     this repository's mirror from the origin's main (bin/refs; never GitHub)
#   once a week   every mirror and the people's working copy, from the origin too
#   then          what the profile maps (sync install), when the mirror moved and every 15 minutes, so a
#                 hand change comes back
#
# Fast-forward only, never over local changes (bin/refs). A move that touches what the crew's lines run
# (troves/) has the crew restart them; a new crew.py is the pool's to restart, since a supervisor cannot
# restart itself from a line it runs (machines/pool.ps1, Supervisor). It runs from the crew, so it needs no
# one signed in. See docs/station.md, fcpm.

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)
NAME=$(basename "$REPO")
STATE="${LOCALAPPDATA:-$HOME/.local/state}/fcpm"
HOLD=15
mkdir -p "$STATE"

# Pull from the origin: this mirror every pass; every mirror and the working copy once a week.
"$REPO/bin/refs" pull "$NAME" | grep -E 'UPDATED|FAILED|skipped'
week=$(date +%G-W%V)
[ "$(cat "$STATE/weekly.done" 2>/dev/null)" = "$week" ] || { "$HERE/watch" weekly && echo "weekly: pulled for $week"; }

# Place: when the mirror moved, and every $HOLD minutes however it stands.
head=$(git -C "$REPO" rev-parse HEAD) || exit 1
placed="$STATE/follow.placed"   # what it last put on; sync keeps its own records in placed/
was=$(cat "$placed" 2>/dev/null)
[ "$head" = "$was" ] && [ -n "$(find "$placed" -mmin -$HOLD 2>/dev/null)" ] && exit 0
out=$("$HERE/sync" install 2>&1); rc=$?
out=$(printf '%s\n' "$out" | grep -v '^profile ' | sed '/^$/d')
[ "$head" != "$was" ] && echo "placed $(printf '%.7s' "$head")"
[ -n "$out" ] && printf '%s\n' "$out"
[ $rc -eq 0 ] || { echo "follow: sync install did not finish; the next pass tries again"; exit $rc; }
printf '%s\n' "$head" > "$placed"

# The crew's lines run what moved: ask the crew to restart them (all but this one, which is ending).
[ -n "$was" ] && [ "$head" != "$was" ] || exit 0
git -C "$REPO" diff --quiet "$was" "$head" -- troves 2>/dev/null && exit 0
p=$(SYNC_CHECK=0 "$HERE/sync" 2>/dev/null | awk '$1 == "profile" { print $2; exit }')
lines=$(sed -e 's/#.*$//' "$HERE/$p/services" 2>/dev/null | awk 'NF >= 3 && $1 != "follow" { print $1 }')
[ -n "$lines" ] && echo "troves moved: restarting $(echo $lines)" && sh "$HERE/fcpm" crew restart $lines
exit 0
