mirror    home/code/CLAUDE.md                code/CLAUDE.md
mirror    home/code/AGENTS.md                code/AGENTS.md
mirror    home/code/BAY2.md                  code/BAY2.md

mirror    ../production/home/git/ignore      .config/git/ignore

mirror    ../production/home/bin/fcpm.cmd    .local/bin/fcpm.cmd
