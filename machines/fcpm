#!/bin/sh
# fcpm — the crew's one switch on an FCPM machine: every verb a person runs
# here, by name, the same in cmd and PowerShell. Alone, it is the watcher
# (./watch). Verbs: `fcpm help`. Doc: machines/README.md, "The crew's one switch".

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)
CODE="$HOME/code"
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) PLAT=windows ;; *) PLAT=linux ;; esac

# What fcpm.yml says does VERB on this platform, a line per entry.
does() {
  awk -v verb="$1" -v plat="$PLAT" '
    function val(s) { sub(/^[^:]*:[ ]*/, "", s); gsub(/^"|"$/, "", s); return s }
    /^  - verb:/ { v = val($0); next }
    v == verb && $0 ~ "^    " plat ":" { print val($0) }
  ' "$HERE/fcpm.yml"
}

# Not on this machine: say what stands in, and exit 3, apart from a failure.
not_here() { echo "fcpm $cmd: not on this machine: $*" >&2; exit 3; }

profile() { "$HERE/sync" 2>/dev/null | awk '$1 == "profile" { print $2; exit }'; }

pyrun() {
  # [--with PKG]... [python] SCRIPT ARGS: by uv, its Python 3.12 and the packages; where uv is not (a card's Alpine),
  # by this system's python3, when it has the packages. A window opened before uv was installed finds it where winget puts it.
  uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
  [ -x "$uv" ] && exec "$uv" run --no-project --python 3.12 "$@"
  while [ "${1:-}" = --with ]; do
    case $2 in pyyaml) m=yaml ;; pyserial) m=serial ;; *) m=$2 ;; esac
    python3 -c "import $m" 2>/dev/null || { echo "fcpm: no uv here, and this system's python3 lacks $2" >&2; exit 1; }
    shift 2
  done
  [ "${1:-}" = python ] && shift
  exec python3 "$@"
}

ps1() {
  # The one way a .ps1 is run here: as the pool's logon task runs its own,
  # and as the crew's GRANTS names it.
  f=$1; shift
  powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$f" 2>/dev/null || echo "$f")" "$@"
}

cmd=${1:-watch}; [ $# -gt 0 ] && shift
d=$(does "$cmd")
[ -n "$d" ] && ! printf '%s\n' "$d" | grep -qv '^not:' && not_here "$(printf '%s\n' "$d" | sed 's/^not: *//' | head -n 1)"
case "$cmd" in
  watch)     exec "$HERE/watch" ;;
  status)    exec "$HERE/sync" ;;
  provision) exec sh "$HERE/cards/provision" "$@" ;;
  card)
    case "${1:-}" in sync) shift; exec "$HERE/cards/sync" "$@" ;; "") exec "$HERE/cards/sync" ;; *) echo "fcpm card [sync [/dev/sdX]]" >&2; exit 2 ;; esac ;;
  install)
    # This machine as its profile says: this checkout from the origin's main (./pull), what the profile
    # places, the engines, the profile's system steps (FCPM_DESK: a person is here, so one may ask for an
    # administrator). A job named is put on before `names` lists it (start.ps1).
    export FCPM_DESK=1
    sh "$HERE/pull"
    if [ $# -gt 0 ]; then "$HERE/sync" -p "$1" install || exit; else "$HERE/sync" install || exit; fi
    # The rest of the submodules, as this commit names them; the troves (`update = none`) came with pull.
    out=$(GCM_INTERACTIVE=never GIT_TERMINAL_PROMPT=0 git -C "$REPO" submodule update --init --recursive --quiet 2>&1) \
      || { printf '%s\n' "$out" | grep -v "^Skipping submodule '" >&2
           echo "fcpm: an engine did not come down; fcpm install again, and say so if it still does not"; } ;;
  check)
    p=$(profile)
    [ -n "$p" ] || { echo "fcpm: this machine wears no profile"; exit 0; }
    if [ -f "$HERE/$p/check.ps1" ]; then ps1 "$HERE/$p/check.ps1"
    elif [ -f "$HERE/$p/check.sh" ]; then sh "$HERE/$p/check.sh"
    else echo "fcpm: $p carries no check"; fi
    # Every other job this machine's name is in (machines/README.md: a computer in two jobs does both).
    rc=$?; h=$(hostname 2>/dev/null | cut -d. -f1)
    for n in "$HERE"/*/names; do
      j=$(basename "$(dirname "$n")")
      [ "$j" = "$p" ] || [ ! -f "$HERE/$j/check.sh" ] && continue
      awk -v h="$h" 'tolower($3) == tolower(h) { f = 1 } END { exit !f }' "$n" || continue
      echo "-- $j"; sh "$HERE/$j/check.sh" || rc=1
    done
    exit $rc ;;
  dev)
    # The LAN's switch is the origin's (../origin/dev); the flag here paces this machine's crew's follow line.
    f="${LOCALAPPDATA:-$HOME/.local/state}/fcpm/dev"
    o=${FCPM_ORIGIN_SSH:-fcpm-origin}
    case "${1:-status}" in
      on|off)
        if [ "$1" = on ]; then mkdir -p "$(dirname "$f")" && : > "$f"; else rm -f "$f"; fi
        ssh -o BatchMode=yes -o ConnectTimeout=10 "$o" dev "$1" 2>/dev/null | sed 's/^/origin.local /' ||
          echo "origin.local did not answer; this machine's pool is $1, the LAN's switch is unchanged" ;;
      status)
        ssh -o BatchMode=yes -o ConnectTimeout=10 "$o" dev status 2>/dev/null | sed 's/^/origin.local /' ||
          echo "origin.local did not answer"
        [ -f "$f" ] && echo "here: dev on" || echo "here: dev off" ;;
      *) echo "fcpm dev [status|on|off]" >&2; exit 2 ;;
    esac ;;
  deploy)
    # Alone or with --build: fcpublicmedia.org onto Cloudflare Pages (machines/deploy-site), from any machine whose
    # keychain holds `cloudflare`. With SITE DIR: a finished site onto the static host (static/deploy).
    case "${1:-}" in ""|--build) exec "$REPO/bin/deploy-site" "$@" ;; esac
    exec "$HERE/static/deploy" "$@" ;;
  lines)
    # This machine's lines on the LAN: piles told and read through the origin (docs/lines.md).
    exec python3 "$HERE/lines" "$@" ;;
  keys)
    # The keychain of the jobs this machine wears (keys; each job's keys.yml).
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*)
      pyrun --with pyyaml --with qrcode python "$HERE/keys" "$@" ;;
    esac
    exec python3 "$HERE/keys" "$@" ;;
  keep)
    # The branches the origin keeps current with main (origin/KEPT), as its last beat left them.
    out=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "${FCPM_ORIGIN_SSH:-fcpm-origin}" kept 2>/dev/null) &&
      printf '%s\n' "$out" | sed 's/^/origin.local /' || echo "origin.local did not answer; what it keeps is machines/origin/KEPT" ;;
  relay)
    # The origin's mode (../origin/door): on, what is pushed there goes out to GitHub on intake's
    # 15-minute pass; off, LAN-only: it pulls, and what is pushed waits there.
    case "${1:-status}" in
      on|off|status) ssh -o BatchMode=yes -o ConnectTimeout=10 "${FCPM_ORIGIN_SSH:-fcpm-origin}" relay "${1:-status}" |
                       sed 's/^/origin.local /' || echo "origin.local did not answer" ;;
      *) echo "fcpm relay [status|on|off]" >&2; exit 2 ;;
    esac ;;
  pool)
    # The bays' pool, where the profile's MANIFEST holds it (`held ../pool.ps1`): the mirror's file, as the task runs it.
    p=$(profile)
    grep -qs '^held  *\.\./pool\.ps1' "$HERE/$p/MANIFEST" || { echo "fcpm: ${p:-this machine} keeps no pool"; exit 0; }
    ps1 "$HERE/pool.ps1" "$@" ;;
  runnables) exec "$REPO/bin/runnables" "$@" ;;
  recorder)  ps1 "$REPO/troves/recorder/obs.ps1" "$@" ;;
  env)       ps1 "$REPO/troves/recorder/env.ps1" "$@" ;;
  roku)      ps1 "$REPO/troves/roku/roku.ps1" "$@" ;;
  screen)    ps1 "$REPO/troves/kiosk-screen/screen.ps1" "$@" ;;
  audition)
    p=$(profile)
    [ -f "$HERE/$p/audition.ps1" ] || { echo "fcpm: ${p:-this machine} carries no Audition panel"; exit 0; }
    ps1 "$HERE/$p/audition.ps1" "$@" ;;
  drobo|share|audit|model|helm)
    p=$(profile)
    [ -f "$HERE/$p/$cmd.ps1" ] || { echo "fcpm: ${p:-this machine} carries no $cmd"; exit 0; }
    ps1 "$HERE/$p/$cmd.ps1" "$@" ;;
  pools)
    pyrun --with pyyaml "$REPO/troves/pools/pools.py" "$@" ;;
  crew)
    # This machine's crew (machines/<job>, production on bay 1): what its supervisor
    # keeps, asked live. `serve` is what the crew's service runs; in a window, it tries it.
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) ;; *)
      # Linux: this machine's own job, by crew.sh (fcpm-crew@<job>), and crew.py by python3.
      case "${1:-status}" in
        status|install|uninstall) exec sh "$HERE/crew.sh" "${1:-status}" "$(profile)" ;;
        restart) shift; exec python3 "$REPO/machines/crew.py" restart "$(profile)" "$@" ;;
        *) exec python3 "$REPO/machines/crew.py" "$@" ;;
      esac ;;
    esac
    case "${1:-status}" in
      status|install|uninstall) p=$(profile); ps1 "$REPO/machines/crew.ps1" "${1:-status}" ${p:+"$p"} ;;   # this machine's crew's task, and what it keeps; install is an administrator's
      restart)  # the supervisor reads its order and menus again, and restarts what it started (or the lines named)
                shift; p=$(profile); pyrun --with pyyaml "$REPO/machines/crew.py" restart "${p:-production}" "$@" ;;
      episodes) shift; pyrun --with pyyaml "$REPO/troves/pools/episodes.py" "${@:-status}" ;;
      *)        # crew.py's crew is its last word (`log NAME [CREW]`, `check [CREW]`): this machine's, unless named
                p=$(profile); n=1; [ "$1" = log ] && n=2
                [ $# -eq $n ] && [ -n "$p" ] && set -- "$@" "$p"
                pyrun --with pyyaml "$REPO/machines/crew.py" "$@" ;;
    esac ;;
  library)
    # The library's holdings on this machine (library.yml, machines/<profile>/library.yml).
    # A machine wearing several jobs keeps its holdings in the one that has a library.yml.
    p=$("$HERE/sync" 2>/dev/null | awk '$1 == "profile" { print $2 }' | while read -r j; do
      [ -f "$HERE/$j/library.yml" ] && { echo "$j"; break; }; done)
    export FCPM_PROFILE=${p:-$(profile)}; pyrun --with pyyaml "$HERE/library.py" "$@" ;;
  workshed)
    # Worktrees someone works in, each served on its own port (~/code/workshed, docs/workshed.md).
    # pyyaml and the profile: what the library's grant book needs to record a worktree made and a port served.
    export FCPM_PROFILE=$(profile) PYTHONDONTWRITEBYTECODE=1; pyrun --with pyyaml "$HERE/workshed.py" "$@" ;;
  consoles)
    # What this machine holds up to read, a screen each (~/code/consoles, docs/consoles.md).
    export FCPM_PROFILE=$(profile) PYTHONDONTWRITEBYTECODE=1; pyrun --with pyyaml "$HERE/consoles.py" "$@" ;;
  places)
    # An origin branch's repositories, as a listing Fighter's location providers read.
    export PYTHONDONTWRITEBYTECODE=1; pyrun "$HERE/places.py" "$@" ;;
  issues)
    # A repository's issues in one look: its .issues file and each line's history (docs/issues.md).
    export PYTHONDONTWRITEBYTECODE=1; pyrun "$HERE/issues.py" "$@" ;;
  post)
    pyrun --with pyyaml "$REPO/troves/post/post.py" "$@" ;;
  camera)
    pyrun --with comtypes --with pyyaml "$REPO/troves/camera/camera.py" "$@" ;;
  ti89)
    pyrun --with pyserial "$REPO/troves/ti-89/cable/link.py" "$@" ;;
  hear|say)  exec python3 "$HERE/loudspeaker" "$cmd" "$@" ;;
  help|-h|--help)
    awk -v plat="$PLAT" '
      function val(s) { sub(/^[^:]*:[ ]*/, "", s); gsub(/^"|"$/, "", s); return s }
      function flush() {
        if (v == "") return
        c = "fcpm " v (a != "" ? " " a : "")
        if (p ~ /^not:/) away = away sprintf("  %s\n      %s\n", c, substr(p, 6))
        else here = here sprintf("  %s\n      %s\n", c, s)
      }
      /^  - verb:/        { flush(); v = val($0); a = s = p = ""; next }
      /^    args:/        { a = val($0); next }
      /^    says:/        { s = val($0); next }
      $0 ~ "^    " plat ":" { p = val($0); next }
      END { flush(); printf "fcpm, on %s:\n%s", plat, here
            if (away != "") printf "\nNot on %s yet, and what stands in:\n%s", plat, away }
    ' "$HERE/fcpm.yml" ;;
  *) echo "fcpm: no verb '$cmd'. fcpm help" >&2; exit 2 ;;
esac
