#!/bin/sh
# fcpm — the crew's one switch on an FCPM machine: every verb a person runs
# here, by name, the same in cmd and PowerShell. Alone, it is the watcher
# (./watch). Verbs: `fcpm help`. Doc: machines/README.md, "The crew's one switch".

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)
CODE="$HOME/code"

profile() { "$HERE/sync" 2>/dev/null | awk '$1 == "profile" { print $2; exit }'; }

ps1() {
  # The one way a .ps1 is run here: as the pool's logon task runs its own,
  # and as the crew's GRANTS names it.
  f=$1; shift
  powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$f" 2>/dev/null || echo "$f")" "$@"
}

cmd=${1:-watch}; [ $# -gt 0 ] && shift
case "$cmd" in
  watch)     exec "$HERE/watch" ;;
  status)    exec "$HERE/sync" ;;
  install)
    "$HERE/sync" install || exit
    "$HERE/watch" copy
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) "$HERE/watch" weekly install ;; esac ;;
  weekly)    exec "$HERE/watch" weekly ;;
  check)
    p=$(profile)
    [ -n "$p" ] || { echo "fcpm: this machine wears no profile"; exit 0; }
    if [ -f "$HERE/$p/check.ps1" ]; then ps1 "$HERE/$p/check.ps1"
    elif [ -f "$HERE/$p/check.sh" ]; then sh "$HERE/$p/check.sh"
    else echo "fcpm: $p carries no check"; fi ;;
  refs)      exec "$CODE/bin/refs" "$@" ;;
  pool)
    [ -f "$CODE/bin/pool.ps1" ] || { echo "fcpm: this machine keeps no pool"; exit 0; }
    ps1 "$CODE/bin/pool.ps1" "$@" ;;
  runnables) exec "$REPO/bin/runnables" "$@" ;;
  recorder)  ps1 "$REPO/troves/recorder/obs.ps1" "$@" ;;
  screen)    ps1 "$REPO/troves/kiosk-screen/screen.ps1" "$@" ;;
  camera)
    # uv brings its own Python; a window opened before uv was installed may not
    # have it on PATH, so fall back to where winget puts it.
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with comtypes --with pyyaml "$REPO/troves/camera/camera.py" "$@" ;;
  ti89)
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with pyserial "$REPO/troves/ti-89/link.py" "$@" ;;
  help|-h|--help) cat <<'EOF'
fcpm                      the watcher: what is going on here, and a short menu
fcpm status               which profile, and what differs from what it carries
fcpm install              put the profile on, and the weekly pull. A person runs this
fcpm check                what files cannot say: gear, settings, the pool
fcpm weekly               bring in the latest, once a week (the task runs it)
fcpm refs [pull|status|work R B|done R B]   the mirrors, and worktrees
fcpm pool [status|pass|off|on|install]      the root's server
fcpm runnables [...]      the census, compile, prove (bin/runnables)
fcpm recorder [status|prepare|start|record start|record stop|stop|grant]
fcpm screen [status|on|off|reset|class|wall]   the rolling TV
fcpm camera [console|presets|apply NAME|state]   the USB camera
fcpm ti89 [probe|screen OUT.png] [--port COM1]   a TI-89 on a gray GraphLink
fcpm help                 this
EOF
 ;;
  *) echo "fcpm: no verb '$cmd'. fcpm help" >&2; exit 2 ;;
esac
