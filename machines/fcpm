#!/bin/sh
# fcpm — the crew's one switch on an FCPM machine: every verb a person runs
# here, by name, the same in cmd and PowerShell. Alone, it is the watcher
# (./watch). Verbs: `fcpm help`. Doc: machines/README.md, "The crew's one switch".

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)
CODE="$HOME/code"

profile() { "$HERE/sync" 2>/dev/null | awk '$1 == "profile" { print $2; exit }'; }

ps1() {
  # The one way a .ps1 is run here: as the pool's logon task runs its own,
  # and as the crew's GRANTS names it.
  f=$1; shift
  powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$f" 2>/dev/null || echo "$f")" "$@"
}

cmd=${1:-watch}; [ $# -gt 0 ] && shift
case "$cmd" in
  watch)     exec "$HERE/watch" ;;
  status)    exec "$HERE/sync" ;;
  install)
    "$HERE/sync" install || exit
    "$HERE/watch" copy
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) "$HERE/watch" weekly install ;; esac ;;
  weekly)    exec "$HERE/watch" weekly ;;
  check)
    p=$(profile)
    [ -n "$p" ] || { echo "fcpm: this machine wears no profile"; exit 0; }
    if [ -f "$HERE/$p/check.ps1" ]; then ps1 "$HERE/$p/check.ps1"
    elif [ -f "$HERE/$p/check.sh" ]; then sh "$HERE/$p/check.sh"
    else echo "fcpm: $p carries no check"; fi ;;
  pull)
    # Bring in what merged and put it in place: the mirrors, then the copies
    # run from ~/code (sync install). One verb, nothing left half done
    # (Autumn, 2026-10-10). The pool does the same by itself with `fcpm dev on`.
    # Only this repo: fcpm runs from it, and the other mirrors are reading
    # (Autumn, 2026-10-10). `fcpm refs pull` still pulls them all.
    "$CODE/bin/refs" pull "$(basename "$REPO")" || exit
    exec "$HERE/sync" install ;;
  refs)      exec "$CODE/bin/refs" "$@" ;;
  dev)
    # On: the pool pulls GitHub every 5 minutes and places what merged
    # (Autumn, 2026-10-09). Off: the weekly pull and people, as before.
    f="${LOCALAPPDATA:-$HOME/.local/state}/fcpm/dev"
    case "${1:-status}" in
      on)  mkdir -p "$(dirname "$f")" && : > "$f" && echo "dev: on. The pool pulls GitHub every 5 minutes and places what merged" ;;
      off) rm -f "$f" && echo "dev: off. The weekly pull only" ;;
      status) [ -f "$f" ] && echo "dev: on" || echo "dev: off" ;;
      *) echo "fcpm dev [status|on|off]" >&2; exit 2 ;;
    esac ;;
  pool)
    [ -f "$CODE/bin/pool.ps1" ] || { echo "fcpm: this machine keeps no pool"; exit 0; }
    ps1 "$CODE/bin/pool.ps1" "$@" ;;
  runnables) exec "$REPO/bin/runnables" "$@" ;;
  recorder)  ps1 "$REPO/troves/recorder/obs.ps1" "$@" ;;
  screen)    ps1 "$REPO/troves/kiosk-screen/screen.ps1" "$@" ;;
  audition)
    p=$(profile)
    [ -f "$HERE/$p/audition.ps1" ] || { echo "fcpm: ${p:-this machine} carries no Audition panel"; exit 0; }
    ps1 "$HERE/$p/audition.ps1" "$@" ;;
  drobo|share|audit)
    p=$(profile)
    [ -f "$HERE/$p/$cmd.ps1" ] || { echo "fcpm: ${p:-this machine} carries no $cmd"; exit 0; }
    ps1 "$HERE/$p/$cmd.ps1" "$@" ;;
  pools)
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/troves/pools/pools.py" "$@" ;;
  crew)
    # The production crew (crews/): what its supervisor keeps, asked
    # live. `serve` is what the crew's service runs; in a window, it tries it.
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    case "${1:-status}" in
      status|install|uninstall) ps1 "$REPO/crews/crew.ps1" "${1:-status}" ;;   # the task, and what it keeps; install is an administrator's
      episodes) shift; exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/troves/pools/episodes.py" "${@:-status}" ;;
      *)        exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/crews/crew.py" "$@" ;;
    esac ;;
  post)
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/troves/post/post.py" "$@" ;;
  camera)
    # uv brings its own Python; a window opened before uv was installed may not
    # have it on PATH, so fall back to where winget puts it.
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with comtypes --with pyyaml "$REPO/troves/camera/camera.py" "$@" ;;
  ti89)
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with pyserial "$REPO/troves/ti-89/link.py" "$@" ;;
  help|-h|--help) cat <<'EOF'
fcpm                      the watcher: what is going on here, and a short menu
fcpm status               which profile, and what differs from what it carries
fcpm pull                 bring in what merged on GitHub, and put it in place
fcpm install              put the profile on, and the weekly pull. A person runs this
fcpm check                what files cannot say: gear, settings, the pool
fcpm weekly               bring in the latest, once a week (the task runs it)
fcpm refs [pull|status|work R B|done R B]   the mirrors, and worktrees
fcpm pool [status|pass|off|on|install]      the root's server
fcpm dev [status|on|off]  on: merges on GitHub reach this machine by themselves, within 5 min
fcpm runnables [...]      the census, compile, prove (bin/runnables)
fcpm recorder [status|prepare|start|record start|record stop|stop|grant]
fcpm screen [status|on|off|reset|class|wall]   the rolling TV
fcpm audition [status|install|remove]   Audition as gear: the enhance engine's panel
fcpm drobo [status|connect|header|list OUT]   the Drobo, over iSCSI (CHAP)
fcpm share [status|install]   the drop shares: enhance (E:, TO ENHANCE)
fcpm audit [status|on|off|collect [OUT]]   a record, kept here, of the commands run on this machine
fcpm camera [console|presets|apply NAME|state]   the USB camera
fcpm ti89 [probe|version|screen OUT.png|rom OUT.rom] [--port COM1]   a TI-89 on a GraphLink
fcpm crew [status|install|uninstall|check|log NAME|serve|episodes]   production: its one service (from the computer's start) and what it keeps
fcpm pools [timeline|key|sample|sample clear]   the storage pools, as a page (timeline: opened at the nights; key: the depot's password)
fcpm post [status|run [STEP]|admit CONFIG|retry TAKE N]   after release: the takes on E:\POST and their steps, as a page
fcpm help                 this
EOF
 ;;
  *) echo "fcpm: no verb '$cmd'. fcpm help" >&2; exit 2 ;;
esac
