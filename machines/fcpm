#!/bin/sh
# fcpm — the crew's one switch on an FCPM machine: every verb a person runs
# here, by name, the same in cmd and PowerShell. Alone, it is the watcher
# (./watch). Verbs: `fcpm help`. Doc: machines/README.md, "The crew's one switch".

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)
CODE="$HOME/code"

profile() { "$HERE/sync" 2>/dev/null | awk '$1 == "profile" { print $2; exit }'; }

ps1() {
  # The one way a .ps1 is run here: as the pool's logon task runs its own,
  # and as the crew's GRANTS names it.
  f=$1; shift
  powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$f" 2>/dev/null || echo "$f")" "$@"
}

cmd=${1:-watch}; [ $# -gt 0 ] && shift
case "$cmd" in
  watch)     exec "$HERE/watch" ;;
  status)    exec "$HERE/sync" ;;
  install)
    "$HERE/sync" install || exit
    "$HERE/watch" copy
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) "$HERE/watch" weekly install ;; esac ;;
  weekly)    exec "$HERE/watch" weekly ;;
  check)
    p=$(profile)
    [ -n "$p" ] || { echo "fcpm: this machine wears no profile"; exit 0; }
    if [ -f "$HERE/$p/check.ps1" ]; then ps1 "$HERE/$p/check.ps1"
    elif [ -f "$HERE/$p/check.sh" ]; then sh "$HERE/$p/check.sh"
    else echo "fcpm: $p carries no check"; fi ;;
  pull)
    # Bring in what merged and put it in place: the mirrors, then the copies
    # run from ~/code (sync install). One verb, nothing left half done
    # (Autumn, 2026-10-10). The pool does the same by itself with `fcpm dev on`.
    # Only this repo: fcpm runs from it, and the other mirrors are reading
    # (Autumn, 2026-10-10). The reading mirrors are the weekly task's chore.
    "$CODE/bin/refs" pull "$(basename "$REPO")" || exit
    exec "$HERE/sync" install ;;
  dev)
    # On: the pool pulls GitHub every 5 minutes and places what merged
    # (Autumn, 2026-10-09), and digitization's origin-intake asks every minute.
    # Off: the weekly pull and people, as before; intake weekly (Autumn, 2026-10-13).
    f="${LOCALAPPDATA:-$HOME/.local/state}/fcpm/dev"
    case "${1:-status}" in
      on)  mkdir -p "$(dirname "$f")" && : > "$f" && echo "dev: on. GitHub is asked every few minutes: the pool's pull, the origin's intake" ;;
      off) rm -f "$f" && echo "dev: off. GitHub weekly: the weekly pull, the origin's intake" ;;
      status) [ -f "$f" ] && echo "dev: on" || echo "dev: off" ;;
      *) echo "fcpm dev [status|on|off]" >&2; exit 2 ;;
    esac ;;
  pool)
    [ -f "$CODE/bin/pool.ps1" ] || { echo "fcpm: this machine keeps no pool"; exit 0; }
    ps1 "$CODE/bin/pool.ps1" "$@" ;;
  runnables) exec "$REPO/bin/runnables" "$@" ;;
  recorder)  ps1 "$REPO/troves/recorder/obs.ps1" "$@" ;;
  screen)    ps1 "$REPO/troves/kiosk-screen/screen.ps1" "$@" ;;
  audition)
    p=$(profile)
    [ -f "$HERE/$p/audition.ps1" ] || { echo "fcpm: ${p:-this machine} carries no Audition panel"; exit 0; }
    ps1 "$HERE/$p/audition.ps1" "$@" ;;
  drobo|share|audit)
    p=$(profile)
    [ -f "$HERE/$p/$cmd.ps1" ] || { echo "fcpm: ${p:-this machine} carries no $cmd"; exit 0; }
    ps1 "$HERE/$p/$cmd.ps1" "$@" ;;
  pools)
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/troves/pools/pools.py" "$@" ;;
  crew)
    # The production crew (machines/production): what its supervisor keeps, asked
    # live. `serve` is what the crew's service runs; in a window, it tries it.
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) ;; *)
      # Linux: this machine's own job, by crew.sh (fcpm-crew@<job>), and crew.py by python3.
      case "${1:-status}" in
        status|install|uninstall) exec sh "$HERE/crew.sh" "${1:-status}" "$(profile)" ;;
        *) exec python3 "$REPO/machines/crew.py" "$@" ;;
      esac ;;
    esac
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    case "${1:-status}" in
      status|install|uninstall) ps1 "$REPO/machines/crew.ps1" "${1:-status}" ;;   # the task, and what it keeps; install is an administrator's
      episodes) shift; exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/troves/pools/episodes.py" "${@:-status}" ;;
      *)        exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/machines/crew.py" "$@" ;;
    esac ;;
  post)
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with pyyaml "$REPO/troves/post/post.py" "$@" ;;
  camera)
    # uv brings its own Python; a window opened before uv was installed may not
    # have it on PATH, so fall back to where winget puts it.
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with comtypes --with pyyaml "$REPO/troves/camera/camera.py" "$@" ;;
  ti89)
    uv=$(command -v uv 2>/dev/null || echo "${LOCALAPPDATA:-}/Microsoft/WinGet/Links/uv.exe")
    exec "$uv" run --no-project --python 3.12 --with pyserial "$REPO/troves/ti-89/cable/link.py" "$@" ;;
  help|-h|--help)
    # From machines/fcpm.yml, the one place each verb is defined (Autumn, 2026-10-13).
    case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) plat=windows ;; *) plat=linux ;; esac
    awk -v plat="$plat" '
      function val(s) { sub(/^[^:]*:[ ]*/, "", s); gsub(/^"|"$/, "", s); return s }
      function flush() {
        if (v == "") return
        c = "fcpm " v (a != "" ? " " a : "")
        if (p ~ /^not:/) away = away sprintf("  %s\n      %s\n", c, substr(p, 6))
        else here = here sprintf("  %s\n      %s\n", c, s)
      }
      /^  - verb:/        { flush(); v = val($0); a = s = p = ""; next }
      /^    args:/        { a = val($0); next }
      /^    says:/        { s = val($0); next }
      $0 ~ "^    " plat ":" { p = val($0); next }
      END { flush(); printf "fcpm, on %s:\n%s", plat, here
            if (away != "") printf "\nNot on %s yet, and what stands in:\n%s", plat, away }
    ' "$HERE/fcpm.yml" ;;
  *) echo "fcpm: no verb '$cmd'. fcpm help" >&2; exit 2 ;;
esac
