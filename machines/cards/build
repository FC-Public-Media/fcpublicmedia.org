#!/bin/bash
# build TYPE /dev/sdX sdX: erases a card and makes it a TYPE card (README.md). Run as the desktop's
# user; it asks sudo itself. A window on this screen shows the card and waits for its OK.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TYPE="${1:-}"; DISK="${2:-}"
TYPES="$(cd "$HERE" && ls -d */ | tr -d / | tr '\n' ' ')"
[ -n "$TYPE" ] && [ -f "$HERE/$TYPE/card" ] && [ -n "$DISK" ] || { echo "usage: build TYPE /dev/sdX sdX   types: $TYPES"; exit 1; }
[ "${3:-}" = "$(basename "$DISK")" ] || { echo "Name the disk twice: $DISK $(basename "$DISK")"; exit 1; }
[ "$(id -u)" != 0 ] || { echo "Run as the desktop's user, not root."; exit 1; }
case "$(lsblk -dno TYPE "$DISK" 2>/dev/null)" in disk|loop) ;; *) echo "$DISK is not a whole disk."; exit 1;; esac
persistence=""; default=""; grub2=""; . "$HERE/$TYPE/card"
TOOLBOX="${TOOLBOX:-/srv/toolbox}"
export PATH="$PATH:/sbin:/usr/sbin"

if lsblk -rno MOUNTPOINTS "$DISK" | grep -qE '^(/|/run/live.*|/home.*|/srv/.*|/mnt/persist)$'; then
  echo "$DISK holds part of the running system. Refusing."; exit 1
fi
if lsblk -rno TYPE "$DISK" | grep -qx crypt; then echo "$DISK has an encrypted partition open. Close it first."; exit 1; fi

mib() { case "$1" in *G) echo $(( ${1%G} * 1024 ));; *M) echo "${1%M}";; esac; }
DISK_MB=$(( $(lsblk -bdno SIZE "$DISK") / 1048576 ))
NEED=$(( $(mib "$ventoy") + 64 ))
for p in $parts; do s="${p##*:}"; NEED=$(( NEED + $( [ "$s" = rest ] && echo 1024 || mib "$s" ) )); done
[ "$DISK_MB" -ge "$NEED" ] || { echo "$DISK is $DISK_MB MiB; a $TYPE card needs $NEED."; exit 1; }

# ---------------------------------------------------------------- the OK, on this screen
if [ -z "${DISPLAY:-}" ] && [ -S /tmp/.X11-unix/X0 ] && [ "$(lsblk -dno TYPE "$DISK")" = disk ]; then export DISPLAY=:0; fi
LOCKED="$(lsblk -rno FSTYPE,LABEL "$DISK" | awk '$1=="crypto_LUKS"{print $2 ? $2 : "(no label)"}' | paste -sd ' ')"
TEXT="$(printf 'Erase %s and make it a %s card?\n\n%s\n\n%s%s' "$DISK" "$TYPE" \
  "$(lsblk -dno SIZE,VENDOR,MODEL,SERIAL "$DISK" | tr -s ' ')" \
  "$(lsblk -rno NAME,SIZE,FSTYPE,LABEL "$DISK" | tail -n +2)" \
  "${LOCKED:+$(printf '\n\nEncrypted, gone for good: %s' "$LOCKED")}")"
echo "$TEXT"
if [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null; then
  zenity --question --no-markup --width 440 --title "Erase this card?" --ok-label "Erase it" \
    --cancel-label "Keep it" --text "$TEXT" 2>/dev/null || { echo "Kept."; exit 1; }
elif [ -n "$LOCKED" ]; then
  echo "It holds an encrypted home; erasing that needs the window, on a screen."; exit 1
fi

WORK="$(mktemp -d)"
trap 'sync; sudo umount "$WORK/m" 2>/dev/null || true; rm -rf "$WORK"' EXIT
mkdir "$WORK/m"
release() { if findmnt -rno TARGET -S "$1" >/dev/null; then udisksctl unmount -b "$1" >/dev/null; fi; }

# ---------------------------------------------------------------- Ventoy, room left at the end
VT="$(cd "$TOOLBOX/ventoy" && ls ventoy-*-linux.tar.gz | tail -1)"
(cd "$TOOLBOX/ventoy" && grep " $VT\$" sha256.txt | sha256sum -c --quiet)
tar -xzf "$TOOLBOX/ventoy/$VT" -C "$WORK"; VD="$(ls -d "$WORK"/ventoy-*/)"

for part in $(lsblk -rno PATH "$DISK" | tail -n +2); do release "$part"; sudo wipefs -aq "$part"; done
sudo wipefs -aq "$DISK"
(cd "$VD" && printf 'y\ny\n' | sudo ./Ventoy2Disk.sh -I -g -s -r $(( DISK_MB - $(mib "$ventoy") - 64 )) "$DISK")
sudo partprobe "$DISK"; sudo udevadm settle

A=$(sudo parted -ms "$DISK" unit MiB print | awk -F: '$1==2{sub("MiB","",$3); print int($3)+1}')
for p in $parts; do
  IFS=: read -r name fs size <<<"$p"
  if [ "$size" = rest ]; then B=100%; else B=$(( A + $(mib "$size") )); fi
  sudo parted -s "$DISK" unit MiB mkpart "$label-$name" "$A" "$B"
  A=$B
done
sudo partprobe "$DISK"; sudo udevadm settle
P1="$(lsblk -rno PATH "$DISK" | sed -n 2p)"; PN="${P1%1}"
each() { local n=3 p; for p in $parts; do IFS=: read -r name fs size <<<"$p"; dev="$PN$n"; n=$((n+1)); "$@"; done; }
mkfs_part() {
  case "$fs" in
    ext4) sudo mkfs.ext4 -q -F -L "$label-$name" "$dev" ;;
    vfat) sudo mkfs.fat -F 32 -n "$label-$name" "$dev" >/dev/null 2>&1 ;;
  esac
}
each mkfs_part

# ---------------------------------------------------------------- Ventoy's partition: ISOs, persistence
release "$P1"; sudo mount -t exfat -o uid="$(id -u)",gid="$(id -g)" "$P1" "$WORK/m"
for pat in $isos; do
  for f in "$TOOLBOX"/isos/$pat; do
    n="$(basename "$f")"
    if [ -f "$f.sha256" ]; then h="$(awk '{print $1; exit}' "$f.sha256")"
    else h="$(awk -v n="$n" '$2==n || $2=="*"n {print $1}' "$TOOLBOX/isos/SHA256SUMS")"; fi
    [ -n "$h" ] || { echo "No published checksum for $n."; exit 1; }
    # Named _VTGRUB2, Ventoy boots it in its GRUB2 mode by itself (what Ctrl+R does at its menu): under
    # Secure Boot an ISO's own GRUB may refuse its kernel (Alpine's does: shim_lock), Ventoy's does not.
    c="$n"; for g in $grub2; do case "$n" in $g) c="${n%.iso}_VTGRUB2.iso" ;; esac; done
    echo "$h  $c" >> "$WORK/m/SHA256SUMS"
    cp "$f" "$WORK/m/$c"
  done
done
VJ='{}'
if [ -n "$persistence" ]; then
  set -- $persistence
  (cd "$WORK/m" && sudo "$VD/CreatePersistentImg.sh" -s "$(mib "$1")" -l persistence -c persistence.conf -o persistence.dat >/dev/null)
  VJ="$(jq --arg i "/$(cd "$WORK/m" && ls $2 | head -1)" '.persistence=[{image:$i, backend:"/persistence.dat"}]' <<<"$VJ")"
fi
if [ -n "$default" ]; then                                    # boots by itself after a few seconds
  VJ="$(jq --arg i "/$(cd "$WORK/m" && ls $default | head -1)" \
    '.control=[{VTOY_DEFAULT_IMAGE:$i}, {VTOY_MENU_TIMEOUT:"5"}, {VTOY_SECONDARY_BOOT_MENU:"0"}]' <<<"$VJ")"
fi
if [ "$VJ" != '{}' ]; then mkdir -p "$WORK/m/ventoy"; echo "$VJ" > "$WORK/m/ventoy/ventoy.json"; fi
sync; sudo umount "$WORK/m"
sudo sh -c 'echo 3 > /proc/sys/vm/drop_caches'                # read the ISOs back from the card
release "$P1"; sudo mount -t exfat -o ro "$P1" "$WORK/m"
(cd "$WORK/m" && sha256sum -c --quiet SHA256SUMS)
sudo umount "$WORK/m"

# ---------------------------------------------------------------- what the type puts in its partitions
fill_part() {
  [ "$fs" != luks ] && [ -x "$HERE/$TYPE/fill" ] || return 0
  release "$dev"; sudo mount "$dev" "$WORK/m"
  sudo TOOLBOX="$TOOLBOX" "$HERE/$TYPE/fill" "$name" "$WORK/m"
  sync; sudo umount "$WORK/m"
}
each fill_part

# ---------------------------------------------------------------- the home, under its holder's passphrase
ask() { zenity --entry --hide-text --title "This card's home" --text "$1" 2>/dev/null; }
home_part() {
  [ "$fs" = luks ] || return 0
  local map="$label-$name" one="" two="" tries=0
  release "$dev"
  if [ -n "${DISPLAY:-}" ]; then
    while :; do
      one="$(ask "A passphrase for the home on this card")" || { echo "No passphrase; $dev is left raw. Run build again."; return 0; }
      two="$(ask "The same passphrase again")" || return 0
      [ -n "$one" ] && [ "$one" = "$two" ] && break
      tries=$((tries+1)); [ $tries -lt 3 ] || { echo "They didn't match; $dev is left raw."; return 0; }
    done
    printf %s "$one" | sudo cryptsetup luksFormat -q --type luks2 --label "$map" --key-file=- "$dev"
    printf %s "$one" | sudo cryptsetup open --key-file=- "$dev" "$map"
    one=""; two=""
  else
    sudo cryptsetup luksFormat --type luks2 --label "$map" "$dev"
    sudo cryptsetup open "$dev" "$map"
  fi
  sudo mkfs.ext4 -q -L home "/dev/mapper/$map"
  sudo mount "/dev/mapper/$map" "$WORK/m"; sudo chown 1000:1000 "$WORK/m"; sudo chmod 700 "$WORK/m"
  sudo umount "$WORK/m"; sudo cryptsetup close "$map"
}
each home_part

echo; lsblk -o NAME,SIZE,FSTYPE,LABEL "$DISK"
echo "Built: a $TYPE card."
