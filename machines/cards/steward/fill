#!/bin/sh
# fill PART DIR, from ../build or ../extend: this machine's origin and toolbox as they are, Alpine's kit, the checkout.
set -eu
case "$1" in
  origin) if [ -d /srv/origin/FC-Public-Media ]; then rsync -aH --exclude=lost+found /srv/origin/ "$2"/; fi ;;
  toolbox) rsync -aH --exclude=lost+found "${TOOLBOX:-/srv/toolbox}"/ "$2"/ ;;
  kit|code) CARD="$(cd "$(dirname "$0")" && pwd)/card" "$(dirname "$0")/../lan/fill" "$1" "$2"; exit ;;
esac
chown "${SUDO_UID:-1000}:${SUDO_GID:-1000}" "$2"
