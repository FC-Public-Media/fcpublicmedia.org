#!/bin/sh
# sideload TYPE /dev/sdX [REF] -- roll a card in a reader forward, in place. Never a reformat, never its
# home, never an ISO's bytes (only names on its boot partition, below): its checkout (the `code` partition) moves to REF, by default the
# newest tag cards/TYPE/* in this repository, and its kit is refreshed by that checkout's own `kit`:
# its packages (new ones too) and its settings layer. At its next boot the card settles from it.
# Run as the desktop's user; it asks sudo. ./roll does the same to a card that is running.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
TYPE=${1:?sideload TYPE /dev/sdX [REF]}; DEV=${2:?sideload TYPE /dev/sdX [REF]}
[ -f "$HERE/$TYPE/card" ] || { echo "no card type $TYPE"; exit 2; }
. "$HERE/$TYPE/card"
REPO=$(git -C "$HERE" rev-parse --show-toplevel)
REF=${3:-$(git -C "$REPO" tag -l "cards/$TYPE/*" --sort=-creatordate | head -1)}
[ -n "$REF" ] || { echo "sideload: no tag cards/$TYPE/* here; name a REF"; exit 2; }
SHA=$(git -C "$REPO" rev-parse --verify "$REF^{commit}")
[ -z "$(lsblk -rno MOUNTPOINTS "$DEV" | grep .)" ] || { echo "sideload: $DEV has something mounted; it must be a card at rest."; exit 1; }
part() { lsblk -rno PATH,LABEL "$DEV" | awk -v l="$label-$1" '$2 == l { print $1 }'; }
CODE=$(part code); KIT=$(part kit)
[ -n "$CODE" ] && [ -n "$KIT" ] || { echo "sideload: $DEV is not a $TYPE card (no $label-code and $label-kit)"; exit 1; }
W=$(mktemp -d); trap 'sudo umount "$W/code" "$W/kit" 2>/dev/null || true; rmdir "$W/code" "$W/kit" "$W" 2>/dev/null || true' EXIT
mkdir "$W/code" "$W/kit"
sudo mount "$CODE" "$W/code"; sudo mount "$KIT" "$W/kit"
C="$W/code/fcpublicmedia.org"; g() { sudo git -c safe.directory='*' -C "$C" "$@"; }
[ -z "$(g status --porcelain --untracked-files=no)" ] || { echo "sideload: the card's checkout has changes of its own; not rolling over them."; exit 1; }
before=$(g describe --tags --always 2>/dev/null)
g fetch -q "$REPO" "$SHA" "+refs/tags/cards/*:refs/tags/cards/*"
g checkout -q --detach "$SHA"
sudo chown -R 1000:1000 "$W/code"
sudo bash "$C/machines/cards/$TYPE/kit" "$W/kit"
# The boot partition: names only, never an ISO's bytes. An ISO the type boots in Ventoy's GRUB2 mode
# (its card's `grub2`) is renamed _VTGRUB2, with its checksum line and the default image to match.
grub2=""; . "$C/machines/cards/$TYPE/card"
VTOY=$(lsblk -rno PATH,LABEL "$DEV" | awk '$2 == "Ventoy" { print $1 }')
if [ -n "$grub2" ] && [ -n "$VTOY" ]; then
  mkdir -p "$W/vtoy"; sudo mount -t exfat "$VTOY" "$W/vtoy"
  for g in $grub2; do
    for f in "$W"/vtoy/$g; do
      [ -f "$f" ] || continue
      n=$(basename "$f"); c="${n%.iso}_VTGRUB2.iso"
      sudo mv "$f" "$W/vtoy/$c"
      sudo sed -i "s|  $n\$|  $c|" "$W/vtoy/SHA256SUMS" 2>/dev/null || true
      [ ! -f "$W/vtoy/ventoy/ventoy.json" ] || sudo sed -i "s|/$n\"|/$c\"|" "$W/vtoy/ventoy/ventoy.json"
      echo "sideload: $n boots in GRUB2 mode by itself now ($c)"
    done
  done
  sync; sudo umount "$W/vtoy"; rmdir "$W/vtoy"
fi
sync
echo "sideload: $(lsblk -dno SERIAL "$DEV") rolled from $before to $(g describe --tags --always)"
