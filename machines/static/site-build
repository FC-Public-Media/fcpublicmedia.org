#!/bin/sh
# site-build DEST -- the public site, built from this checkout into DEST, so the LAN has it through a
# cloud outage. publish.py runs it when site/ or this folder moved (sites.yml's `site`, its `from`),
# and puts DEST up only if this succeeds. Jekyll is Debian's (gear.yml); the build is smoke.yml's
# with site-lan.yml's url on top, and the commit as `revision` (wizards' replies carry it as `at`).
cd "$(dirname "$0")/../.." || exit 1
[ -n "$1" ] || { echo "site-build DEST" >&2; exit 2; }
rev="$(mktemp -d)"
printf 'revision: %s\n' "$(git rev-parse --short HEAD 2>/dev/null || echo dev)" > "$rev/revision.yml"
jekyll build -q -s site -d "$1" --config "site/_config.yml,machines/static/site-lan.yml,$rev/revision.yml"
ok=$?
rm -rf "$rev"
exit $ok
