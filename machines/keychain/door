#!/usr/bin/env python3
"""door — the keychain's SSH door: FCPM's one canonical keychain, on the box that wears `keychain`.
Every key the `keys` account takes is forced through here, as its holder (HOLDERS). Never prints a
value except to the one it is for. See PROFILE.md.

    door keys                     write HOLDERS into the account's authorized_keys (run-keys, each minute)
    door serve OFFICE HOLDER      sshd runs this for a holder's key; never by hand

What a holder may ask (`ssh keys@HOST <verb> ...`):

    status                        initialized, locked or open, how much is held
    list                          every key held: group, key, class, for whom, by whom, when. No value
    put GROUP KEY [secret FOR]    the value on stdin, sealed at once; locked or open. `protected` by default
    get GROUP KEY                 the value, to the holder it is for; only while open
    mint ssh FOR [protected]      a new ssh identity for FOR: its private half lodged as a secret for FOR,
                                  the public half printed (and the private one too, if protected)
    init | unlock                 the passphrase on stdin; a keeper's
    lock                          a keeper's

`protected`: whoever made it has it already; the keychain hands it to a keeper, or to a holder whose
job's keys.yml names its group. `secret`: handed to FOR alone, never to its maker, a keeper included.
Values are sealed with age to the keychain's own recipient, so putting needs no unlock; the identity
that opens them is kept under the passphrase, and only in memory while open. Standard library and age.
"""
import datetime
import hashlib
import json
import os
import pathlib
import pty
import re
import secrets
import shutil
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent
STORE = pathlib.Path(os.environ.get("FCPM_KEYCHAIN", "/srv/keychain"))
OPEN = pathlib.Path(os.environ.get("FCPM_KEYCHAIN_OPEN", "/dev/shm/keychain"))
HOLDERS = pathlib.Path(os.environ.get("FCPM_HOLDERS", HERE / "HOLDERS"))
AUTHORIZED = pathlib.Path(os.environ.get("FCPM_AUTHORIZED_KEYS", STORE / ".ssh/authorized_keys"))
SCRATCH = os.environ.get("FCPM_SCRATCH", "/dev/shm")                 # memory: a minted private half never touches a disk
LEDGERS = os.environ.get("FCPM_LEDGERS", "/srv/origin/FC-Public-Media/fcpublicmedia.org")
BEGIN = "# BEGIN keychain door: from machines/keychain/HOLDERS, written by `door keys`; edit HOLDERS, not this"
END = "# END keychain door"
TYPES = {"ssh-ed25519", "sk-ssh-ed25519@openssh.com", "ecdsa-sha2-nistp256", "sk-ecdsa-sha2-nistp256@openssh.com"}
KEEPERS = {"keeper"}
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def holders():
    """(office, holder, key) for every filled slot in HOLDERS."""
    out = []
    for n, line in enumerate(HOLDERS.read_text().splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        f = line.split()
        if len(f) < 3 or not NAME.fullmatch(f[0]) or not NAME.fullmatch(f[1]):
            sys.exit(f"door: HOLDERS line {n} is not `office holder key-type key since`")
        if f[2] == "-":
            continue
        if f[2] not in TYPES or len(f) < 4:
            sys.exit(f"door: HOLDERS line {n}: {f[2]} is not a key type the door takes")
        out.append((f[0], f[1], f"{f[2]} {f[3]}"))
    return out


def keys():
    lines = [f'command="python3 -I {HERE / "door"} serve {o} {h}",restrict {k}' for o, h, k in holders()]
    old = AUTHORIZED.read_text().splitlines() if AUTHORIZED.exists() else []
    kept, inside = [], False
    for line in old:
        if line == BEGIN:
            inside = True
        elif line == END:
            inside = False
        elif not inside:
            kept.append(line)
    new = kept + [BEGIN] + lines + [END]
    if new != old:
        AUTHORIZED.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        tmp = AUTHORIZED.with_name(AUTHORIZED.name + ".new")
        tmp.write_text("\n".join(new) + "\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, AUTHORIZED)
        print(f"door: {len(lines)} holder key(s) as HOLDERS says")


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def note(office, holder, **what):
    STORE.mkdir(parents=True, exist_ok=True)
    with open(STORE / "actions.ndjson", "a") as log:
        log.write(json.dumps({"at": now(), "office": office, "holder": holder, **what}) + "\n")


def age_tty(args, passphrase, prompts):
    """age with a terminal of its own: it reads a passphrase from nowhere else. True when it exits 0."""
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp("age", ["age", *args])
    seen, sent = b"", 0
    while True:
        try:
            chunk = os.read(fd, 1024)
        except OSError:
            break
        if not chunk:
            break
        seen += chunk.lower()
        while sent < prompts and seen.count(b"passphrase") > sent:
            os.write(fd, passphrase.encode() + b"\n")
            sent += 1
    os.close(fd)
    return os.waitpid(pid, 0)[1] == 0


def recipient():
    path = STORE / "recipient"
    return path.read_text().strip() if path.exists() else None


def identity():
    path = OPEN / "identity"
    return path if path.exists() else None


def passphrase():
    text = sys.stdin.readline().rstrip("\r\n")
    if len(text) < 8:
        sys.exit("door: a passphrase of 8 characters at least")
    return text


def init():
    if recipient():
        sys.exit("door: this keychain is made already; `unlock` opens it")
    phrase = passphrase()
    OPEN.mkdir(mode=0o700, parents=True, exist_ok=True)
    plain = OPEN / "identity"
    subprocess.run(["age-keygen", "-o", str(plain)], check=True, capture_output=True)
    if not age_tty(["-p", "-o", str(STORE / "identity.age"), str(plain)], phrase, 2):
        plain.unlink()
        sys.exit("door: age did not seal the identity")
    out = subprocess.run(["age-keygen", "-y", str(plain)], check=True, capture_output=True, text=True).stdout.strip()
    (STORE / "recipient").write_text(out + "\n")
    (STORE / "salt").write_text(secrets.token_hex(32) + "\n")
    os.chmod(STORE / "salt", 0o600)
    print(f"door: made, and open until the box restarts or `lock`; recipient {out}")


def unlock():
    if not recipient():
        sys.exit("door: no keychain here yet; `init` makes it")
    phrase = passphrase()
    OPEN.mkdir(mode=0o700, parents=True, exist_ok=True)
    temp = OPEN / "identity.new"
    if not age_tty(["-d", "-o", str(temp), str(STORE / "identity.age")], phrase, 1) or not temp.exists():
        temp.unlink(missing_ok=True)
        sys.exit("door: that passphrase does not open it")
    os.chmod(temp, 0o600)
    os.replace(temp, OPEN / "identity")
    print("door: open until the box restarts or `lock`")


def lock():
    shutil.rmtree(OPEN, ignore_errors=True)
    print("door: locked")


def slot(group, key):
    if not NAME.fullmatch(group) or not NAME.fullmatch(key):
        sys.exit("door: a group and a key are names: letters, digits, . _ -")
    return STORE / "held" / group / key


def print_of(value):
    return hashlib.sha256(((STORE / "salt").read_text().strip() + value).encode()).hexdigest()[:16]


def latest(where):
    meta = where / "meta.json"
    if not meta.exists():
        return None
    return json.loads(meta.read_text())


def seal(group, key, value, cls, for_, office, holder):
    """Keep value as group/key's newest version. The same value again is no new version."""
    to = recipient()
    if not to:
        sys.exit("door: no keychain here yet; a keeper's `init` makes it")
    where = slot(group, key)
    meta = latest(where)
    fingerprint = print_of(value)
    if meta and meta["print"] == fingerprint and meta["class"] == cls and meta.get("for") == for_:
        return "same"
    if meta and meta["class"] == "secret" and holder != meta["for"] and office not in KEEPERS:
        sys.exit(f"door: {group} {key} is a secret for {meta['for']}; only it or a keeper replaces it")
    where.mkdir(parents=True, exist_ok=True)
    version = now().replace(":", "")
    subprocess.run(["age", "-r", to, "-o", str(where / f"{version}.age")], input=value.encode(), check=True)
    meta = {"class": cls, "for": for_, "by": holder, "at": now(), "version": version, "print": fingerprint}
    (where / "meta.json").write_text(json.dumps(meta) + "\n")
    return "new"


def named_in_ledger(holder, group):
    """True when machines/<holder>/keys.yml on the origin's main names group."""
    try:
        text = subprocess.run(["git", "-c", f"safe.directory={LEDGERS}", "-C", LEDGERS, "show", f"main:machines/{holder}/keys.yml"],
                              capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False
    inside = False
    for line in text.splitlines():
        if re.match(r"\S", line):
            inside = line.startswith("groups:")
        elif inside and re.fullmatch(rf"  {re.escape(group)}:\s*(#.*)?", line):
            return True
    return False


def get(group, key, office, holder):
    where = slot(group, key)
    meta = latest(where)
    if not meta:
        sys.exit(f"door: no {group} {key} here")
    if meta["class"] == "secret":
        allowed = holder == meta["for"]
    else:
        allowed = office in KEEPERS or holder == meta["by"] or named_in_ledger(holder, group)
    if not allowed:
        note(office, holder, verb="get", group=group, key=key, refused=True)
        sys.exit(f"door: {group} {key} is not {holder}'s")
    ident = identity()
    if not ident:
        sys.exit("door: locked; a keeper's `unlock` opens it")
    value = subprocess.run(["age", "-d", "-i", str(ident), str(where / f"{meta['version']}.age")],
                           capture_output=True, check=True).stdout
    note(office, holder, verb="get", group=group, key=key, version=meta["version"])
    sys.stdout.buffer.write(value)


def mint(for_, protected, office, holder):
    if not NAME.fullmatch(for_):
        sys.exit("door: mint ssh FOR, FOR a holder's name")
    group = f"identity-{for_}"
    if latest(slot(group, "ssh")):
        sys.exit(f"door: {for_} has an ssh identity here already")
    with tempfile.TemporaryDirectory(dir=SCRATCH) as tmp:
        path = pathlib.Path(tmp) / "id"
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"{for_} (FCPM)", "-f", str(path)],
                       check=True)
        private, public = path.read_text(), (pathlib.Path(tmp) / "id.pub").read_text()
    seal(group, "ssh", private, "protected" if protected else "secret", None if protected else for_, office, holder)
    seal(group, "ssh.pub", public, "protected", None, office, holder)
    (STORE / "public").mkdir(exist_ok=True)
    (STORE / "public" / f"{for_}.pub").write_text(public)
    note(office, holder, verb="mint", group=group, protected=protected)
    sys.stdout.write(public + (private if protected else ""))


def listing():
    for meta_path in sorted((STORE / "held").glob("*/*/meta.json")):
        meta = json.loads(meta_path.read_text())
        group, key = meta_path.parent.parent.name, meta_path.parent.name
        versions = len(list(meta_path.parent.glob("*.age")))
        print(f"{group:24} {key:28} {meta['class']:9} {meta.get('for') or '-':14} by {meta['by']:14} {meta['at']}  v{versions}")


def status():
    held = len(list((STORE / "held").glob("*/*/meta.json")))
    state = "not made" if not recipient() else ("open" if identity() else "locked")
    print(f"keychain: {state}, {held} key(s) held")


def serve(office, holder):
    words = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
    verb, args = (words[0], words[1:]) if words else ("status", [])
    keeper = office in KEEPERS
    if verb == "status" and not args:
        return status()
    if verb == "list" and not args:
        return listing()
    if verb == "put" and len(args) in (2, 4) and (len(args) == 2 or args[2] == "secret"):
        for_ = args[3] if len(args) == 4 else None
        if for_ and not NAME.fullmatch(for_):
            sys.exit("door: put GROUP KEY secret FOR, FOR a holder's name")
        value = sys.stdin.read()
        if not value:
            sys.exit("door: the value comes on stdin")
        said = seal(args[0], args[1], value, "secret" if for_ else "protected", for_, office, holder)
        note(office, holder, verb="put", group=args[0], key=args[1], kept=said, secret_for=for_)
        return print(f"door: {args[0]} {args[1]} {'held already' if said == 'same' else 'sealed'}")
    if verb == "get" and len(args) == 2:
        return get(args[0], args[1], office, holder)
    if verb == "mint" and len(args) in (2, 3) and args[0] == "ssh" and args[2:] in ([], ["protected"]):
        if not keeper:
            sys.exit("door: minting is a keeper's")
        return mint(args[1], bool(args[2:]), office, holder)
    if verb in ("init", "unlock", "lock") and not args:
        if not keeper:
            sys.exit(f"door: {verb} is a keeper's")
        note(office, holder, verb=verb)
        return {"init": init, "unlock": unlock, "lock": lock}[verb]()
    sys.exit(__doc__.split("What a holder may ask")[1].split("`protected`")[0].rstrip())


def main(argv):
    os.umask(0o077)
    if argv == ["keys"]:
        return keys()
    if len(argv) == 3 and argv[0] == "serve":
        return serve(argv[1], argv[2])
    sys.exit(__doc__.strip())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
