#!/bin/sh
# run-keys [NAME] -- every minute on the keychain's box, from the account's crontab (outfit): the door's
# keys as HOLDERS (or HOLDERS.NAME) says on the origin's own main (the installed copy until main has one).
LIB=/usr/local/lib/fcpm/keychain
CHAIN=${1:-keychain}
FILE=HOLDERS; [ "$CHAIN" = keychain ] || FILE=HOLDERS.$CHAIN
H=$HOME/$FILE
git -c safe.directory='*' -C /srv/origin/FC-Public-Media/fcpublicmedia.org show "main:machines/keychain/$FILE" > "$H.new" 2>/dev/null &&
  [ -s "$H.new" ] && mv "$H.new" "$H" || { rm -f "$H.new"; cp "$LIB/$FILE" "$H"; }
FCPM_KEYCHAIN_NAME=$CHAIN FCPM_HOLDERS=$H python3 -I $LIB/door keys
