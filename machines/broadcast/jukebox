#!/usr/bin/env python3
"""jukebox — a folder of music played over and over into standby's sound, so the backup stream isn't silent.

    python3 -I machines/broadcast/jukebox           run (the broadcast crew's `jukebox` line keeps it up)
    python3 -I machines/broadcast/jukebox --check   say the folder, what it holds, and whether the bus is there

The folder is /srv/landing/jukebox (FCPM_JUKEBOX to point elsewhere). Its files play by name (the path
in the folder, so a subfolder's files play together, where its name falls), A to Z, and again from the
top. The folder is read afresh after every track, and the next is the first whose name comes after the
one just played: a file dropped in, taken out or renamed counts from the next track, and renaming is
how the order is changed. Started again, it plays on from the track it was playing. Only music FCPM has the rights to goes in: what is in the folder is on
YouTube. Each file is played by mpv into standby's bus (a PulseAudio null sink, `fcpm-standby`, that
standby makes and sends from); while the bus isn't there, nothing plays, and mpv never falls back to
the room's speakers. What is playing, and the whole order it is in, is written to
~/.local/state/fcpm/broadcast/jukebox.json; standby serves it as ch97…/floor/now.json, and
ch97.fcpublicmedia.local/jukebox/ shows it as the list. mpv and the system python. See PROFILE.md, "To YouTube".
"""
import json
import os
import pathlib
import subprocess
import sys
import time

FOLDER = pathlib.Path(os.environ.get("FCPM_JUKEBOX", "/srv/landing/jukebox"))
STATE_DIR = pathlib.Path.home() / ".local/state/fcpm/broadcast"
BUS = "fcpm-standby"                            # standby's null sink; standby makes it
SOUND = {".flac", ".wav", ".mp3", ".m4a", ".aac", ".ogg", ".opus", ".aif", ".aiff"}
os.environ.setdefault("PULSE_SERVER", f"unix:/run/user/{os.getuid()}/pulse/native")


def name(p):
    """Where a file falls in the order: its path in the folder, regardless of case."""
    return str(p.relative_to(FOLDER)).lower()


def tracks():
    """The folder's sound files, by name; hidden files and anything else are left alone."""
    if not FOLDER.is_dir():
        return []
    return sorted((p for p in FOLDER.rglob("*") if p.is_file() and p.suffix.lower() in SOUND
                   and not any(part.startswith(".") for part in p.relative_to(FOLDER).parts)), key=name)


def bus():
    """Whether standby's bus is there to play into."""
    r = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True)
    return any(line.split("\t")[1:2] == [BUS] for line in r.stdout.splitlines())


def note(state, why, track=None, order=()):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    now = {"state": state, "why": why, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    if track:
        now.update(file=str(track.relative_to(FOLDER)), title=track.stem,
                   order=[str(p.relative_to(FOLDER)) for p in order])
    (STATE_DIR / "jukebox.json").write_text(json.dumps(now, indent=1) + "\n")
    print(f"jukebox: {state}: {why}", flush=True)


def play(track):
    """One file through mpv into the bus; whether it played to its end."""
    r = subprocess.run(["mpv", "--no-config", "--no-video", "--no-terminal", "--really-quiet",
                        f"--audio-device=pulse/{BUS}", "--", str(track)], stdin=subprocess.DEVNULL)
    return r.returncode == 0


def main(args):
    if args == ["--check"]:
        found = tracks()
        print(json.dumps({"folder": str(FOLDER), "there": FOLDER.is_dir(), "tracks": len(found),
                          "first": [str(p.relative_to(FOLDER)) for p in found[:10]], "bus": bus()}, indent=1))
        return
    if args:
        sys.exit(__doc__)
    try:                                        # started again: on from the track it was playing
        said = json.loads((STATE_DIR / "jukebox.json").read_text())
        last = said["file"].lower() if said.get("state") == "playing" else None
    except (OSError, ValueError, KeyError):
        last = None
    resume, failed = last is not None, 0
    while True:
        found = tracks()
        if not found:
            note("waiting", f"nothing to play in {FOLDER}")
            time.sleep(30)
            continue
        if not bus():
            note("waiting", f"standby's bus ({BUS}) isn't there")
            time.sleep(10)
            continue
        track = next((p for p in found if last is not None and (name(p) >= last if resume else name(p) > last)),
                     found[0])
        note("playing", track.name, track, found)
        last, resume = name(track), False
        failed = 0 if play(track) else failed + 1
        if failed >= len(found):
            failed = 0
            time.sleep(30)                      # a round with nothing played: don't spin on bad files


if __name__ == "__main__":
    main(sys.argv[1:])
