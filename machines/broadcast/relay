#!/usr/bin/env python3
"""relay — channel 97 to YouTube, all day: Cablecast's own web stream, copied, never re-encoded.

    python3 -I machines/broadcast/relay            run (the broadcast crew's `youtube` line keeps it up)
    python3 -I machines/broadcast/relay --check    say what it would do now, push nothing

The source is the channel's live stream, taken on the LAN from the Live server that encodes it
(http://<its hostAddress>/live/stream-1/, as Cablecast names it), or else from Cablecast's cloud copy
(livestreams/1's streamUrl), which mirrors it. The largest picture and the audio go to YouTube by
RTMPS, as they are: what YouTube gets is what the website gets. The stream key is kept in ~/.config/fcpm/youtube.key (600); nothing here prints it.
`--backup` sends to YouTube's backup ingest instead, so a second box can stand beside the first.

Cablecast can say BROADCASTING while its stream has stopped moving (2026-10-19, 23:19 here: two
days frozen). So nothing is pushed until the source's playlist is seen to advance, and ffmpeg is
stopped when its output stops moving. What it saw is kept in ~/.local/state/fcpm/broadcast/relay.json
for any screen: the source flowing or frozen and since when, and whether YouTube is being fed.
ffmpeg and the system python. See PROFILE.md, "To YouTube".
"""
import datetime
import json
import pathlib
import re
import subprocess
import sys
import threading
import time
import urllib.request

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import cablecast  # noqa: E402  the same hand on the box

KEY = pathlib.Path.home() / ".config/fcpm/youtube.key"
STATE = pathlib.Path.home() / ".local/state/fcpm/broadcast/relay.json"
INGEST = {"primary": "rtmps://a.rtmp.youtube.com/live2/{key}",
          "backup": "rtmps://b.rtmp.youtube.com/live2/{key}?backup=1"}
WATCH = 20        # seconds between two reads of the playlist, to see it move
STALL = 60        # seconds of no output before ffmpeg is stopped
WAIT = 60         # seconds between tries while there is no key or the source is frozen


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def note(**facts):
    """Keep what the relay sees: `since` is when its state last changed; each change is logged once."""
    STATE.parent.mkdir(parents=True, exist_ok=True)
    old = json.loads(STATE.read_text()) if STATE.exists() else {}
    since = old.get("since") if old.get("state") == facts["state"] else now()
    if (old.get("state"), old.get("why")) != (facts["state"], facts.get("why")):
        print(f"relay: {facts['state']}: {facts.get('why', '')}", flush=True)
    STATE.write_text(json.dumps(dict(facts, since=since, at=now()), indent=1) + "\n")


def fetch(url):
    with urllib.request.urlopen(url, timeout=20) as reply:
        return reply.read().decode("utf-8", "replace")


def source():
    """(where, address) of the channel's stream: the Live server's own copy on the LAN, else the cloud's."""
    stream = cablecast.call("GET", "/livestreams/1")["liveStream"]
    for server in cablecast.call("GET", "/servers").get("servers", []):
        if server.get("serverModel") == "CABLECASTLIVE" and server.get("hostAddress"):
            local = f"http://{server['hostAddress']}/live/stream-{stream['id']}/live.m3u8"
            try:
                fetch(local)
                return "lan", local
            except Exception:
                pass
    return "cloud", stream["streamUrl"]


def largest(master_url):
    """The playlist of the largest picture in the master playlist."""
    master = fetch(master_url)
    best = max(re.findall(r"RESOLUTION=(\d+)x(\d+)[^\n]*\n([^\n#]+)", master), key=lambda r: int(r[0]) * int(r[1]))
    return urllib.request.urljoin(master_url, best[2].strip())


def moving(master_url):
    """(True, last segment's time) if the largest picture's playlist advances within WATCH seconds."""
    playlist = largest(master_url)
    def where():
        text = fetch(playlist)
        seq = int(re.search(r"#EXT-X-MEDIA-SEQUENCE:(\d+)", text).group(1)) + text.count("#EXTINF")
        stamps = re.findall(r"#EXT-X-PROGRAM-DATE-TIME:(\S+)", text)
        return seq, stamps[-1] if stamps else None
    first, _ = where()
    time.sleep(WATCH)
    second, stamp = where()
    return second > first, stamp


def video_track(master_url):
    """ffmpeg's index of the widest video track: the one to send."""
    probe = subprocess.run(["ffprobe", "-v", "error", "-rw_timeout", "20000000", "-show_entries",
                            "stream=index,codec_type,width", "-of", "json", master_url],
                           capture_output=True, text=True, timeout=120)
    streams = json.loads(probe.stdout or "{}").get("streams", [])
    videos = [s for s in streams if s.get("codec_type") == "video"]
    audio = [s for s in streams if s.get("codec_type") == "audio"]
    if not videos or not audio:
        raise RuntimeError(f"no video and audio in the source ({len(videos)} video, {len(audio)} audio)")
    return max(videos, key=lambda s: s.get("width") or 0)["index"], audio[0]["index"]


def push(master_url, target, key, where):
    v, a = video_track(master_url)
    run = subprocess.Popen(
        ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning", "-rw_timeout", "20000000",
         "-i", master_url, "-map", f"0:{v}", "-map", f"0:{a}", "-c", "copy",
         "-f", "flv", "-flvflags", "no_duration_filesize", INGEST[target].format(key=key),
         "-progress", "pipe:1", "-nostats"],
        stdout=subprocess.PIPE, text=True)
    note(state="pushing", why=f"from the {where} copy to the {target} ingest, video track {v}, audio track {a}", target=target)
    seen = {"at": time.time(), "out": None}

    def progress():         # ffmpeg says how far its output has got; a new figure is a sign of life
        for line in run.stdout:
            if line.startswith("out_time_us=") and line != seen["out"]:
                seen.update(at=time.time(), out=line)

    threading.Thread(target=progress, daemon=True).start()
    while run.poll() is None:
        if time.time() - seen["at"] > STALL:
            note(state="stalled", why=f"no output for {STALL} s; ffmpeg stopped", target=target)
            run.terminate()
            try:
                run.wait(10)
            except subprocess.TimeoutExpired:
                run.kill()
            return
        time.sleep(2)
    note(state="stopped", why=f"ffmpeg ended ({run.returncode})", target=target)


def main(check, target):
    while True:
        key = KEY.read_text().strip() if KEY.exists() else ""
        try:
            where, url = source()
            flowing, stamp = moving(url)
        except Exception as e:  # the box or Reflect not answering is a state, not a crash
            note(state="unreachable", why=f"{type(e).__name__}: {e}"[:200])
            flowing, stamp, url, where = False, None, None, None
        if url and not flowing:
            note(state="frozen", why=f"the {where} source's playlist has not moved; its last segment is {stamp}", last=stamp)
        elif url and not key:
            note(state="waiting", why=f"the source flows (last segment {stamp}); no key in {KEY}")
        if check:
            print(json.dumps({"from": where, "source": url, "flowing": flowing, "last_segment": stamp,
                              "key": bool(key), "target": INGEST[target].format(key="<key>")}, indent=1))
            return
        if url and flowing and key:
            push(url, target, key, where)
            continue
        time.sleep(WAIT)


if __name__ == "__main__":
    args = sys.argv[1:]
    if set(args) - {"--check", "--backup"}:
        sys.exit(__doc__)
    main("--check" in args, "backup" if "--backup" in args else "primary")
