#!/usr/bin/env python3
"""relay — channel 97 to YouTube, all day: what arrives at the ingest, copied, never re-encoded.

    python3 -I machines/broadcast/relay            run (the broadcast crew's `youtube` line keeps it up)
    python3 -I machines/broadcast/relay --check    say what it would do now, push nothing

The source is the ingest (./ingest), fed by ./fetch from the Cablecast box on the LAN, read on
127.0.0.1, so the only leg on the internet is ours to YouTube. It goes to YouTube's primary ingest
by RTMPS, as it arrives. The stream key is kept in ~/.config/fcpm/youtube.key (600); nothing here
prints it, and Cablecast never holds it. `--backup` sends to YouTube's backup ingest instead.

Nothing is pushed until the ingest's counters show the channel arriving (a publisher on and its
bytes growing), and ffmpeg is stopped when its output stops moving. When the channel goes, the ingest
ends the stream, ffmpeg ends, and this waits for it to come back; meanwhile YouTube has the floor on
its backup ingest. The same when Cablecast's VIOLite Player, our programming, stops for a gap in the
schedule (the channel would show the CG): the push to YouTube ends at the moment the gap reaches
what we carry (fetch says how far behind the room that is), so YouTube falls over to the floor, and
it starts again when the player's next show does. What it saw is kept in ~/.local/state/fcpm/broadcast/relay.json for any screen.
ffmpeg and the system python. See PROFILE.md, "To YouTube".
"""
import datetime
import json
import pathlib
import re
import subprocess
import sys
import threading
import time
import urllib.request

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import cablecast  # noqa: E402  the player's state, from the box

KEY = pathlib.Path.home() / ".config/fcpm/youtube.key"
STATE = pathlib.Path.home() / ".local/state/fcpm/broadcast/relay.json"
INGEST = {"primary": "rtmps://a.rtmp.youtube.com/live2/{key}",
          "backup": "rtmps://b.rtmp.youtube.com/live2/{key}?backup=1"}
SOURCE = "rtmp://127.0.0.1:1935/ch97/air"     # the ingest, where the channel arrives
STAT = "http://127.0.0.1:1936/stat"
FETCH = pathlib.Path.home() / ".local/state/fcpm/broadcast/fetch.json"   # how far behind the room fetch reads
PLAYER = 4        # Cablecast's VIOLite Player: our programming; when it stops, the channel shows the CG
GAP = 6           # seconds the player must stay stopped to count as a gap, not a seam between two shows
WATCH = 5         # seconds between two reads of the ingest's counters, to see the channel arrive
STALL = 60        # seconds of no output before ffmpeg is stopped
WAIT = 10         # seconds between tries while nothing arrives or there is no key


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def note(**facts):
    """Keep what the relay sees: `since` is when its state last changed; each change is logged once."""
    STATE.parent.mkdir(parents=True, exist_ok=True)
    old = json.loads(STATE.read_text()) if STATE.exists() else {}
    since = old.get("since") if old.get("state") == facts["state"] else now()
    if (old.get("state"), old.get("why")) != (facts["state"], facts.get("why")):
        print(f"relay: {facts['state']}: {facts.get('why', '')}", flush=True)
    STATE.write_text(json.dumps(dict(facts, since=since, at=now()), indent=1) + "\n")


def arriving():
    """(True, bytes in) if something is publishing to the ingest and its bytes grow within WATCH seconds."""
    def count():
        with urllib.request.urlopen(STAT, timeout=10) as reply:
            stat = reply.read().decode("utf-8", "replace")
        for stream in re.findall(r"<stream>(.*?)</stream>", stat, re.S):
            if "<name>air</name>" in stream and "<publishing/>" in stream:
                return int(re.search(r"<bytes_in>(\d+)</bytes_in>", stream).group(1))
        return None
    first = count()
    if first is None:
        return False, None
    time.sleep(WATCH)
    second = count()
    return second is not None and second > first, second


class Player:
    """When the VIOLite Player played, by this box's clock: Cablecast asked every 2 s."""
    def __init__(self):
        self.changes = [(0.0, True)]
        threading.Thread(target=self.watch, daemon=True).start()

    def watch(self):
        while True:
            try:
                status = cablecast.call("GET", f"/automationstatus?location={cablecast.LOCATION}")["deviceStatus"]
                playing = next(d for d in status if d.get("device") == PLAYER).get("action") == "play"
                if playing != self.changes[-1][1]:
                    self.changes.append((time.time(), playing))
                    print(f"relay: the player {'plays' if playing else 'stopped'}", flush=True)
                    self.changes = self.changes[-50:]
            except Exception as e:  # not knowing is no gap: the channel goes on as it is
                print(f"relay: the player's state: {type(e).__name__}: {e}"[:200], flush=True)
            time.sleep(2)

    def gap(self, at):
        """True if, at the moment `at`, the player was stopped and stayed so for GAP seconds or more."""
        before = [c for c in self.changes if c[0] <= at]
        if not before or before[-1][1]:
            return False
        stopped = before[-1][0]
        after = [c for c in self.changes if c[0] > stopped]
        return (after[0][0] if after else time.time()) - stopped >= GAP


def behind():
    """Seconds between the room and what the ingest carries, as fetch measured it."""
    try:
        return float(json.loads(FETCH.read_text())["behind"])
    except Exception:
        return 35.0


def push(target, key, player):
    run = subprocess.Popen(
        ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning", "-rtmp_live", "live",
         "-rtmp_buffer", "3000", "-i", SOURCE, "-map", "0:v:0", "-map", "0:a:0", "-c", "copy",
         "-f", "flv", "-flvflags", "no_duration_filesize", INGEST[target].format(key=key),
         "-progress", "pipe:1", "-nostats"],
        stdout=subprocess.PIPE, text=True)
    note(state="pushing", why=f"the channel to YouTube's {target} ingest", target=target)
    seen = {"at": time.time(), "out": None}

    def progress():         # ffmpeg says how far its output has got; a new figure is a sign of life
        for line in run.stdout:
            if line.startswith("out_time_us=") and line != seen["out"]:
                seen.update(at=time.time(), out=line)

    threading.Thread(target=progress, daemon=True).start()
    while run.poll() is None:
        if player.gap(time.time() - behind()):
            note(state="gap", why="the player stopped: YouTube shows its backup ingest, the floor", target=target)
            run.terminate()
            try:
                run.wait(10)
            except subprocess.TimeoutExpired:
                run.kill()
            return
        if time.time() - seen["at"] > STALL:
            note(state="stalled", why=f"no output for {STALL} s; ffmpeg stopped", target=target)
            run.terminate()
            try:
                run.wait(10)
            except subprocess.TimeoutExpired:
                run.kill()
            return
        time.sleep(1)
    note(state="stopped", why=f"ffmpeg ended ({run.returncode})", target=target)


def main(check, target):
    player = Player()
    while True:
        if player.gap(time.time() - behind()):
            time.sleep(1)
            continue
        key = KEY.read_text().strip() if KEY.exists() else ""
        try:
            flowing, got = arriving()
        except Exception as e:  # the ingest not answering is a state, not a crash
            note(state="unreachable", why=f"the ingest: {type(e).__name__}: {e}"[:200])
            flowing, got = False, None
        else:
            if not flowing:
                note(state="waiting", why="nothing arriving at the ingest" if got is None
                     else "a publisher is connected but nothing moves")
            elif not key:
                note(state="waiting", why=f"the channel arrives; no key in {KEY}")
        if check:
            print(json.dumps({"source": SOURCE, "arriving": flowing, "bytes_in": got,
                              "key": bool(key), "target": INGEST[target].format(key="<key>")}, indent=1))
            return
        if flowing and key:
            push(target, key, player)
            continue
        time.sleep(WAIT)


if __name__ == "__main__":
    args = sys.argv[1:]
    if set(args) - {"--check", "--backup"}:
        sys.exit(__doc__)
    main("--check" in args, "backup" if "--backup" in args else "primary")
