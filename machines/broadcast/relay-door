#!/usr/bin/env python3
"""relay-door — the relay's word and its switches, on the LAN, for a Helm on another machine.

    python3 -I machines/broadcast/relay-door        run (the crew's `relay-door` line, where `youtube` runs)

GET /relay is relay.json (./relay) with `off`, for anyone: the relay's state is open metadata. POST /relay with
{"do": "off" | "on" | "again"} writes the relay's switch files (relay.off, relay.again), the same as Helm's
YouTube card does where the relay runs on its own machine; only a helm (machines/helms.yml, each `at:`, resolved
when asked) or this machine may. See PROFILE.md, "To YouTube".
"""
import json
import pathlib
import socket
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import yaml

ROOT = pathlib.Path(__file__).resolve().parents[2]
STATE = pathlib.Path.home() / ".local/state/fcpm/broadcast"
PORT = 8483


def helm_addresses():
    """Every address a helm in helms.yml answers at, and loopback."""
    out = {"127.0.0.1", "::1"}
    helms = (yaml.safe_load((ROOT / "machines/helms.yml").read_text(encoding="utf-8")) or {}).get("helms") or {}
    for h in helms.values():
        host = urllib.parse.urlsplit(str(h.get("at") or "")).hostname
        try:
            out |= {a[4][0] for a in socket.getaddrinfo(host, None)} if host else set()
        except OSError:
            pass
    return out


def now():
    try:
        said = json.loads((STATE / "relay.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        said = {"state": "unknown", "why": "the relay has said nothing yet"}
    return dict(said, off=(STATE / "relay.off").exists(), host=socket.gethostname())


def switch(do):
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z") + "\n"
    STATE.mkdir(parents=True, exist_ok=True)
    if do == "off":
        (STATE / "relay.off").write_text(stamp)
    elif do == "on":
        (STATE / "relay.off").unlink(missing_ok=True)
    elif do == "again" and not (STATE / "relay.off").exists():
        (STATE / "relay.again").write_text(stamp)


class Door(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def reply(self, code, body):
        data = (json.dumps(body) + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.split("?")[0] != "/relay":
            return self.reply(404, {"error": "GET /relay"})
        self.reply(200, now())

    def do_POST(self):
        if self.path.split("?")[0] != "/relay":
            return self.reply(404, {"error": "POST /relay"})
        if self.client_address[0].removeprefix("::ffff:") not in helm_addresses():
            return self.reply(403, {"error": "only a helm switches the relay (machines/helms.yml)"})
        try:
            n = min(int(self.headers.get("Content-Length") or 0), 1024)
            do = (json.loads(self.rfile.read(n) or b"{}") or {}).get("do")
        except (ValueError, AttributeError):
            do = None
        if do not in ("off", "on", "again"):
            return self.reply(400, {"error": 'say {"do": "off" | "on" | "again"}'})
        switch(do)
        print(f"relay-door: {do}, from {self.client_address[0]}", flush=True)
        self.reply(200, now())


class Server(ThreadingHTTPServer):
    address_family = socket.AF_INET6
    daemon_threads = True

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


if __name__ == "__main__":
    print(f"relay-door: on :{PORT}", flush=True)
    Server(("::", PORT), Door).serve_forever()
