"""standby — the floor: our own steady picture, always on, so channel 97's YouTube stream never ends.

    python3 -I machines/broadcast/standby               run (the broadcast crew's `backup` line keeps it up)
    python3 -I machines/broadcast/standby --check       draw the slate and say what it would send, send nothing
    python3 -I machines/broadcast/standby --try FILE    ten seconds of it into FILE, to look at

The picture is the brand's lockup (site/_data/brand.json, drawn by rsvg-convert) under its mark, the one
every studio screen dims to (brand/idle/dim.js) laid on its side: three squares in a row, a split clock
in the room's time and the lit one walking, drawn a frame a second, at 1080p30 and 48 kHz stereo like the channel. The sound is standby's bus, a PulseAudio
null sink (`fcpm-standby`) made here, which the floor's jukebox (./jukebox) plays into: the floor's own
music, one place to put sound in. Silence while there is no PulseAudio to make it in; once it can be
made, this exits so the crew starts the floor with the bus. It is encoded once, by the GPU when it can
be (about a fifth of a core, with the drawing), into the floor: HLS in memory (FCPM_FLOOR, /dev/shm/fcpm-floor), served
on the LAN as ch97.fcpublicmedia.local/floor/index.m3u8, so a machine on top can lay it underneath.

From the floor a copy, never a second encode, goes to YouTube's backup ingest with the channel's key:
when the channel's own stream pauses, YouTube shows this, and goes back when the channel returns. A
machine that puts on more (the standby page, the jukebox) takes the air by saying so: POST /air
{"holder": "..."} to ch97.fcpublicmedia.local, again every few seconds. While a claim is fresh (HOLD
seconds) the copy to YouTube stops; when the claims lapse, it starts again by itself, so a machine
that stops, crashes or is switched off never leaves YouTube with nothing. The floor itself never
stops. GET /air says who has it; /floor/now.json, what the floor is playing.

The key is ~/.config/fcpm/youtube.key, as the relay's; nothing here prints it. If ffmpeg sends nothing
for a minute (YouTube dropped the connection and ffmpeg hung on it, as on 2026-10-22), the copy is
ended and started again; if the floor stops moving, this exits and the crew starts it again. ffmpeg
and the system python. See PROFILE.md, "To YouTube".
"""
import html
import json
import os
import pathlib
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = pathlib.Path(__file__).resolve().parent
BRAND = json.loads((HERE.parent.parent / "site/_data/brand.json").read_text())
KEY = pathlib.Path.home() / ".config/fcpm/youtube.key"
STATE_DIR = pathlib.Path.home() / ".local/state/fcpm/broadcast"
SLATE = STATE_DIR / "standby-slate.png"
INGEST = "rtmps://b.rtmp.youtube.com/live2"     # YouTube's backup server; the app carries ?backup=1
W, H, FPS = 1920, 1080, 30
SIDE, GAP = 200, 70                             # the mark's squares and the room between, as dim.css's 12 to 4.2
ROW, MARK_Y = (800, 280), 0.40                  # the mark's frame (the row with its lean), its centre down the slate
ROOM_TZ = "America/Denver"
GPU = "/dev/dri/renderD128"
STALL = 60                                      # seconds with nothing sent before ffmpeg is ended
FLOOR = pathlib.Path(os.environ.get("FCPM_FLOOR", "/dev/shm/fcpm-floor"))   # memory: no wear on the card
AIR = int(os.environ.get("FCPM_AIR_PORT", "8482"))  # the claims, on loopback; nginx passes /air to it
HOLD = 15                                       # seconds a claim on the air lasts unless said again
MUSIC = pathlib.Path(os.environ.get("FCPM_JUKEBOX", "/srv/landing/jukebox"))   # the floor's jukebox's folder
BUS = "fcpm-standby"                            # the null sink whose monitor is the sound we send
os.environ.setdefault("PULSE_SERVER", f"unix:/run/user/{os.getuid()}/pulse/native")


def slate():
    """The slate under the mark, drawn from the brand: the lockup on ink, where the mark's row leaves room."""
    c = BRAND["colours"]
    first, second = (html.escape(w) for w in BRAND["names"]["lockup"])
    svg = f"""<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">
  <rect width="{W}" height="{H}" fill="{c['ink']}"/>
  <text x="{W / 2}" y="{H * 0.66}" text-anchor="middle" font-family="DejaVu Serif, Georgia, serif"
        font-weight="700" font-size="76" fill="{c['paper']}">{first}</text>
  <text x="{W / 2}" y="{H * 0.66 + 70}" text-anchor="middle" font-family="DejaVu Sans, sans-serif"
        font-size="40" letter-spacing="10" fill="{c['masthead-soft']}">{second.upper()}</text>
</svg>"""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    drawn = subprocess.run(["rsvg-convert", "-w", str(W), "-h", str(H)], input=svg.encode(),
                           capture_output=True, check=True).stdout
    if not SLATE.exists() or SLATE.read_bytes() != drawn:
        SLATE.write_bytes(drawn)
    return SLATE


def hand(y1, y2, width, turn, colour):
    return (f'<line x1="50" y1="{y1}" x2="50" y2="{y2}" stroke="{colour}" stroke-width="{width}" '
            f'stroke-linecap="square" transform="rotate({turn:.2f} 50 50)"/>')


def mark(at):
    """The mark at a moment, as brand/idle/dim.js draws it, laid on its side for a landscape picture:
    three squares in a row, each leaning by the tilt, a split clock (the hour hand, the seconds, the
    minute hand) and the lit one walking the row and back, a step every four seconds. PNG, ROW in size."""
    c, tilt = BRAND["colours"], BRAND["tilt"]
    s = at.second
    m = at.minute + s / 60
    h = at.hour % 12 + m / 60
    lit = (1, 2, 1, 0)[int(at.timestamp()) // 4 % 4]
    width, height = ROW
    cy, step = height / 2, SIDE + GAP
    left = (width - (3 * SIDE + 2 * GAP)) / 2
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}">',
           f'<rect x="{left}" y="{cy - SIDE / 60}" width="{3 * SIDE + 2 * GAP}" height="{SIDE / 30}" '
           f'fill="{c["slate"]}"/>']
    for i in range(3):
        face, ink = (c["signal"], c["ink"]) if i == lit else (c["slate"], c["masthead-soft"])
        out.append(f'<g transform="translate({left + SIDE / 2 + i * step} {cy}) rotate({tilt}) '
                   f'scale({SIDE / 100}) translate(-50 -50)"><rect width="100" height="100" fill="{face}"/>')
        if i == 0:
            out.append(hand(54, 29, 6, h * 30, ink))
        if i == 1:
            out.append(f'<g opacity="0.35">' + "".join(
                hand(11, 15, 1.6 if n % 3 else 3, n * 30, ink) for n in range(12)) + "</g>")
            out.append(hand(8, 18, 4, s * 6, ink))
        if i == 2:
            out.append(hand(55, 17, 4, m * 6, ink))
        out.append("</g>")
    out.append("</svg>")
    return subprocess.run(["rsvg-convert"], input="".join(out).encode(), capture_output=True, check=True).stdout


def paint(pipe):
    """The mark into ffmpeg, a frame on each second of the room's clock, until ffmpeg goes. Late (a slow
    draw, a busy box), the frame is said again until it has caught up, so the picture keeps time."""
    from datetime import datetime
    from zoneinfo import ZoneInfo
    room, start, n = ZoneInfo(ROOM_TZ), int(time.time()) + 1, 0
    try:
        while True:
            time.sleep(max(0, start + n - time.time()))
            frame = mark(datetime.fromtimestamp(start + n, room))
            while start + n <= time.time():
                pipe.write(frame)
                n += 1
            pipe.flush()
    except (BrokenPipeError, ValueError, OSError):
        pass


def bus():
    """Standby's bus, made if PulseAudio is up and it isn't there yet; whether we can send from it."""
    def there():
        r = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True)
        return r.returncode == 0, any(l.split("\t")[1:2] == [BUS] for l in r.stdout.splitlines())
    up, made = there()
    if up and not made:
        subprocess.run(["pactl", "load-module", "module-null-sink", f"sink_name={BUS}", "rate=48000",
                        "channels=2", f"sink_properties=device.description={BUS}"], capture_output=True)
        up, made = there()
    return made


def command(out, seconds=None, sound=False):
    """ffmpeg: the slate decoded once and repeated, the mark over it (a frame a second, from paint() on
    stdin, which also keeps the pace), and the bus's sound (or silence), as the channel's shape. The
    bus's samples are counted from zero, to run beside the picture. Encoded by the GPU (VAAPI, a tenth
    of a core) when this account may use it, else by x264."""
    x, y = (W - ROW[0]) // 2, int(H * MARK_Y - ROW[1] / 2)
    lay = (f"[0:v]format=yuv420p,loop=loop=-1:size=1:start=0,fps={FPS}[slate];"
           f"[1:v]format=yuva420p,fps={FPS}[mark];[slate][mark]overlay={x}:{y}:format=yuv420")
    if os.access(GPU, os.R_OK | os.W_OK):
        pre, graph = ["-vaapi_device", GPU], f"{lay},format=nv12,hwupload[v]"
        video = ["-c:v", "h264_vaapi", "-g", str(FPS * 2), "-b:v", "1500k", "-maxrate", "1500k"]
    else:
        pre, graph = [], f"{lay},format=yuv420p[v]"
        video = ["-c:v", "libx264", "-preset", "ultrafast", "-tune", "stillimage", "-g", str(FPS * 2),
                 "-b:v", "1500k", "-maxrate", "1500k", "-bufsize", "3000k"]
    audio = (["-thread_queue_size", "1024", "-f", "pulse", "-sample_rate", "48000", "-channels", "2",
              "-i", f"{BUS}.monitor"] if sound else ["-f", "lavfi", "-i", "anullsrc=r=48000:cl=stereo"])
    cmd = (["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning"] + pre
           + ["-i", str(slate()), "-f", "image2pipe", "-c:v", "png", "-framerate", "1", "-i", "pipe:0"] + audio
           + ["-filter_complex", graph + ";[2:a]asetpts=N/SR/TB[a]", "-map", "[v]", "-map", "[a]"] + video
           + ["-c:a", "aac", "-b:a", "128k", "-ar", "48000", "-ac", "2"])
    if seconds:
        cmd += ["-t", str(seconds)]
    return cmd + out


def encode(out, env, seconds=None, sound=False):
    """ffmpeg started on `out`, with the mark painted into it from a thread of its own."""
    p = subprocess.Popen(command(out, seconds, sound), env=env, stdin=subprocess.PIPE, preexec_fn=bound)
    threading.Thread(target=paint, args=(p.stdin,), daemon=True).start()
    return p


def bound():
    """In the child, before ffmpeg: end with this process. Without it a killed standby left its ffmpeg
    running for two days (2026-10-22), holding the GPU's encoder and YouTube's backup."""
    import ctypes
    import signal
    ctypes.CDLL(None).prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG


FLOOR_OUT = ["-f", "hls", "-hls_time", "2", "-hls_list_size", "6",
             "-hls_flags", "delete_segments+omit_endlist+temp_file",
             "-hls_segment_filename", str(FLOOR / "s%06d.ts"), str(FLOOR / "index.m3u8")]


PROBED = {}


def facts(file):
    """A track's title (its tag, or its name without the track number), artist (its tag) and length."""
    path = MUSIC / file
    if path not in PROBED:
        r = subprocess.run(["ffprobe", "-v", "error", "-of", "json", "-show_format", str(path)],
                           capture_output=True, text=True)
        fmt = json.loads(r.stdout or "{}").get("format", {})
        tags = {k.lower(): v for k, v in (fmt.get("tags") or {}).items()}
        name = path.stem.lstrip("0123456789").lstrip(" .-_") or path.stem
        PROBED[path] = {"id": file, "artist": tags.get("artist") or "", "title": tags.get("title") or name,
                        "length": round(float(fmt.get("duration") or 0), 1)}
    return PROBED[path]


def floor_now():
    """What the floor's jukebox (./jukebox) is playing, in the shape the jukebox role's /now.json has,
    so the standby page reads either, and what comes after it: the rest of the folder in the order it
    plays, round to the one before this, and where this one is in the folder's order (`at`)."""
    try:
        said = json.loads((STATE_DIR / "jukebox.json").read_text())
    except (OSError, ValueError):
        said = {}
    if said.get("state") != "playing" or not said.get("file"):
        return {"playing": None, "next": [], "from": "floor", "folder": str(MUSIC)}
    order = said.get("order") or [said["file"]]
    at = order.index(said["file"]) if said["file"] in order else -1
    started = time.mktime(time.strptime(said["at"], "%Y-%m-%dT%H:%M:%S%z"))
    return {"playing": dict(facts(said["file"]), position=round(max(0, time.time() - started), 1)),
            "next": [facts(f) for f in order[at + 1:] + order[:max(at, 0)]],
            "at": max(at, 0), "from": "floor", "folder": str(MUSIC)}


class Air:
    """Who has said they have the air, and until when."""

    def __init__(self):
        self.lock, self.claims = threading.Lock(), {}

    def claim(self, holder, release=False):
        with self.lock:
            if release:
                self.claims.pop(holder, None)
            else:
                self.claims[holder] = time.time() + HOLD

    def holder(self):
        with self.lock:
            self.claims = {h: t for h, t in self.claims.items() if t > time.time()}
            return min(self.claims, key=self.claims.get) if self.claims else None

    def serve(self):
        air = self

        class Door(BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass

            def reply(self, code, body):
                data = (json.dumps(body) + "\n").encode()
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                self.wfile.write(data)

            def do_GET(self):
                if self.path.split("?")[0] == "/now.json":
                    return self.reply(200, floor_now())
                self.reply(200, {"holder": air.holder(), "hold": HOLD})

            def do_POST(self):
                try:
                    n = int(self.headers.get("Content-Length") or 0)
                    body = json.loads(self.rfile.read(n) or b"{}") if n else {}
                    holder = str(body.get("holder") or "").strip()[:60]
                except ValueError:
                    holder = ""
                if not holder:
                    return self.reply(400, {"error": 'say {"holder": "who"}'})
                air.claim(holder, release=bool(body.get("release")))
                self.reply(200, {"holder": air.holder(), "hold": HOLD})
        server = ThreadingHTTPServer(("127.0.0.1", AIR), Door)
        server.daemon_threads = True
        threading.Thread(target=server.serve_forever, daemon=True).start()


def note(state, why, **more):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / "standby.json").write_text(json.dumps(
        dict({"state": state, "why": why, "floor": str(FLOOR / "index.m3u8")}, **more,
             at=time.strftime("%Y-%m-%dT%H:%M:%S%z")), indent=1) + "\n")
    print(f"standby: {state}: {why}", flush=True)


def main(args):
    env = dict(os.environ, TZ=ROOM_TZ)
    if args[:1] == ["--try"] and len(args) == 2:
        if encode(["-y", args[1]], env, seconds=10, sound=bus()).wait():
            sys.exit("standby: ffmpeg failed")
        print(f"standby: ten seconds in {args[1]}")
        return
    if args == ["--check"]:
        slate()
        key, sound = (KEY.read_text().strip() if KEY.exists() else ""), bus()
        print(json.dumps({"slate": str(SLATE), "key": bool(key), "floor": str(FLOOR / "index.m3u8"),
                          "sound": f"{BUS}.monitor" if sound else "silence",
                          "air": f"127.0.0.1:{AIR}", "to": INGEST + "?backup=1/<key>",
                          "ffmpeg": " ".join(command(FLOOR_OUT, sound=sound))[:600]}, indent=1))
        return
    if args:
        sys.exit(__doc__)
    air = Air()
    air.serve()
    threading.Thread(target=floor_now, daemon=True).start()   # the folder's tracks probed before anyone asks
    FLOOR.mkdir(parents=True, exist_ok=True)
    for old in FLOOR.iterdir():
        old.unlink()
    sound = bus()
    floor = encode(FLOOR_OUT, env, sound=sound)
    copy, said, asked = None, None, time.time()
    try:
        while floor.poll() is None:
            time.sleep(2)
            playlist = FLOOR / "index.m3u8"
            if playlist.exists() and time.time() - playlist.stat().st_mtime > STALL:
                note("stalled", f"the floor has not moved for {STALL} s; to be started again")
                return 1
            if not sound and time.time() - asked > 30:
                asked = time.time()
                if bus():
                    note("restarting", f"{BUS} is there now; the floor is started again with its sound")
                    return 1
            holder = air.holder()
            key = KEY.read_text().strip() if KEY.exists() else ""
            if copy and copy.done():
                copy = None
            if holder and copy:
                copy.stop()
                copy = None
            if not holder and not copy and key and playlist.exists():
                copy = Copy(key, env)
            now = ("yielded", f"{holder} has the air", holder) if holder else \
                  ("waiting", f"no key in {KEY}", None) if not key else \
                  ("sending", "the floor to YouTube's backup ingest, with "
                   + (f"{BUS}'s sound" if sound else "silence"), None) if copy else \
                  ("starting", "the floor is not playing yet", None)
            if now != said:
                note(now[0], now[1], holder=now[2])
                said = now
        note("stopped", f"the floor's ffmpeg ended ({floor.returncode})")
        return 1
    finally:
        if copy:
            copy.stop()
        if floor.poll() is None:
            floor.kill()


class Copy:
    """The floor to YouTube's backup ingest, as it is (no second encode), until stopped or stuck."""

    def __init__(self, key, env):
        out = ["-f", "flv", "-rtmp_app", "live2?backup=1", "-rtmp_playpath", key, INGEST]
        self.p = subprocess.Popen(
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning", "-live_start_index", "-1",
             "-i", str(FLOOR / "index.m3u8"), "-c", "copy", "-progress", "pipe:1", "-stats_period", "5"]
            + out, env=env, stdout=subprocess.PIPE, text=True, preexec_fn=bound)
        self.sent = {"bytes": -1, "at": time.time()}
        threading.Thread(target=self.watch, daemon=True).start()

    def watch(self):
        for line in self.p.stdout:
            k, _, v = line.strip().partition("=")
            if k == "total_size" and v.isdigit() and int(v) > self.sent["bytes"]:
                self.sent.update(bytes=int(v), at=time.time())

    def done(self):
        """Ended, or stuck sending nothing (then ended here, to be started again)."""
        if self.p.poll() is not None:
            note("stopped", f"the copy to YouTube ended ({self.p.returncode}); starting it again")
            return True
        if time.time() - self.sent["at"] > STALL:
            note("stalled", f"nothing sent for {STALL} s; the copy is ended, to be started again")
            self.stop()
            return True
        return False

    def stop(self):
        if self.p.poll() is None:
            self.p.terminate()
            try:
                self.p.wait(5)
            except subprocess.TimeoutExpired:
                self.p.kill()
                self.p.wait()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
