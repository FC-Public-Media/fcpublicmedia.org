#!/usr/bin/env python3
"""standby — our own steady picture on YouTube's backup ingest, so channel 97's YouTube stream never ends.

    python3 -I machines/broadcast/standby               run (the broadcast crew's `backup` line keeps it up)
    python3 -I machines/broadcast/standby --check       draw the slate and say what it would send, send nothing
    python3 -I machines/broadcast/standby --try FILE    ten seconds of it into FILE, to look at

When the channel's own stream pauses (a gap in the schedule, an IP-exempt program), YouTube ends a
broadcast that has nothing coming in. Fed on its backup ingest with the same key, YouTube switches
viewers here instead, and back to the channel when it returns. The picture is the brand's mark and
lockup (site/_data/brand.json, drawn by rsvg-convert) with the time in the room, at 1080p30 and 48 kHz
stereo like the channel, so YouTube takes the two as a pair. The sound is standby's bus, a PulseAudio
null sink (`fcpm-standby`) made here, which the jukebox plays into; silence while there is no
PulseAudio to make it in, and once it can be made, ffmpeg is ended so the crew starts it with the bus.
The slate is decoded once and repeated,
and encoded by the GPU when it can be: about a tenth of a core. The key is ~/.config/fcpm/youtube.key, as
the relay's; nothing here prints it. If ffmpeg sends nothing for a minute (YouTube dropped the
connection and ffmpeg hung on it, as on 2026-10-22), it is ended and this exits, so the crew starts it
again. While Cablecast itself pushes to the backup ingest (a destination on `b.rtmp.youtube.com`,
attached on the board's /broadcast/), the ingest is Cablecast's: standby says `yielding`, sends
nothing, and takes it back when that is detached. ffmpeg and the system python. See PROFILE.md, "To YouTube".
"""
import html
import json
import os
import pathlib
import subprocess
import sys
import threading
import time

HERE = pathlib.Path(__file__).resolve().parent
BRAND = json.loads((HERE.parent.parent / "site/_data/brand.json").read_text())
KEY = pathlib.Path.home() / ".config/fcpm/youtube.key"
STATE_DIR = pathlib.Path.home() / ".local/state/fcpm/broadcast"
SLATE = STATE_DIR / "standby-slate.png"
FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
INGEST = "rtmps://b.rtmp.youtube.com/live2"     # YouTube's backup server; the app carries ?backup=1
W, H, FPS = 1920, 1080, 30
ROOM_TZ = "America/Denver"
GPU = "/dev/dri/renderD128"
STALL = 60                                      # seconds with nothing sent before ffmpeg is ended
YIELD = 20                                      # seconds between asks whether Cablecast holds the ingest
sys.path.insert(0, str(HERE))
import cablecast  # noqa: E402  the same hand on the box


def cablecast_on_backup():
    """Whether Cablecast pushes to the backup ingest. A box that can't be asked is taken as no: then
    standby keeps the stream from ending, as it did before it asked."""
    try:
        return cablecast.on_backup()
    except (Exception, SystemExit):
        return False
BUS = "fcpm-standby"                            # the null sink whose monitor is the sound we send
os.environ.setdefault("PULSE_SERVER", f"unix:/run/user/{os.getuid()}/pulse/native")


def slate():
    """The slate, drawn from the brand: the mark leaning by its tilt over the lockup, on ink."""
    c, tilt = BRAND["colours"], BRAND["tilt"]
    first, second = (html.escape(w) for w in BRAND["names"]["lockup"])
    side, cx, cy = 300, W / 2, H * 0.38
    svg = f"""<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">
  <rect width="{W}" height="{H}" fill="{c['ink']}"/>
  <rect x="{cx - side / 2}" y="{cy - side / 2}" width="{side}" height="{side}" fill="{c['signal']}"
        transform="rotate({tilt} {cx} {cy})"/>
  <text x="{cx}" y="{H * 0.66}" text-anchor="middle" font-family="DejaVu Serif, Georgia, serif"
        font-weight="700" font-size="76" fill="{c['paper']}">{first}</text>
  <text x="{cx}" y="{H * 0.66 + 70}" text-anchor="middle" font-family="DejaVu Sans, sans-serif"
        font-size="40" letter-spacing="10" fill="{c['masthead-soft']}">{second.upper()}</text>
</svg>"""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    drawn = subprocess.run(["rsvg-convert", "-w", str(W), "-h", str(H)], input=svg.encode(),
                           capture_output=True, check=True).stdout
    if not SLATE.exists() or SLATE.read_bytes() != drawn:
        SLATE.write_bytes(drawn)
    return SLATE


def bus():
    """Standby's bus, made if PulseAudio is up and it isn't there yet; whether we can send from it."""
    def there():
        r = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True)
        return r.returncode == 0, any(l.split("\t")[1:2] == [BUS] for l in r.stdout.splitlines())
    up, made = there()
    if up and not made:
        subprocess.run(["pactl", "load-module", "module-null-sink", f"sink_name={BUS}", "rate=48000",
                        "channels=2", f"sink_properties=device.description={BUS}"], capture_output=True)
        up, made = there()
    return made


def command(out, seconds=None, sound=False):
    """ffmpeg: the slate decoded once and repeated, the room's clock on it, and the bus's sound (or
    silence), as the channel's shape. The bus's samples are counted from zero, to run beside the
    repeated slate. Encoded by the GPU (VAAPI, a tenth of a core) when this account may use it, else
    by x264."""
    clock = (f"drawtext=fontfile={FONT}:text='%{{localtime\\:%H\\\\\\:%M}}':fontsize=54"
             f":fontcolor=0x{BRAND['colours']['masthead-soft'].lstrip('#')}:x=(w-text_w)/2:y=h*0.88")
    repeat = f"loop=loop=-1:size=1:start=0,fps={FPS},{clock},realtime"
    if os.access(GPU, os.R_OK | os.W_OK):
        pre, graph = ["-vaapi_device", GPU], f"[0:v]format=nv12,{repeat},hwupload[v]"
        video = ["-c:v", "h264_vaapi", "-g", str(FPS * 2), "-b:v", "1500k", "-maxrate", "1500k"]
    else:
        pre, graph = [], f"[0:v]format=yuv420p,{repeat}[v]"
        video = ["-c:v", "libx264", "-preset", "ultrafast", "-tune", "stillimage", "-g", str(FPS * 2),
                 "-b:v", "1500k", "-maxrate", "1500k", "-bufsize", "3000k"]
    audio = (["-f", "pulse", "-sample_rate", "48000", "-channels", "2", "-i", f"{BUS}.monitor"] if sound
             else ["-f", "lavfi", "-i", "anullsrc=r=48000:cl=stereo"])
    cmd = (["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning"] + pre
           + ["-i", str(slate())] + audio
           + ["-filter_complex", graph + ";[1:a]asetpts=N/SR/TB[a]", "-map", "[v]", "-map", "[a]"] + video
           + ["-c:a", "aac", "-b:a", "128k", "-ar", "48000", "-ac", "2"])
    if seconds:
        cmd += ["-t", str(seconds)]
    return cmd + out


def note(state, why):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / "standby.json").write_text(json.dumps(
        {"state": state, "why": why, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}, indent=1) + "\n")
    print(f"standby: {state}: {why}", flush=True)


def main(args):
    env = dict(os.environ, TZ=ROOM_TZ)
    if args[:1] == ["--try"] and len(args) == 2:
        subprocess.run(command(["-y", args[1]], seconds=10, sound=bus()), env=env, check=True)
        print(f"standby: ten seconds in {args[1]}")
        return
    key = KEY.read_text().strip() if KEY.exists() else ""
    out = ["-f", "flv", "-rtmp_app", "live2?backup=1", "-rtmp_playpath", key or "<key>", INGEST]
    if args == ["--check"]:
        slate()
        sound = bus()
        print(json.dumps({"slate": str(SLATE), "key": bool(key), "to": INGEST + "?backup=1/<key>",
                          "sound": f"{BUS}.monitor" if sound else "silence",
                          "ffmpeg": " ".join(command(out[:-3] + ["<key>", INGEST], sound=sound))[:600]}, indent=1))
        return
    if args:
        sys.exit(__doc__)
    while not key:
        note("waiting", f"no key in {KEY}")
        time.sleep(60)
        key = KEY.read_text().strip() if KEY.exists() else ""
    out[-2] = key
    if cablecast_on_backup():
        note("yielding", "Cablecast is pushing to YouTube's backup ingest")
        while cablecast_on_backup():
            time.sleep(YIELD)
    sound = bus()
    note("sending", "the slate to YouTube's backup ingest, with " + (f"{BUS}'s sound" if sound else "silence"))
    sys.exit(send(out, env, sound))


def send(out, env, sound):
    """ffmpeg to `out` until it ends, or until it has sent nothing for STALL seconds, or (sending
    silence) until the bus can be made; its exit code."""
    p = subprocess.Popen(command(["-progress", "pipe:1", "-stats_period", "5"] + out, sound=sound), env=env,
                         stdout=subprocess.PIPE, text=True)
    sent = {"bytes": -1, "at": time.time()}

    def watch():
        for line in p.stdout:
            k, _, v = line.strip().partition("=")
            if k == "total_size" and v.isdigit() and int(v) > sent["bytes"]:
                sent.update(bytes=int(v), at=time.time())
    threading.Thread(target=watch, daemon=True).start()
    asked = yielded = time.time()
    while p.poll() is None:
        time.sleep(5)
        if time.time() - yielded > YIELD:
            yielded = time.time()
            if cablecast_on_backup():
                note("yielding", "Cablecast is pushing to YouTube's backup ingest; ffmpeg ended")
                p.kill()
                p.wait()
                return 1
        if not sound and time.time() - asked > 30:
            asked = time.time()
            if bus():
                note("restarting", f"{BUS} is there now; ffmpeg ended, to be started with its sound")
                p.kill()
                p.wait()
                return 1
        if time.time() - sent["at"] > STALL:
            note("stalled", f"nothing sent for {STALL} s; ffmpeg ended, to be started again")
            p.kill()
            p.wait()
            return 1
    note("stopped", f"ffmpeg ended ({p.returncode})")
    return p.returncode or 1


if __name__ == "__main__":
    main(sys.argv[1:])
