#!/bin/sh
# sync — put on the profiles this machine wears, or say how far off they are. A machine named in
# two jobs' `names` wears both, one after the other here.
#
#   machines/sync              status: which profile, what differs. Changes nothing
#   machines/sync install      put the profile on: carried files, compiled settings, PATH, clone
#                              missing mirrors, what scripts hold (tasks), unmapped files removed,
#                              system files (at the desk: FCPM_DESK). A person runs this, not a
#                              session; the pool's pass runs it too, so what is mapped is put back
#   machines/sync mirror       bring the machine's copies back into this checkout,
#                              for a pull request. Refused in refs/
#   machines/sync -p NAME ...  name the profile instead of asking the machine
#
# sh, no Python: a bare machine runs this before it has one. See docs/station.md, Sync and MANIFEST.

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)
profiles=""
if [ "${1:-}" = "-p" ]; then profiles=${2:-}; shift 2; fi
cmd=${1:-status}

# The name this machine answers to, per platform, the way `binding` asks.
asked() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) echo "windows ComputerName ${COMPUTERNAME:-}" ;;
    Darwin) echo "darwin LocalHostName $(scutil --get LocalHostName 2>/dev/null)" ;;
    *) echo "linux hostname $(hostname 2>/dev/null)" ;;
  esac
}

if [ -z "$profiles" ]; then
  fact=$(asked | tr '[:upper:]' '[:lower:]')
  for n in "$HERE"/*/names; do
    if sed -e 's/#.*$//' "$n" | awk 'NF == 3 { print tolower($1 " " $2 " " $3) }' | grep -qxF "$fact"; then
      profiles="$profiles $(basename "$(dirname "$n")")"
    fi
  done
fi
if [ -z "$profiles" ]; then
  echo "sync: this machine ($(asked)) wears no profile here. That is the clean state."
  exit 0
fi

# One pass per job this machine wears; a pass's `exit` ends only that pass.
all=0
for profile in $profiles; do
(
P="$HERE/$profile"
echo "profile  $profile"
MAN="$P/MANIFEST"                                    # none: nothing placed, but its check still runs
[ -f "$MAN" ] || { echo "carries no MANIFEST"; MAN=/dev/null; }

rc=0
held_failed=0                                        # a `held` that did not take keeps what `gone` would remove
while read -r mode src dst <&3; do
  case "$mode" in ''|'#'*) continue ;; esac
  from="$P/$src"; to="$HOME/$dst"
  case "$mode:$cmd" in
    mirror:status)
      if [ ! -e "$to" ]; then echo "missing   ~/$dst"; rc=1
      elif cmp -s "$from" "$to"; then echo "same      ~/$dst"
      else echo "differs   ~/$dst   ($(git -C "$REPO" diff --no-index --shortstat "$from" "$to" | sed 's/^ *//'))"; rc=1
      fi ;;
    mirror:install)
      if [ -e "$to" ] && cmp -s "$from" "$to"; then continue; fi
      mkdir -p "$(dirname "$to")"
      [ -e "$to" ] && mv "$to" "$to.pre-sync" && echo "aside     ~/$dst -> $(basename "$to").pre-sync"
      cp -p "$from" "$to" && echo "placed    ~/$dst" ;;
    mirror:mirror)
      case "$REPO" in */refs/*|*/ref/*) echo "sync: $REPO is a read-only mirror; mirror into a work/ worktree" >&2; exit 2 ;; esac
      if [ -e "$to" ] && ! cmp -s "$from" "$to"; then cp -p "$to" "$from" && echo "brought   ~/$dst"; fi ;;
    clone:status|clone:install)
      sed -e 's/#.*$//' "$from" | while read -r url; do
        [ -n "$url" ] || continue
        name=$(basename "$url" .git)
        [ -e "$to/$name/.git" ] && continue
        if [ "$cmd" = status ]; then echo "missing   ~/$dst/$name"
        else mkdir -p "$to" && git clone --quiet "$url" "$to/$name" && echo "cloned    ~/$dst/$name"; fi
      done ;;
    clone:mirror) ;;
    # settings <profile> <home path>: that profile's GRANTS, compiled; never stored in the repository.
    settings:status|settings:install)
      want=$("$REPO/bin/runnables" compile "$src" 2>/dev/null)
      if [ -f "$to" ] && [ "$(cat "$to")" = "$want" ]; then [ "$cmd" = status ] && echo "same      ~/$dst (compiled from $src's GRANTS)"; continue; fi
      if [ "$cmd" = status ]; then
        if [ -f "$to" ]; then echo "differs   ~/$dst (not what $src's GRANTS compiles to)"; else echo "missing   ~/$dst"; fi; rc=1
      else
        mkdir -p "$(dirname "$to")"
        [ -e "$to" ] && mv "$to" "$to.pre-sync" && echo "aside     ~/$dst -> $(basename "$to").pre-sync"
        printf '%s\n' "$want" > "$to" && echo "placed    ~/$dst (compiled from $src's GRANTS)"
      fi ;;
    settings:mirror) ;;
    # path <home dir>: on this user's Windows PATH; a new window sees the change.
    path:status|path:install)
      win=$(cygpath -w "$HOME/$dst" 2>/dev/null || echo "$HOME/$dst")
      cur=$(powershell -NoProfile -Command "[Environment]::GetEnvironmentVariable('Path','User')" 2>/dev/null | tr -d '\r')
      if printf '%s' ";$cur;" | tr '[:upper:]' '[:lower:]' | grep -qF ";$(printf '%s' "$win" | tr '[:upper:]' '[:lower:]');"; then
        [ "$cmd" = status ] && echo "same      PATH has ~/$dst"; continue; fi
      if [ "$cmd" = status ]; then echo "missing   ~/$dst on PATH"; rc=1
      else
        powershell -NoProfile -Command "[Environment]::SetEnvironmentVariable('Path', ('$cur'.TrimEnd(';') + ';$win'), 'User')" &&
          echo "placed    ~/$dst on PATH (new windows see it)"
      fi ;;
    path:mirror) ;;
    # held <script> -: something of this machine's that is no file (a scheduled task), held by a script
    # in the repository. `script check` says same or differs in sync's words; install runs `script
    # install` when it differs, unattended too: what it holds needs no administrator. The script runs
    # from the repository, so what it registers names the committed file, never a copy.
    held:status|held:install)
      command -v powershell >/dev/null 2>&1 || { echo "sync: $src is Windows'" >&2; continue; }
      win=$(cygpath -w "$(cd "$(dirname "$from")" && pwd)/$(basename "$from")" 2>/dev/null || echo "$from")
      out=$(powershell -NoProfile -ExecutionPolicy Bypass -File "$win" check 2>&1); ok=$?
      out=$(printf '%s\n' "$out" | tr -d '\r')
      if [ $ok -eq 0 ]; then [ "$cmd" = status ] && printf '%s\n' "$out"; continue; fi
      if [ "$cmd" = status ]; then printf '%s\n' "$out"; rc=1; continue; fi
      powershell -NoProfile -ExecutionPolicy Bypass -File "$win" install >/dev/null 2>&1
      if now=$(powershell -NoProfile -ExecutionPolicy Bypass -File "$win" check 2>&1); then
        printf '%s\n' "$now" | tr -d '\r' | sed 's/^same      /placed    /'
      else
        printf '%s\n' "$now" | tr -d '\r'; echo "sync: $src did not take; fcpm install at the desk" >&2
        held_failed=1; rc=1
      fi ;;
    held:mirror) ;;
    # gone - <home path>: a path this profile no longer maps. Removed when a commit here holds its very
    # contents (git has it back), else left and named: sync never destroys what only this machine has.
    gone:status|gone:install)
      [ -e "$to" ] || continue
      # Named, not a failure to install: the pool's pass would otherwise try again every minute.
      if [ -d "$to" ]; then echo "stray     ~/$dst (unmapped, a folder: look, then remove it)"; [ "$cmd" = status ] && rc=1; continue; fi
      blob=$(git -C "$REPO" hash-object --no-filters -- "$to" 2>/dev/null)
      if [ -z "$blob" ] || ! git -C "$REPO" cat-file -e "$blob" 2>/dev/null; then
        echo "stray     ~/$dst (unmapped, and in no commit here: look, then delete it)"; [ "$cmd" = status ] && rc=1
      elif [ "$cmd" = status ]; then echo "stray     ~/$dst (unmapped; a commit holds it, so install removes it)"; rc=1
      elif [ "$held_failed" = 1 ]; then echo "kept      ~/$dst (what replaces it did not take)"; rc=1
      else rm -f "$to" && echo "removed   ~/$dst (unmapped; the history holds $(printf '%.12s' "$blob"))"; fi ;;
    gone:mirror) ;;
    # system <script> -: a file of the system's, held by the profile's script, which only an
    # administrator may write. `check` says same or differs; install asks for an administrator only
    # at the desk (FCPM_DESK, set by `fcpm install`). Unattended (the pool's pass), it
    # is left differing, for the next install at the desk. Declined, it is said, and nothing else stops.
    system:status|system:install)
      command -v powershell >/dev/null 2>&1 || { echo "sync: $src is Windows'" >&2; continue; }
      win=$(cygpath -w "$from" 2>/dev/null || echo "$from")
      if [ "$cmd" = install ] && [ -n "${FCPM_DESK:-}" ]; then
        powershell -NoProfile -ExecutionPolicy Bypass -File "$win" install | tr -d '\r'
      elif [ "$cmd" = install ]; then
        powershell -NoProfile -ExecutionPolicy Bypass -File "$win" check >/dev/null 2>&1 ||
          echo "waiting   $(basename "$src" .ps1) (system file): the next fcpm install at the desk places it"
      else
        out=$(powershell -NoProfile -ExecutionPolicy Bypass -File "$win" check 2>&1) || rc=1
        printf '%s\n' "$out" | tr -d '\r'
      fi ;;
    system:mirror) ;;
    *) echo "sync: unknown mode '$mode', or verb '$cmd'" >&2; exit 2 ;;
  esac
done 3< "$MAN"

if [ "$cmd" = status ]; then
  n=$(sed -e 's/#.*$//' "$MAN" | awk '$1 == "clone" { print $2 }' | while read -r l; do
      sed -e 's/#.*$//' "$P/$l" | grep -c . ; done | awk '{ s += $1 } END { print s + 0 }')
  echo "mirrors  $n listed"
  # SYNC_CHECK=0: the watcher wants only what differs; `fcpm check` runs the check.
  if [ "${SYNC_CHECK:-1}" = 0 ]; then :
  elif [ -f "$P/check.ps1" ] && command -v powershell >/dev/null 2>&1; then
    echo; powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$P/check.ps1" 2>/dev/null || echo "$P/check.ps1")" || rc=1
  elif [ -f "$P/check.sh" ]; then
    echo; sh "$P/check.sh" || rc=1
  fi
fi
exit $rc
) || all=$?
done
exit $all
