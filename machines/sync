#!/bin/sh
# sync — put on the profile this machine wears, or say how far off it is.
#
#   machines/sync              status: which profile, what differs. Changes nothing
#   machines/sync install      put the profile on: carried files, compiled settings, PATH, clone
#                              missing mirrors. A person runs this, not a session
#   machines/sync mirror       bring the machine's copies back into this checkout,
#                              for a pull request. Refused in refs/
#   machines/sync -p NAME ...  name the profile instead of asking the machine
#
# sh, no Python: a bare machine runs this before it has one. See docs/station.md, Sync and MANIFEST.

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)
profile=""
if [ "${1:-}" = "-p" ]; then profile=${2:-}; shift 2; fi
cmd=${1:-status}

# The name this machine answers to, per platform, the way `binding` asks.
asked() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) echo "windows ComputerName ${COMPUTERNAME:-}" ;;
    Darwin) echo "darwin LocalHostName $(scutil --get LocalHostName 2>/dev/null)" ;;
    *) echo "linux hostname $(hostname 2>/dev/null)" ;;
  esac
}

if [ -z "$profile" ]; then
  fact=$(asked | tr '[:upper:]' '[:lower:]')
  for n in "$HERE"/*/names; do
    if sed -e 's/#.*$//' "$n" | awk 'NF == 3 { print tolower($1 " " $2 " " $3) }' | grep -qxF "$fact"; then
      profile=$(basename "$(dirname "$n")"); break
    fi
  done
fi
if [ -z "$profile" ]; then
  echo "sync: this machine ($(asked)) wears no profile here. That is the clean state."
  exit 0
fi
P="$HERE/$profile"
[ -f "$P/MANIFEST" ] || { echo "sync: $profile carries no MANIFEST"; exit 0; }
echo "profile  $profile"

rc=0
while read -r mode src dst <&3; do
  case "$mode" in ''|'#'*) continue ;; esac
  from="$P/$src"; to="$HOME/$dst"
  case "$mode:$cmd" in
    mirror:status)
      if [ ! -e "$to" ]; then echo "missing   ~/$dst"; rc=1
      elif cmp -s "$from" "$to"; then echo "same      ~/$dst"
      else echo "differs   ~/$dst   ($(git -C "$REPO" diff --no-index --shortstat "$from" "$to" | sed 's/^ *//'))"; rc=1
      fi ;;
    mirror:install)
      if [ -e "$to" ] && cmp -s "$from" "$to"; then continue; fi
      mkdir -p "$(dirname "$to")"
      [ -e "$to" ] && mv "$to" "$to.pre-sync" && echo "aside     ~/$dst -> $(basename "$to").pre-sync"
      cp -p "$from" "$to" && echo "placed    ~/$dst" ;;
    mirror:mirror)
      case "$REPO" in */refs/*|*/ref/*) echo "sync: $REPO is a read-only mirror; mirror into a work/ worktree" >&2; exit 2 ;; esac
      if [ -e "$to" ] && ! cmp -s "$from" "$to"; then cp -p "$to" "$from" && echo "brought   ~/$dst"; fi ;;
    clone:status|clone:install)
      sed -e 's/#.*$//' "$from" | while read -r url; do
        [ -n "$url" ] || continue
        name=$(basename "$url" .git)
        [ -e "$to/$name/.git" ] && continue
        if [ "$cmd" = status ]; then echo "missing   ~/$dst/$name"
        else mkdir -p "$to" && git clone --quiet "$url" "$to/$name" && echo "cloned    ~/$dst/$name"; fi
      done ;;
    clone:mirror) ;;
    # settings <profile> <home path>: that profile's GRANTS, compiled; never stored in the repository.
    settings:status|settings:install)
      want=$("$REPO/bin/runnables" compile "$src" 2>/dev/null)
      if [ -f "$to" ] && [ "$(cat "$to")" = "$want" ]; then [ "$cmd" = status ] && echo "same      ~/$dst (compiled from $src's GRANTS)"; continue; fi
      if [ "$cmd" = status ]; then
        if [ -f "$to" ]; then echo "differs   ~/$dst (not what $src's GRANTS compiles to)"; else echo "missing   ~/$dst"; fi; rc=1
      else
        mkdir -p "$(dirname "$to")"
        [ -e "$to" ] && mv "$to" "$to.pre-sync" && echo "aside     ~/$dst -> $(basename "$to").pre-sync"
        printf '%s\n' "$want" > "$to" && echo "placed    ~/$dst (compiled from $src's GRANTS)"
      fi ;;
    settings:mirror) ;;
    # path <home dir>: on this user's Windows PATH; a new window sees the change.
    path:status|path:install)
      win=$(cygpath -w "$HOME/$dst" 2>/dev/null || echo "$HOME/$dst")
      cur=$(powershell -NoProfile -Command "[Environment]::GetEnvironmentVariable('Path','User')" 2>/dev/null | tr -d '\r')
      if printf '%s' ";$cur;" | tr '[:upper:]' '[:lower:]' | grep -qF ";$(printf '%s' "$win" | tr '[:upper:]' '[:lower:]');"; then
        [ "$cmd" = status ] && echo "same      PATH has ~/$dst"; continue; fi
      if [ "$cmd" = status ]; then echo "missing   ~/$dst on PATH"; rc=1
      else
        powershell -NoProfile -Command "[Environment]::SetEnvironmentVariable('Path', ('$cur'.TrimEnd(';') + ';$win'), 'User')" &&
          echo "placed    ~/$dst on PATH (new windows see it)"
      fi ;;
    path:mirror) ;;
    *) echo "sync: unknown mode '$mode', or verb '$cmd'" >&2; exit 2 ;;
  esac
done 3< "$P/MANIFEST"

if [ "$cmd" = status ]; then
  n=$(sed -e 's/#.*$//' "$P/MANIFEST" | awk '$1 == "clone" { print $2 }' | while read -r l; do
      sed -e 's/#.*$//' "$P/$l" | grep -c . ; done | awk '{ s += $1 } END { print s + 0 }')
  echo "mirrors  $n listed"
  # SYNC_CHECK=0: the watcher wants only what differs; `fcpm check` runs the check.
  if [ "${SYNC_CHECK:-1}" = 0 ]; then :
  elif [ -f "$P/check.ps1" ] && command -v powershell >/dev/null 2>&1; then
    echo; powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$P/check.ps1" 2>/dev/null || echo "$P/check.ps1")" || rc=1
  elif [ -f "$P/check.sh" ]; then
    echo; sh "$P/check.sh" || rc=1
  fi
fi
exit $rc
