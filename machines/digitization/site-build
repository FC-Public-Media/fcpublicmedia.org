#!/bin/sh
# site-build -- the public site, built from this checkout, so the LAN has it through a cloud outage:
# the door serves it as fcpublicmedia.local (FCPM_SITE_DIR, at-login) and site-name answers to the
# name. Every 5 minutes from the crew's `site` line; a build only when the checkout's commit moved.
# Jekyll is Debian's (gear.yml); the build is the deploy's (deploy.yml) with site-lan.yml's url on top.
cd "$(dirname "$0")/../.." || exit 1
out=$HOME/.local/state/fcpm/site
rev=$(git rev-parse --short HEAD) || exit 1
[ "$(readlink "$out/current" 2>/dev/null)" = "$rev" ] && exit 0
mkdir -p "$out"
rm -rf "$out/$rev.new"
if ! jekyll build -q -s site -d "$out/$rev.new" --config site/_config.yml,machines/digitization/site-lan.yml; then
  echo "site: build of $rev failed; $(readlink "$out/current" 2>/dev/null || echo nothing) stays up" >&2
  exit 1
fi
rm -rf "$out/$rev" && mv "$out/$rev.new" "$out/$rev"
ln -sfn "$rev" "$out/current.new" && mv -T "$out/current.new" "$out/current"
for d in "$out"/*/; do
  d=${d%/}
  case "${d##*/}" in "$rev"|current*) ;; *) rm -rf "$d" ;; esac
done
echo "site: $rev built, served from $out/current"
