#!/usr/bin/env python3
"""asks: the questions people showed us (wizard:model+ask), answered by bay 1's model one at a time.

    asks            keep answering: the oldest queued question, then the next (the crew's `keep` line)
    asks once       answer one question, if one is waiting
    asks status     what waits, and the last answers
    asks reindex    bottle any answer that lacks one, and make the index again

replies.py queues each question under the door's state (asks/queue/, oldest first). Each is asked as the
shape model+ask says (machines/production/shapes/ask.yml: our role first, the asker's own instructions inside
it, their quoted context and question after), at its effort word as machines/production/model.yml maps it, on
a model bay 1 serves: one already loaded, else the first it lists (pins in machines/production/models/<name>.yml).
There is no default model; the answer names the model that gave it.
Its words are then reduced to a label (shapes/label.yml), which is how a phone filters a category. The
answer is kept as asks/answers/<nonce>.json, named by the question's nonce: the asker's phone holds that
nonce, and finds its answer by it in the public loop. The question moves to asks/done/.

Each answer is then bottled for the public loop (pour.mjs: an unsigned transfer as AC1 fountain frames,
asks/bottles/<nonce>.json), and the index is made again (asks/bottles/index.json): what is on the air, each
nonce with its label and its bottle's id. An answer rides the loop for replies.URGENT seconds (ten minutes),
then falls off it and stays on hand; wizard:loop+recall brings one back, at once (takeover) or into the
running loop (inject). A phone reads the index, then keeps only the frames whose id
it wants. The door's /loop/ draws the index and the bottles in turn; it bottles nothing itself.

When bay 1 serves no model (asleep, `fcpm model off`, nothing picked), the question stays queued and is asked
again in a minute. Nothing here decides who may ask; replies.py has already read and checked the bottle.

Bay 1 serves every model of its spread on one port; what it lists (its /models) is what has joined, and
state.json carries that list for qr.local: each model, its lab and size, and whether it is loaded.
"""
import datetime
import hashlib
import json
import os
import pathlib
import shutil
import sys
import time
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "machines" / "kiosk"))
import replies  # noqa: E402  the door's state, its YAML and its clock

SHAPES = ROOT / "machines" / "production" / "shapes"
COMPOSER = ROOT / "site" / "assets" / "js" / "composer"
POUR = pathlib.Path(__file__).resolve().parent / "pour.mjs"
DROPLET = 48                      # bytes a frame, as the site pours
CONSOLE = {"blockSize": 20, "overhead": 6, "qr": "L"}     # qr.local's text screen: a version-6 code (41 modules);
                                  # a deep stock, so each pass of the loop can show fresh droplets (K and a bit)
STATE_FILE = "state.json"         # who answers, whether it's up, what it's on: what qr.local's inbox bar says
LOOP_MOST = 40                    # the most answers the loop carries at once
PUBLIC = ("schema", "in_reply_to", "shape", "label", "answer", "effort", "finish", "model", "model_sha256",
          "seed", "answered")     # what an answer's bottle carries: not who signed, not the question
MODEL_YML = ROOT / "machines" / "production" / "model.yml"
SPREAD = ROOT / "machines" / "production" / "models"
URL = "http://%s/v1/chat/completions" % os.environ.get("FCPM_MODEL_AT", "10.209.1.20:9931")
LISTED = URL.replace("/v1/chat/completions", "/models")
TIMEOUT = 600
IDLE, ASLEEP = 5, 60


def folder(name):
    return replies.STATE / "asks" / name


def shape(name):
    return replies.load_yaml(SHAPES / ("%s.yml" % name)) or {}


def facts(name=None):
    """model.yml with one model's own file over it (models/<name>.yml); model.yml alone without a name."""
    base = replies.load_yaml(MODEL_YML) or {}
    if not name:
        return base
    own = SPREAD / ("%s.yml" % name)
    return dict(base, **(replies.load_yaml(own) if own.is_file() else {"model": name}))


def knobs(effort, answer, model):
    """Our effort word as this model's knobs (model.yml); a knob the file doesn't name isn't sent. A model
    that always thinks (thinking: effort) gets its own level for the word, and room to think at either."""
    if model.get("thinking") == "effort":
        k = {"max_tokens": int(model.get("considered-thinking") or 0) + answer}
        if model.get("%s-effort" % effort):
            k["chat_template_kwargs"] = {"reasoning_effort": model["%s-effort" % effort]}
        return k
    if effort == "considered" and model.get("considered-thinking") is not None:
        k = {"max_tokens": int(model["considered-thinking"]) + answer,
             "thinking_budget_tokens": int(model["considered-thinking"])}
        if model.get("considered-nudge"):
            k["reasoning_budget_message"] = model["considered-nudge"]
        return k
    k = {"max_tokens": answer}
    if model.get("quick-thinking") is not None and int(model["quick-thinking"]) == 0:
        k["chat_template_kwargs"] = {"enable_thinking": False}
    return k


def seed_of(nonce):
    return int(hashlib.sha256(nonce.encode()).hexdigest()[:8], 16)


def messages_for(sh, messages):
    """Our role first; the asker's own instructions inside it, as theirs; then their context and question."""
    theirs = [m["content"] for m in messages if m["role"] == "system" and m["content"].strip()]
    system = sh.get("role") or ""
    if theirs:
        system += "\n\nThe person's own instructions, as they wrote them:\n" + "\n".join(theirs)
    return [{"role": "system", "content": system}] + [m for m in messages if m["role"] != "system"]


def post(body):
    req = urllib.request.Request(URL, json.dumps(body).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.load(r)


def complete(sh, msgs, seed, model, send=post):
    """One request at the shape's effort. Considered that comes back empty is asked again at quick, and says so."""
    effort = sh.get("effort") or "quick"
    answer = int(sh.get("answer") or model.get("answer") or 1024)
    body = {"model": model.get("model"), "messages": msgs, "seed": seed}
    r = send(dict(body, **knobs(effort, answer, model)))
    text = ((r.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
    if not text.strip() and effort != "quick":
        r = send(dict(body, **knobs("quick", answer, model)))
        text = ((r.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
        effort = "quick (considered came back empty)"
    choice = (r.get("choices") or [{}])[0]
    return {"text": text.strip(), "effort": effort, "finish": choice.get("finish_reason"),
            "tokens": (r.get("usage") or {}).get("completion_tokens")}


def label(text, seed, model, send=post):
    sh = shape("label")
    limit = int(sh.get("limit") or 2000)
    msgs = [{"role": "system", "content": sh.get("role") or ""},
            {"role": "user", "content": (sh.get("prompt") or "{input}").replace("{input}", text[:limit])}]
    got = complete(sh, msgs, seed, model, send)["text"]
    return " ".join(got.split()).strip(" .") or None


def alive():
    """Whether the model answers at all (its /health), asked without a question."""
    try:
        with urllib.request.urlopen(URL.replace("/v1/chat/completions", "/health"), timeout=5) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def answer_one(send=post, on=None):
    """The oldest waiting question, answered and filed. Returns its nonce, None when nothing waits; raises
    OSError (URLError) when the model doesn't answer, leaving the question queued."""
    waiting = sorted(folder("queue").glob("*.json")) if folder("queue").is_dir() else []
    if not waiting:
        return None
    path = waiting[0]
    try:
        q = json.loads(path.read_text(encoding="utf-8"))
        q["nonce"], q["messages"][-1]["content"]
    except (ValueError, KeyError, IndexError, TypeError):
        folder("held").mkdir(parents=True, exist_ok=True)     # unreadable: set aside, never asked again and again
        shutil.move(str(path), str(folder("held") / path.name))
        return path.stem
    who = answerer()
    if not who:
        raise urllib.error.URLError("bay 1 serves no model")
    sh, model = shape("ask"), facts(who)
    seed = seed_of(q["nonce"])
    if on:
        on(q["nonce"])
    got = complete(sh, messages_for(sh, q["messages"]), seed, model, send)
    question = q["messages"][-1]["content"]
    out = {"schema": "fcpm.answer/v0", "in_reply_to": q["nonce"], "shape": sh.get("shape"),
           "label": label(question, seed, model, send), "answer": got["text"], "effort": got["effort"],
           "finish": got["finish"], "tokens": got["tokens"], "model": model.get("model"),
           "model_sha256": (model.get("sha256") or "")[:12], "seed": seed,
           "asked": q.get("issued"), "answered": replies.now().isoformat(timespec="seconds"),
           "by": q.get("by"), "trust": q.get("trust")}
    folder("answers").mkdir(parents=True, exist_ok=True)
    (folder("answers") / ("%s.json" % q["nonce"])).write_text(json.dumps(out, ensure_ascii=False), encoding="utf-8")
    folder("done").mkdir(parents=True, exist_ok=True)
    shutil.move(str(path), str(folder("done") / path.name))
    replies.log({"name": path.stem, "verdict": "answered", "why": out["label"], "wizard": "wizard:model+ask",
                 "by": q.get("by")})
    reindex()
    return q["nonce"]


# ---- the public loop: each answer bottled, and the index of them --------------------------------------
# A loop shows each bottle K and a bit fresh droplets a pass (any K-and-a-bit rebuild it) and moves on, so it
# flows; the next pass shows the next droplets of the stock, so a phone that caught half of it gets new ones.

def pour(kind, text, **how):
    """An unsigned transfer as AC1 frames (pour.mjs, Node): {id, K, frames[, modules]}; None without Node."""
    node = replies.node_exe()
    if not node:
        return None
    import subprocess
    out = subprocess.run([node, str(POUR), str(COMPOSER)], capture_output=True, text=True, timeout=120,
                         input=json.dumps(dict({"kind": kind, "text": text, "blockSize": DROPLET}, **how)))
    return json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else None


def pour_both(kind, text):
    """The loop's frames, and the same bottle as qr.local's console frames (smaller, each with its QR modules)."""
    got = pour(kind, text)
    if got:
        small = pour(kind, text, **CONSOLE)
        if small:
            got["console"] = {"K": small["K"], "frames": small["frames"], "modules": small["modules"]}
    return got


def joined(fetch=None):
    """What bay 1 lists now (its /models), in the spread's order, each {model, lab, params, active, state};
    [] when it doesn't answer. A model it lists that the spread doesn't know is shown by its name alone."""
    try:
        if fetch:
            listed = fetch()
        else:
            with urllib.request.urlopen(LISTED, timeout=5) as r:
                listed = json.load(r)
        listed = {d["id"]: (d.get("status") or {}).get("value") for d in listed.get("data") or []}
    except (urllib.error.URLError, OSError, ValueError, KeyError, TypeError, AttributeError):
        return []
    known = sorted(SPREAD.glob("*.yml"))
    order = [p.stem for p in known if p.stem in listed] + sorted(set(listed) - {p.stem for p in known})
    out = []
    for name in order:
        f = facts(name) if (SPREAD / ("%s.yml" % name)).is_file() else {}
        out.append({"model": name, "lab": f.get("lab"), "params": f.get("params"), "active": f.get("active"),
                    "state": listed[name] or "loaded"})     # a one-model server lists only what it serves
    return out


def answerer(listed=None):
    """Who answers: a model bay 1 has loaded (no swap on the card), else the first it lists; None when it lists
    none, and the question waits."""
    listed = joined() if listed is None else listed
    loaded = [m["model"] for m in listed if m.get("state") == "loaded"]
    return (loaded or [m["model"] for m in listed] or [None])[0]


def say(**state):
    """asks/state.json: who answers and how it is, for qr.local's inbox bar, and the models bay 1 lists while it
    is up. Written only when it changes."""
    listed = joined() if state.get("up") else []
    now = dict({"shape": "model+ask", "by": "bay 1", "model": answerer(listed)}, **state)
    now["models"] = listed
    path = replies.STATE / "asks" / STATE_FILE
    try:
        was = json.loads(path.read_text(encoding="utf-8"))
        was.pop("at", None)
    except (OSError, ValueError):
        was = None
    if was == now:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(dict(now, at=replies.now().isoformat(timespec="seconds"))), encoding="utf-8")


def bottle(nonce):
    """asks/answers/<nonce>.json as its public bottle, asks/bottles/<nonce>.json. True when made."""
    a = json.loads((folder("answers") / ("%s.json" % nonce)).read_text(encoding="utf-8"))
    public = {k: a.get(k) for k in PUBLIC if k in a}
    got = pour_both("fcpm.answer", json.dumps(public, ensure_ascii=False, separators=(",", ":")))
    if not got:
        return False
    got.update({"in_reply_to": nonce, "label": a.get("label"), "answered": a.get("answered")})
    folder("bottles").mkdir(parents=True, exist_ok=True)
    (folder("bottles") / ("%s.json" % nonce)).write_text(json.dumps(got), encoding="utf-8")
    return True


def on_air(at=None):
    """What the loop carries now: answers given within replies.URGENT seconds, and any recalled within
    replies.RECALLED_FOR, newest first, at most LOOP_MOST. Returns (nonces, now): `now` is the latest takeover,
    {"at", "nonces"}, which the screens show at once before going back to the loop."""
    at = at or replies.now()
    def age(iso):
        try:
            return (at - datetime.datetime.fromisoformat(iso)).total_seconds()
        except (TypeError, ValueError):
            return float("inf")
    try:
        recalled = json.loads((replies.STATE / "asks" / "recall.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        recalled = {}
    recalled = {n: r for n, r in recalled.items() if age(r.get("at")) < replies.RECALLED_FOR}
    rows = []
    for p in (folder("answers").glob("*.json") if folder("answers").is_dir() else []):
        try:
            a = json.loads(p.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        n = a.get("in_reply_to")
        if n in recalled or age(a.get("answered")) < replies.URGENT:
            rows.append((recalled.get(n, {}).get("at") or a.get("answered") or "", n))
    nonces = [n for _, n in sorted(rows, reverse=True)][:LOOP_MOST]
    taken = [(r["at"], n) for n, r in recalled.items() if r.get("mode") == "takeover"]
    now = None
    if taken:
        latest = max(t for t, _ in taken)
        now = {"at": latest, "nonces": [n for t, n in taken if t == latest]}
    return nonces, now


def reindex():
    """The index bottle: what is on the air (on_air), each by nonce, label and bottle id, and the takeover if any.
    Any answer still without a bottle is bottled first. Returns the index, or None without Node."""
    nonces, now = on_air()
    rows = []
    for n in nonces:
        try:
            a = json.loads((folder("answers") / ("%s.json" % n)).read_text(encoding="utf-8"))
            b = folder("bottles") / ("%s.json" % n)
            if (not b.is_file() or "K" not in json.loads(b.read_text(encoding="utf-8")).get("console", {})) \
                    and not bottle(n):
                continue
            rows.append({"in_reply_to": n, "label": a.get("label"),
                         "id": json.loads(b.read_text(encoding="utf-8"))["id"], "answered": a["answered"]})
        except (OSError, ValueError, KeyError):
            continue
    index = {"schema": "fcpm.index/v0", "at": replies.now().isoformat(timespec="seconds"), "answers": rows}
    if now:
        index["now"] = now
    got = pour_both("fcpm.index", json.dumps(index, ensure_ascii=False, separators=(",", ":")))
    if not got:
        return None
    got["index"] = index
    folder("bottles").mkdir(parents=True, exist_ok=True)
    (folder("bottles") / "index.json").write_text(json.dumps(got), encoding="utf-8")
    return index

def status():
    waiting = sorted(folder("queue").glob("*.json")) if folder("queue").is_dir() else []
    print("waiting: %d" % len(waiting))
    done = sorted(folder("answers").glob("*.json"), key=lambda p: p.stat().st_mtime) if folder("answers").is_dir() else []
    print("answered: %d" % len(done))
    for p in done[-5:]:
        a = json.loads(p.read_text(encoding="utf-8"))
        print("  %s  %s  [%s]  %s" % (a.get("answered"), a["in_reply_to"][:12], a.get("label") or "",
                                     " ".join((a.get("answer") or "").split())[:80]))


def main(argv):
    verb = argv[1] if len(argv) > 1 else "keep"
    if verb == "status":
        status()
        return 0
    if verb == "once":
        try:
            n = answer_one()
        except (urllib.error.URLError, OSError) as e:
            print("asks: the model did not answer (%s); the question waits" % e, file=sys.stderr)
            return 1
        print("asks: %s" % (("answered " + n) if n else "nothing waiting"))
        return 0
    if verb == "reindex":
        index = reindex()
        print("asks: %s" % ("index of %d" % len(index["answers"]) if index else "no Node, no bottles"))
        return 0
    if verb != "keep":
        print(__doc__, file=sys.stderr)
        return 2
    reindex()
    checked, aired = 0.0, on_air()
    while True:
        if on_air() != aired:                    # an answer fell off, or one was recalled: the loop follows
            reindex()
            aired = on_air()
        try:
            n = answer_one(on=lambda nonce: say(up=True, working=nonce, trouble=None))
        except (urllib.error.URLError, OSError) as e:
            say(up=False, working=None, trouble=None)
            print("asks: the model did not answer (%s); asking again in %ds" % (e, ASLEEP), flush=True)
            time.sleep(ASLEEP)
            checked = time.time()
            continue
        except Exception as e:                       # anything else is trouble, said where people look
            say(up=True, working=None, trouble=("%s" % e)[:60])
            print("asks: trouble: %r" % e, flush=True)
            time.sleep(ASLEEP)
            continue
        if n:
            print("asks: answered %s" % n, flush=True)
            say(up=True, working=None, trouble=None)
            aired = on_air()
        else:
            if time.time() - checked >= ASLEEP:      # idle: is the model there? asked once a minute at most
                say(up=alive(), working=None, trouble=None)
                checked = time.time()
            time.sleep(IDLE)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
