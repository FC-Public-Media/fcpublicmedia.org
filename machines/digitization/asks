#!/usr/bin/env python3
"""asks: the questions people showed us (wizard:model+ask), answered by bay 1's model one at a time.

    asks            keep answering: the oldest queued question, then the next (the crew's `keep` line)
    asks once       answer one question, if one is waiting
    asks status     what waits, and the last answers
    asks reindex    bottle any answer that lacks one, and make the index again

replies.py queues each question under the door's state (asks/queue/, oldest first). Each is asked as the
shape model+ask says (machines/production/shapes/ask.yml: our role first, the asker's own instructions inside
it, their quoted context and question after), at its effort word as machines/production/model.yml maps it.
Its words are then reduced to a label (shapes/label.yml), which is how a phone filters a category. The
answer is kept as asks/answers/<nonce>.json, named by the question's nonce: the asker's phone holds that
nonce, and finds its answer by it in the public loop. The question moves to asks/done/.

Each answer is then bottled for the public loop (pour.mjs: an unsigned transfer as AC1 fountain frames,
asks/bottles/<nonce>.json), and the index is made again (asks/bottles/index.json): the last day's answers,
each nonce with its label and its bottle's id. A phone reads the index, then keeps only the frames whose id
it wants. The door's /loop/ draws the index and the bottles in turn; it bottles nothing itself.

When the model is off (bay 1 asleep, `fcpm model off`), the question stays queued and is asked again in a
minute. Nothing here decides who may ask; replies.py has already read and checked the bottle.
"""
import datetime
import hashlib
import json
import os
import pathlib
import shutil
import sys
import time
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "machines" / "kiosk"))
import replies  # noqa: E402  the door's state, its YAML and its clock

SHAPES = ROOT / "machines" / "production" / "shapes"
COMPOSER = ROOT / "site" / "assets" / "js" / "composer"
POUR = pathlib.Path(__file__).resolve().parent / "pour.mjs"
DROPLET = 48                      # bytes a frame, as the site pours
LOOP_DAYS, LOOP_MOST = 1, 40      # what the index holds: the last day's answers, at most this many
PUBLIC = ("schema", "in_reply_to", "shape", "label", "answer", "effort", "finish", "model", "model_sha256",
          "seed", "answered")     # what an answer's bottle carries: not who signed, not the question
MODEL_YML = ROOT / "machines" / "production" / "model.yml"
URL = "http://%s/v1/chat/completions" % os.environ.get("FCPM_MODEL_AT", "10.209.1.20:9931")
TIMEOUT = 600
IDLE, ASLEEP = 5, 60


def folder(name):
    return replies.STATE / "asks" / name


def shape(name):
    return replies.load_yaml(SHAPES / ("%s.yml" % name)) or {}


def knobs(effort, answer, model):
    """Our effort word as this model's knobs (model.yml); a knob the file doesn't name isn't sent."""
    if effort == "considered" and model.get("considered-thinking") is not None:
        k = {"max_tokens": int(model["considered-thinking"]) + answer,
             "thinking_budget_tokens": int(model["considered-thinking"])}
        if model.get("considered-nudge"):
            k["reasoning_budget_message"] = model["considered-nudge"]
        return k
    k = {"max_tokens": answer}
    if model.get("quick-thinking") is not None and int(model["quick-thinking"]) == 0:
        k["chat_template_kwargs"] = {"enable_thinking": False}
    return k


def seed_of(nonce):
    return int(hashlib.sha256(nonce.encode()).hexdigest()[:8], 16)


def messages_for(sh, messages):
    """Our role first; the asker's own instructions inside it, as theirs; then their context and question."""
    theirs = [m["content"] for m in messages if m["role"] == "system" and m["content"].strip()]
    system = sh.get("role") or ""
    if theirs:
        system += "\n\nThe person's own instructions, as they wrote them:\n" + "\n".join(theirs)
    return [{"role": "system", "content": system}] + [m for m in messages if m["role"] != "system"]


def post(body):
    req = urllib.request.Request(URL, json.dumps(body).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.load(r)


def complete(sh, msgs, seed, model, send=post):
    """One request at the shape's effort. Considered that comes back empty is asked again at quick, and says so."""
    effort = sh.get("effort") or "quick"
    answer = int(sh.get("answer") or model.get("answer") or 1024)
    body = {"model": model.get("model"), "messages": msgs, "seed": seed}
    r = send(dict(body, **knobs(effort, answer, model)))
    text = ((r.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
    if not text.strip() and effort != "quick":
        r = send(dict(body, **knobs("quick", answer, model)))
        text = ((r.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
        effort = "quick (considered came back empty)"
    choice = (r.get("choices") or [{}])[0]
    return {"text": text.strip(), "effort": effort, "finish": choice.get("finish_reason"),
            "tokens": (r.get("usage") or {}).get("completion_tokens")}


def label(text, seed, model, send=post):
    sh = shape("label")
    limit = int(sh.get("limit") or 2000)
    msgs = [{"role": "system", "content": sh.get("role") or ""},
            {"role": "user", "content": (sh.get("prompt") or "{input}").replace("{input}", text[:limit])}]
    got = complete(sh, msgs, seed, model, send)["text"]
    return " ".join(got.split()).strip(" .") or None


def answer_one(send=post):
    """The oldest waiting question, answered and filed. Returns its nonce, None when nothing waits; raises
    OSError (URLError) when the model doesn't answer, leaving the question queued."""
    waiting = sorted(folder("queue").glob("*.json")) if folder("queue").is_dir() else []
    if not waiting:
        return None
    path = waiting[0]
    try:
        q = json.loads(path.read_text(encoding="utf-8"))
        q["nonce"], q["messages"][-1]["content"]
    except (ValueError, KeyError, IndexError, TypeError):
        folder("held").mkdir(parents=True, exist_ok=True)     # unreadable: set aside, never asked again and again
        shutil.move(str(path), str(folder("held") / path.name))
        return path.stem
    sh, model = shape("ask"), replies.load_yaml(MODEL_YML) or {}
    seed = seed_of(q["nonce"])
    got = complete(sh, messages_for(sh, q["messages"]), seed, model, send)
    question = q["messages"][-1]["content"]
    out = {"schema": "fcpm.answer/v0", "in_reply_to": q["nonce"], "shape": sh.get("shape"),
           "label": label(question, seed, model, send), "answer": got["text"], "effort": got["effort"],
           "finish": got["finish"], "tokens": got["tokens"], "model": model.get("model"),
           "model_sha256": (model.get("sha256") or "")[:12], "seed": seed,
           "asked": q.get("issued"), "answered": replies.now().isoformat(timespec="seconds"),
           "by": q.get("by"), "trust": q.get("trust")}
    folder("answers").mkdir(parents=True, exist_ok=True)
    (folder("answers") / ("%s.json" % q["nonce"])).write_text(json.dumps(out, ensure_ascii=False), encoding="utf-8")
    folder("done").mkdir(parents=True, exist_ok=True)
    shutil.move(str(path), str(folder("done") / path.name))
    replies.log({"name": path.stem, "verdict": "answered", "why": out["label"], "wizard": "wizard:model+ask",
                 "by": q.get("by")})
    reindex()
    return q["nonce"]


# ---- the public loop: each answer bottled, and the index of them --------------------------------------

def pour(kind, text):
    """An unsigned transfer as AC1 frames (pour.mjs, Node): {id, K, frames}; None without Node."""
    node = replies.node_exe()
    if not node:
        return None
    import subprocess
    out = subprocess.run([node, str(POUR), str(COMPOSER)], capture_output=True, text=True, timeout=60,
                         input=json.dumps({"kind": kind, "text": text, "blockSize": DROPLET}))
    return json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else None


def bottle(nonce):
    """asks/answers/<nonce>.json as its public bottle, asks/bottles/<nonce>.json. True when made."""
    a = json.loads((folder("answers") / ("%s.json" % nonce)).read_text(encoding="utf-8"))
    public = {k: a.get(k) for k in PUBLIC if k in a}
    got = pour("fcpm.answer", json.dumps(public, ensure_ascii=False, separators=(",", ":")))
    if not got:
        return False
    got.update({"in_reply_to": nonce, "label": a.get("label"), "answered": a.get("answered")})
    folder("bottles").mkdir(parents=True, exist_ok=True)
    (folder("bottles") / ("%s.json" % nonce)).write_text(json.dumps(got), encoding="utf-8")
    return True


def reindex():
    """The index bottle: the last day's answers (newest first, at most LOOP_MOST), each by nonce, label and
    bottle id. Any answer still without a bottle is bottled first. Returns the index, or None without Node."""
    answers = sorted(folder("answers").glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True) \
        if folder("answers").is_dir() else []
    since = replies.now() - datetime.timedelta(days=LOOP_DAYS)
    rows = []
    for p in answers:
        if len(rows) >= LOOP_MOST:
            break
        try:
            a = json.loads(p.read_text(encoding="utf-8"))
            if datetime.datetime.fromisoformat(a["answered"]) < since:
                break
            b = folder("bottles") / p.name
            if not b.is_file() and not bottle(a["in_reply_to"]):
                continue
            rows.append({"in_reply_to": a["in_reply_to"], "label": a.get("label"),
                         "id": json.loads(b.read_text(encoding="utf-8"))["id"], "answered": a["answered"]})
        except (OSError, ValueError, KeyError):
            continue
    index = {"schema": "fcpm.index/v0", "at": replies.now().isoformat(timespec="seconds"), "answers": rows}
    got = pour("fcpm.index", json.dumps(index, ensure_ascii=False, separators=(",", ":")))
    if not got:
        return None
    got["index"] = index
    folder("bottles").mkdir(parents=True, exist_ok=True)
    (folder("bottles") / "index.json").write_text(json.dumps(got), encoding="utf-8")
    return index


def status():
    waiting = sorted(folder("queue").glob("*.json")) if folder("queue").is_dir() else []
    print("waiting: %d" % len(waiting))
    done = sorted(folder("answers").glob("*.json"), key=lambda p: p.stat().st_mtime) if folder("answers").is_dir() else []
    print("answered: %d" % len(done))
    for p in done[-5:]:
        a = json.loads(p.read_text(encoding="utf-8"))
        print("  %s  %s  [%s]  %s" % (a.get("answered"), a["in_reply_to"][:12], a.get("label") or "",
                                     " ".join((a.get("answer") or "").split())[:80]))


def main(argv):
    verb = argv[1] if len(argv) > 1 else "keep"
    if verb == "status":
        status()
        return 0
    if verb == "once":
        try:
            n = answer_one()
        except (urllib.error.URLError, OSError) as e:
            print("asks: the model did not answer (%s); the question waits" % e, file=sys.stderr)
            return 1
        print("asks: %s" % (("answered " + n) if n else "nothing waiting"))
        return 0
    if verb == "reindex":
        index = reindex()
        print("asks: %s" % ("index of %d" % len(index["answers"]) if index else "no Node, no bottles"))
        return 0
    if verb != "keep":
        print(__doc__, file=sys.stderr)
        return 2
    reindex()
    while True:
        try:
            n = answer_one()
        except (urllib.error.URLError, OSError) as e:
            print("asks: the model did not answer (%s); asking again in %ds" % (e, ASLEEP), flush=True)
            time.sleep(ASLEEP)
            continue
        if n:
            print("asks: answered %s" % n, flush=True)
        else:
            time.sleep(IDLE)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
