#!/bin/sh
# at-login -- what digitization's desktop starts (fcpm-digitization.desktop, in /etc/xdg/autostart):
# the door on port 80, kept up, then its page in Vivaldi. In the desktop, so the door can ask on
# this screen and reach this session's ssh-agent. See PROFILE.md.
cd "$(dirname "$0")/../.." || exit 1
up() { curl -fsS -o /dev/null http://localhost/revision; }
if ! up; then
  ( while :; do FCPM_DOOR_PORT=80 python3 machines/kiosk/door.py serve; sleep 5; done ) &
  for _ in $(seq 60); do up && break; sleep 1; done
fi
exec vivaldi --app=http://localhost/
