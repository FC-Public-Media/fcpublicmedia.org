#!/bin/sh
# deploy-site-worker live -- deploys the site-worker (../../site-worker) by hand from this checkout, then gives it the Stripe key.
# Keys come from the keychain (keys.yml): cloudflare and stripe-live. The Stripe key reaches wrangler on
# stdin, never as an argument or in a log. Every run sets it again, so a rotation lands. See PROFILE.md, Keys.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
WORKER=$HERE/../../site-worker
case "${1:-}" in
  live) ;;
  test)
    echo "deploy-site-worker: no test site-worker in site-worker/wrangler.jsonc yet; its KV namespace is made with the" >&2
    echo "Cloudflare token. Try the test key here: keys run stripe-test -- node site-worker/try-checkout.mjs" >&2
    exit 2 ;;
  *) echo "usage: deploy-site-worker live" >&2; exit 2 ;;
esac
command -v npx >/dev/null || { echo "deploy-site-worker: no npx here: sudo apt-get install npm (gear.yml)" >&2; exit 2; }
cd "$WORKER"
node --test test/*.test.mjs
exec python3 -I "$HERE/keys" run cloudflare stripe-live -- sh -c '
  npx --yes wrangler deploy &&
  printf "%s" "$PUBLIC_STRIPE_API_KEY" | npx --yes wrangler secret put PUBLIC_STRIPE_API_KEY'
