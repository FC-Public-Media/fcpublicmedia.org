#!/bin/sh
# follow -- the canonical checkout follows this machine's origin: main only, fast-forward only, never
# over local changes. Every 5 minutes from the crew's `follow` line. The origin is on this machine,
# so it costs GitHub nothing: `fcpm dev` paces what reaches the origin, this places it. The door
# restarts itself when its checkout moves.
# Troves are submodules (`update = none`): each is checked out at the pin, as bin/refs and the
# kiosk's door do, so a crew line `from troves/<name>` has its code; a pin already there costs nothing.
cd "$(dirname "$0")/../.." || exit 1
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
[ -z "$(git status --porcelain --ignore-submodules=all)" ] || exit 0
git fetch -q origin main && git merge -q --ff-only origin/main
GIT_TERMINAL_PROMPT=0 git submodule update -q --init --checkout -- troves
# The Wix copy (the static job's `wix` site) is taken from this origin, where it lives first.
o=${FCPM_ORIGIN:-/srv/origin}/FC-Public-Media/wix
[ -d "$o" ] && git config submodule.wix.url "$o"
GIT_TERMINAL_PROMPT=0 git -c protocol.file.allow=always submodule update -q --init --checkout -- wix
