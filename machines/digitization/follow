#!/bin/sh
# follow -- the canonical checkout follows FCPM's origin (origin.local, ../origin): main only,
# fast-forward only, never over local changes. Every 5 minutes from the crew's `follow` line. It
# costs GitHub nothing: the origin's intake, paced by the LAN's dev switch, brings GitHub in; this
# places it. The checkout's `origin`, every submodule (troves, engines, the Wix copy) and their
# pushes all point at the origin, by its git account (FCPM_ORIGIN_URL; ~/.ssh/config's
# origin-standby: git@origin.local by this machine's key, in ../origin/KEYHOLDERS). The door
# restarts itself when its checkout moves.
# Troves are submodules (`update = none`): each is checked out at the pin, as bin/refs and the
# kiosk's door do, so a crew line `from troves/<name>` has its code; a pin already there costs nothing.
# When the checkout moved, the static job's sites are published from it (../static/publish.py): the
# only time the site is built here.
cd "$(dirname "$0")/../.." || exit 1
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
[ -z "$(git status --porcelain --ignore-submodules=all)" ] || exit 0
O=${FCPM_ORIGIN_URL:-origin-standby:/srv/origin}
git remote set-url origin "$O/FC-Public-Media/fcpublicmedia.org"
# Each submodule from the origin too: GitHub's owner/repo is the origin's path.
git config -f .gitmodules --get-regexp '^submodule\..*\.url$' | while read -r key url; do
  path=$(printf '%s' "$url" | sed -n 's|^https://\([^@/]*@\)\{0,1\}github\.com/\([^/]*/[^/]*\)$|\2|p' | sed 's|\.git$||')
  [ -n "$path" ] && git config "$key" "$O/$path"
done
was=$(git rev-parse HEAD)
git fetch -q origin main && git merge -q --ff-only origin/main
GIT_TERMINAL_PROMPT=0 git submodule update -q --init --checkout -- troves
# The Wix copy (the static job's `wix` site), from the origin like the rest.
GIT_TERMINAL_PROMPT=0 git submodule update -q --init --checkout -- wix
[ "$(git rev-parse HEAD)" = "$was" ] || python3 -I machines/static/publish.py
