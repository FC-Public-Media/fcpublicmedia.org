#!/bin/sh
# follow -- the canonical checkout follows FCPM's origin (origin.local, ../origin): main only,
# fast-forward only, never over local changes. `follow heed` is the crew's `follow` line: a pass, then
# it waits on the origin's `hear main` and passes again the moment any repository's main moves there
# (a push, or intake bringing GitHub's in), or after five minutes of quiet. It costs GitHub nothing. The checkout's `origin`, every submodule (troves, engines, the Wix copy) and their
# pushes all point at the origin, by its git account (FCPM_ORIGIN_URL; ~/.ssh/config's
# fcpm-origin: git@origin.local by this machine's key, in ../origin/KEYHOLDERS). The door
# restarts itself when its checkout moves.
# Troves are submodules (`update = none`): each is checked out at the pin, as bin/refs and the
# kiosk's door do, so a crew line `from troves/<name>` has its code; a pin already there costs nothing.
# Then the static job's sites, each built only when its own commit moved (../static/publish.py).
if [ "${1:-}" = heed ]; then
  # Listening starts before each pass, so a move during the pass is heard: the wait then ends at once.
  me="$(cd "$(dirname "$0")" && pwd)/follow"
  while :; do
    timeout 330 ssh -o BatchMode=yes -o ConnectTimeout=20 "${FCPM_ORIGIN_HOST:-fcpm-origin}" hear main >/dev/null 2>&1 &
    heard=$!
    /bin/sh "$me" || echo "follow: the pass failed ($?)"
    wait "$heard" || sleep 270         # the origin out of reach or not hearing: every five minutes, as before
  done
fi
cd "$(dirname "$0")/../.." || exit 1
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
[ -z "$(git status --porcelain --ignore-submodules=all)" ] || exit 0
O=${FCPM_ORIGIN_URL:-fcpm-origin:/srv/origin}
git remote set-url origin "$O/FC-Public-Media/fcpublicmedia.org"
# Each submodule from the origin too: GitHub's owner/repo is the origin's path.
git config -f .gitmodules --get-regexp '^submodule\..*\.url$' | while read -r key url; do
  path=$(printf '%s' "$url" | sed -n 's|^https://\([^@/]*@\)\{0,1\}github\.com/\([^/]*/[^/]*\)$|\2|p' | sed 's|\.git$||')
  [ -n "$path" ] && git config "$key" "$O/$path"
done
# And each checked-out submodule's own `origin`, which is what `submodule update` fetches through: one cloned
# before the origin moved (the Wix copy, from this machine's old /srv/origin) or from GitHub (the troves)
# would otherwise keep asking there, and a pin only the origin has could never be checked out.
git config --get-regexp '^submodule\..*\.url$' | while read -r key url; do
  p=$(git config -f .gitmodules --get "${key%.url}.path") || continue
  [ -e "$p/.git" ] && git -C "$p" remote set-url origin "$url"
done
git fetch -q origin main && git merge -q --ff-only origin/main
GIT_TERMINAL_PROMPT=0 git submodule update -q --init --checkout -- troves
# The Wix copy (the static job's `wix` site), from the origin like the rest.
GIT_TERMINAL_PROMPT=0 git submodule update -q --init --checkout -- wix
# The site-worker's checkout beside this one (../site-worker), for the drain line: its own repository,
# not a submodule, kept the same way: the origin's main, fast-forward only, never over local changes.
SW=../site-worker
if [ ! -e "$SW" ]; then
  GIT_TERMINAL_PROMPT=0 git clone -q "$O/FC-Public-Media/site-worker" "$SW"
elif [ "$(git -C "$SW" rev-parse --abbrev-ref HEAD)" = main ] && [ -z "$(git -C "$SW" status --porcelain)" ]; then
  git -C "$SW" remote set-url origin "$O/FC-Public-Media/site-worker"
  GIT_TERMINAL_PROMPT=0 git -C "$SW" fetch -q origin main && git -C "$SW" merge -q --ff-only origin/main
fi
# The static job's sites: each that moved is built or exported and pushed (../static/publish.py). An
# exported one moves on its own repository, so this asks every pass; one that did not
# move costs a fetch from the origin and nothing more.
python3 -I machines/static/publish.py
