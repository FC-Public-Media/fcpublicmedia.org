#!/usr/bin/env python3
"""rest -- this screen never powers down. Left alone REST_AFTER, it shows the mark full screen
(brand/idle, read from the checkout, so it needs no door); the first touch takes it away.
Started by at-login, in the desktop. See PROFILE.md.

  rest            keep the display on, and rest when nobody is here
  rest --now      rest at once (the first touch still ends it)"""
import fcntl, json, os, pathlib, shutil, signal, subprocess, sys, time

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "machines" / "kiosk"))
from door import idle_seconds  # noqa: E402  the desktop's idle clock (libXss)

REST_AFTER = 600
PAGE = (ROOT / "brand" / "idle" / "index.html").as_uri()
PROFILE = pathlib.Path.home() / ".config" / "fcpm-rest"   # Firefox's, its own: Vivaldi's --kiosk
BROWSER = ["firefox-esr", "--kiosk", "--no-remote", "--profile", str(PROFILE), PAGE]   # sets up first
QUIET = {"browser.aboutwelcome.enabled": False, "browser.startup.homepage_override.mstone": "ignore",
         "startup.homepage_welcome_url": "", "browser.shell.checkDefaultBrowser": False,
         "datareporting.policy.dataSubmissionPolicyBypassNotification": True,
         "toolkit.telemetry.reportingpolicy.firstRun": False, "browser.sessionstore.resume_from_crash": False,
         "browser.startup.page": 0, "app.update.enabled": False}


def stay_on():
    """No blanking and no power-down: X's own, and XFCE's power manager, which would set it again."""
    subprocess.run(["xset", "s", "off", "s", "noblank", "-dpms"])
    if shutil.which("xfconf-query"):
        for key, kind, value in (("dpms-enabled", "bool", "false"), ("blank-on-ac", "int", "0"),
                                 ("dpms-on-ac-sleep", "int", "0"), ("dpms-on-ac-off", "int", "0")):
            subprocess.run(["xfconf-query", "-c", "xfce4-power-manager", "-p", "/xfce4-power-manager/" + key,
                            "-n", "-t", kind, "-s", value], stderr=subprocess.DEVNULL)


def show():
    PROFILE.mkdir(parents=True, exist_ok=True)
    (PROFILE / "user.js").write_text("".join('user_pref("%s", %s);\n' % (k, json.dumps(v)) for k, v in QUIET.items()))
    return subprocess.Popen(BROWSER, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True)


def hide(p):
    try:
        os.killpg(p.pid, signal.SIGTERM)
        p.wait(10)
    except (OSError, subprocess.TimeoutExpired):
        os.killpg(p.pid, signal.SIGKILL)


lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "fcpm-rest.lock"), "w")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)                                         # already resting this screen
stay_on()
shown, since = None, time.time()
if "--now" in sys.argv:
    shown, since = show(), time.time()
while True:
    time.sleep(1)
    idle = idle_seconds()
    if idle is None:
        continue
    if shown is None and idle >= REST_AFTER:
        shown, since = show(), time.time()
    elif shown is not None and (shown.poll() is not None or idle < time.time() - since - 1):
        hide(shown)                                     # touched since it came up, or closed
        shown = None
        stay_on()                                       # a login or a settings change may have undone it
