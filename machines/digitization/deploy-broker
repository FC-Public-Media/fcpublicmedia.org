#!/bin/sh
# deploy-broker live -- deploys the broker Worker by hand from this checkout, then gives it the Stripe key.
# Keys come from the keychain (keys.yml): cloudflare and stripe-live. The Stripe key reaches wrangler on
# stdin, never as an argument or in a log. Every run sets it again, so a rotation lands. See PROFILE.md, Keys.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
WORKER=$HERE/../../worker
case "${1:-}" in
  live) ;;
  test)
    echo "deploy-broker: there is no test broker in worker/wrangler.jsonc yet; its KV namespace is made with" >&2
    echo "the Cloudflare token. Try the test key here instead: keys run stripe-test -- node worker/try-checkout.mjs" >&2
    exit 2 ;;
  *) echo "usage: deploy-broker live" >&2; exit 2 ;;
esac
cd "$WORKER"
npm test
exec python3 -I "$HERE/keys" run cloudflare stripe-live -- sh -c '
  npx --yes wrangler deploy &&
  printf "%s" "$PUBLIC_STRIPE_API_KEY" | npx --yes wrangler secret put PUBLIC_STRIPE_API_KEY'
