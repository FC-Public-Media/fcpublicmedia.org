# MANIFEST: what editing bay 1 carries of its own home, for `../sync`. See docs/station.md.
#   mode    repo path (relative to this folder)   home path (relative to ~)

# The root names itself: CLAUDE.md -> AGENTS.md -> BAY1.md, which ends at the profile's code/AGENTS.md.
mirror  home/code/CLAUDE.md    code/CLAUDE.md
mirror  home/code/AGENTS.md    code/AGENTS.md
mirror  home/code/BAY1.md      code/BAY1.md
mirror  code/bin/refs          code/bin/refs
mirror  code/bin/pool.ps1      code/bin/pool.ps1
mirror  code/refs.wanted       code/refs.wanted

clone   code/refs.wanted       code/refs

mirror  home/git/ignore        .config/git/ignore

mirror    home/bin/fcpm.cmd      .local/bin/fcpm.cmd
path      -                      .local/bin

settings  production             code/.claude/settings.json

# The hosts file, held: what this bay's names say (PROFILE.md, Hosts). An administrator's, so last.
system    hosts.ps1              -
