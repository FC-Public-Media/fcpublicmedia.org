#!/bin/sh
# install -- the origin job onto a box, run from any checkout whose keys manage it (today digitization's).
#
#   machines/origin/install root@HOST DISK SERIAL   HOST runs Alpine's live system (the recovery stick:
#                                                  root, network, sshd, our keys). ERASES DISK, installs
#                                                  Alpine there, outfits it, and powers HOST off.
#   machines/origin/install fcpm@HOST              outfit an origin that is already running. No disk.
#
# Any box that boots Alpine will do. DISK is named and must answer to SERIAL ("none" if it reports
# none), so the wrong disk is never the one erased; the rest is ./outfit. The box paints its own
# screen and runs its own intake; GitHub is asked as whoever ./github-login signs in. For a new
# install this machine pins the box's host key for NAME.local. Settings, with what they default to:
#   FCPM_KEYS  ~/.ssh/id_ed25519.pub        who manages it (fcpm, sudo)
# Who may push, fetch and flip dev is ./KEYHOLDERS, through ./door; the box rereads it from main.
#   ROOM_TZ    America/Denver               the room's clock
# NAME comes from ./names. See PROFILE.md.
set -eu
cd "$(dirname "$0")/../.."
REPO=$(pwd -P)
TARGET=${1:?root@HOST DISK SERIAL, or fcpm@HOST}
NAME=$(awk '$1=="linux" && $2=="Hostname" {print $3}' machines/origin/names)
FCPM_KEYS=${FCPM_KEYS:-$(cat ~/.ssh/id_ed25519.pub)}
ROOM_TZ=${ROOM_TZ:-America/Denver}
for v in "$FCPM_KEYS" "$ROOM_TZ"; do
  case $v in *\'*) echo "A setting holds a quote. Stopping."; exit 1;; esac
done

T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
mkdir "$T/fcpm-origin"
cp machines/leash.py machines/console-font.py machines/origin/facts.py machines/origin/page.py \
  machines/origin/intake machines/origin/run-intake machines/origin/door machines/origin/KEYHOLDERS \
  machines/origin/outfit "$T/fcpm-origin/"
cp -r machines/origin/door-hooks "$T/fcpm-origin/"
cat > "$T/fcpm-origin/settings" <<S
FCPM_KEYS='$FCPM_KEYS'
NAME='$NAME'
ROOM_TZ='$ROOM_TZ'
S
unpack='rm -rf /tmp/fcpm-origin && tar -xf - -C /tmp'

if [ $# -eq 3 ]; then
  out=$(tar -C "$T" -cf - fcpm-origin | ssh -o BatchMode=yes "$TARGET" \
    "$unpack && sh /tmp/fcpm-origin/outfit '$2' '$3'" | tee /dev/stderr)
  hostkey=$(printf '%s\n' "$out" | sed -n 's/^HOST-KEY: //p')
  [ -n "$hostkey" ] || { echo "No host key came back; the install did not finish."; exit 1; }
  ssh-keygen -R "$NAME.local" >/dev/null 2>&1 || true
  echo "$NAME.local $hostkey" >> ~/.ssh/known_hosts
  ssh -o BatchMode=yes "$TARGET" poweroff || true
  echo "Powered off. Take the installer out, then power it on."
else
  out=$(tar -C "$T" -cf - fcpm-origin | ssh -o BatchMode=yes "$TARGET" \
    "$unpack && sudo NOW=1 sh /tmp/fcpm-origin/outfit; rm -rf /tmp/fcpm-origin" | tee /dev/stderr)
fi

printf '%s\n' "$out" | grep -q '^OUTFITTED: ' || { echo "The outfit did not finish."; exit 1; }
# The box paints its own screen now: the grant this machine once held for it goes.
if [ -f ~/.ssh/authorized_keys ] && grep -q 'machines/origin/page.py' ~/.ssh/authorized_keys; then
  grep -v 'machines/origin/page.py' ~/.ssh/authorized_keys > "$T/ak" || true
  cat "$T/ak" > ~/.ssh/authorized_keys
  echo "The old screen grant for $NAME.local is gone from ~/.ssh/authorized_keys."
fi
echo "$NAME.local: outfitted from $REPO at $(git rev-parse --short HEAD)."
