#!/bin/sh
# pre-receive -- the origin door's rules about refs (../door). main takes a keyholder's fast-forward in
# every repository (the repositories refuse rewriting); in one that lives on GitHub, github/* is intake's,
# and relay carries main out. In every repository the LAN's lines are kept by ./lines-gate:
# retain/lines (each machine its own folder) and retain/pile/* (piles).
HOOKS=$(cd "$(dirname "$0")" && pwd)
status=0
while read -r old new ref; do
  case "$ref" in
    refs/heads/github/*)
      if [ -n "$FCPM_DOOR_GITHUB" ]; then
        echo "origin: $ref of $FCPM_DOOR_REPO is GitHub's main as intake last saw it; push main instead."
        status=1
      fi ;;
    refs/heads/retain/lines|refs/heads/retain/pile/*)
      python3 -I "$HOOKS/lines-gate" "$old" "$new" "$ref" || status=1 ;;
  esac
done
exit $status
