#!/usr/bin/python3
"""intake: the origin's beat, on the origin's own box: one pass in each ten minutes of the clock
(:00, :10, :20). Every beat tidies what is here; GitHub is asked on the beat while the LAN's dev is
on, and weekly while off, when the beat goes on without it.

    intake            a pass, if this ten minutes has not had one
    intake --now      a pass now, GitHub asked, whatever the pace
    intake --status   print the last state, change nothing

Only main is fetched, into github/main. A failure in one repo is recorded and the next goes on.
How GitHub's main is ahead of ours is read before it is taken (commits, files, bytes, the largest
file, pins moved) and kept with the take in actions.ndjson.
A repository new on GitHub under an owner the origin keeps (KEEP, by name) gets its bare repository
here first, then comes in like the rest; other owners' repositories are only the ones already here.
The LAN's dev is the file .intake/dev beside the state (`ssh git@origin.local dev on|off`).

Main is ours: keyholders push it here, and GitHub's main is merged into it (fast-forward, or a clean
merge; a conflict is recorded and main left alone).

Relay (.intake/relay, `relay on|off`): on, the origin is a full relay. On the same pass it carries out
to GitHub main wherever ours is ahead of GitHub's, and each branch and tag a keyholder pushed through
the door since the last pass (the door's log says which): fast-forward only, never forced, never
github/*, never a repository that began here, and never the library's branches (LAN_ONLY), which are
the LAN's in every repository. One GitHub will not fast-forward (a rebase) is recorded as diverged and left for a
person. Only what was pushed through the door is ever carried, so a branch GitHub merged and
deleted is not brought back. Off, the origin is LAN-only: it pulls, and what is pushed waits here.

Orders (every beat, before landed): each branch a keyholder ordered to land (the door's `land`, traffic.py)
is merged into main in the order given, by main's own .gitattributes; one that collides, or moved after it was
ordered, is said so and main is left alone.

Kept (every beat, after the orders): each branch machines/origin/KEPT names, as BOOK's main has it, takes in
main: a fast-forward when it holds nothing of its own, else a clean merge by its own .gitattributes; one that
collides is said so and left alone. Landed never lets a kept branch go.

Landed (every beat): a branch whose work main already has is let go, its record kept first on
retain/origin (branches/<owner>/<repo>/<branch>/origin.scopes), in a repository that lives on GitHub
too. Never main, github/*, the library's branches, one sitting on main's own commit, or one in a
repository that began here.
Runs as the git account, by cron (run-intake). Stdlib, git and gh, logged in as that account. See PROFILE.md.
"""
import datetime
import fcntl
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import traffic  # noqa: E402  the orders, landed here each beat (traffic.py beside this)

ORIGIN = os.environ.get("FCPM_ORIGIN", "/srv/origin")
STATE_DIR = os.path.join(ORIGIN, ".intake")
STATE = os.path.join(STATE_DIR, "state.json")
ACTIONS = os.path.join(STATE_DIR, "actions.ndjson")
CRED = ["-c", "credential.helper=!gh auth git-credential"]
WHO = ["-c", "user.name=FCPM origin", "-c", "user.email=origin@%s.local" % os.uname().nodename.split(".")[0]]
DEV = os.environ.get("FCPM_DEV") or os.path.join(STATE_DIR, "dev")
RELAY = os.path.join(STATE_DIR, "relay")
DOOR_LOG = os.path.join(ORIGIN, ".door", "actions.ndjson")
CARRY = os.path.join(STATE_DIR, "carry.json")
# Owners whose repositories the origin keeps, found by themselves (a prefix narrows one): every one of
# FC-Public-Media's. FCCN-ANTIBODY's are only the ones FCPM calls on.
KEEP = {"FC-Public-Media": ""}


def kept(full):
    """Whether the origin keeps owner/repo: by KEEP's prefix for an owner there, else what is here."""
    owner, name = full.split("/", 1)
    return owner not in KEEP or name.startswith(KEEP[owner])
# The library's branches, in any repository: kept on the LAN and never carried to GitHub, whatever
# relay says (Autumn, 2026-11-16: library content leaves GitHub outright, and the origin is the gate).
# Each is a branch and everything under it: `retain` covers retain/production and the rest.
LAN_ONLY = ("retain", "library", "librarians")


def lan_only(r):
    """Whether a ref is one of the library's branches, which stay here."""
    if not r.startswith("refs/heads/"):
        return False
    name = r[len("refs/heads/"):]
    return any(name == b or name.startswith(b + "/") for b in LAN_ONLY)


WEEK = datetime.timedelta(days=7)
BEAT = 600                              # seconds: a pass in each ten minutes of the clock
# The origin's own record: retain/origin in this repository, the LAN's like every retain/ branch.
BOOK = os.environ.get("FCPM_ORIGIN_BOOK") or "FC-Public-Media/fcpublicmedia.org"
RECORD = "refs/heads/retain/origin"
KEPT = "machines/origin/KEPT"
README = """# retain/origin

The origin's own record: what it did by itself, kept as it happens. Retained: the LAN's, never carried
to GitHub. `machines/origin/intake` in fcpublicmedia.org writes it; see `machines/origin/PROFILE.md` there.

    branches/<owner>/<repo>/<branch>/origin.scopes    a branch main took in and the origin let go: its
                                                      name, its last commit, how and when it landed
                                                      (a branch's slash is a ~ in the folder's name)
"""


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def git(repo, *args, check=True, timeout=120, input=None, env=None):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True,
                          check=check, timeout=timeout, input=input, env=env)


def ref(repo, name):
    r = git(repo, "rev-parse", "--verify", "-q", name, check=False)
    return r.stdout.strip() or None


def is_ancestor(repo, a, b):
    return git(repo, "merge-base", "--is-ancestor", a, b, check=False).returncode == 0


def repos():
    """owner/repo for every bare repo here, with a github remote or not (see adopt)."""
    out = []
    for owner in sorted(os.listdir(ORIGIN)):
        d = os.path.join(ORIGIN, owner)
        if owner.startswith(".") or owner == "lost+found" or not os.path.isdir(d):
            continue
        for name in sorted(os.listdir(d)):
            p = os.path.join(d, name)
            if os.path.isfile(os.path.join(p, "HEAD")):
                out.append(owner + "/" + name)
    return out


def adopt(full):
    """A repository GitHub has but that came here without a github remote (made by `init` for a
    push) is given GitHub's by its path, main only. True if it has one now. One that GitHub does not
    have began here and stays ours alone (FC-Public-Media/broadcast)."""
    p = os.path.join(ORIGIN, full)
    if git(p, "config", "remote.github.url", check=False).stdout.strip():
        return True
    git(p, "config", "remote.github.url", "https://github.com/%s.git" % full)
    git(p, "config", "remote.github.fetch", "+refs/heads/main:refs/heads/github/main")
    return True


def github_mains(names):
    """{owner/repo: sha of GitHub's main}, in one query. Missing on any error."""
    parts = []
    for i, full in enumerate(names):
        owner, name = full.split("/", 1)
        parts.append('r%d: repository(owner: %s, name: %s) { ref(qualifiedName: "refs/heads/main") '
                     '{ target { oid } } }' % (i, json.dumps(owner), json.dumps(name)))
    q = "query { %s }" % " ".join(parts)
    r = subprocess.run(["gh", "api", "graphql", "-f", "query=" + q],
                       capture_output=True, text=True, timeout=60)
    data = json.loads(r.stdout or "{}").get("data") or {}
    out = {}
    for i, full in enumerate(names):
        node = data.get("r%d" % i) or {}
        oid = ((node.get("ref") or {}).get("target") or {}).get("oid")
        if oid:
            out[full] = oid
    return out


def discover(have):
    """owner/repo on GitHub that KEEP keeps and the origin lacks, made here as bare repositories."""
    q = "query { %s }" % " ".join(
        'o%d: repositoryOwner(login: %s) { repositories(first: 100, isFork: false) { nodes { name } } }'
        % (i, json.dumps(o)) for i, o in enumerate(KEEP))
    r = subprocess.run(["gh", "api", "graphql", "-f", "query=" + q], capture_output=True, text=True, timeout=60)
    data = json.loads(r.stdout or "{}").get("data") or {}
    made = []
    for i, owner in enumerate(KEEP):
        for node in ((data.get("o%d" % i) or {}).get("repositories") or {}).get("nodes") or []:
            full = "%s/%s" % (owner, node["name"])
            if full in have or not kept(full) or os.path.exists(os.path.join(ORIGIN, full)):
                continue
            p = os.path.join(ORIGIN, full)
            subprocess.run(["git", "init", "-q", "--bare", p], check=True)
            for k, v in (("receive.denyNonFastForwards", "true"), ("receive.denyDeletes", "true"),
                         ("remote.github.url", "https://github.com/%s.git" % full),
                         ("remote.github.fetch", "+refs/heads/main:refs/heads/github/main")):
                git(p, "config", k, v)
            made.append(full)
    return made


def reading(p, ours, theirs):
    """How theirs is ahead of ours, in numbers: commits, files, bytes, the largest file, pins moved."""
    span = "%s..%s" % (ours, theirs)
    out = {"commits": int(git(p, "rev-list", "--count", span).stdout.strip() or 0)}
    named = dict(l.split(" ", 1) for l in git(p, "rev-list", "--objects", span).stdout.splitlines() if " " in l)
    sized = git(p, "cat-file", "--batch-check", input="".join(sha + "\n" for sha in named)).stdout.splitlines()
    blobs = [(int(w[2]), w[0]) for w in (l.split() for l in sized) if w[1:2] == ["blob"]]
    out.update(files=len(blobs), bytes=sum(size for size, _ in blobs))
    if blobs:
        size, sha = max(blobs)
        out["largest"] = {"path": named[sha], "bytes": size}
    pins = []
    for l in git(p, "diff", "--raw", "--no-abbrev", "%s...%s" % (ours, theirs)).stdout.splitlines():
        meta, path = l.split("\t", 1)
        was, now_, old, new = meta.lstrip(":").split()[:4]
        if "160000" in (was, now_):
            pins.append({"path": path, "from": old, "to": new})
    if pins:
        out["pins"] = pins
    return out


def take(full, theirs_remote):
    """Bring one repo's origin main up to date with GitHub's. Returns its row."""
    p = os.path.join(ORIGIN, full)
    row = {"repo": full}
    if ref(p, "refs/heads/github/main") != theirs_remote:
        git(p, *CRED, "fetch", "-q", "github", "+refs/heads/main:refs/heads/github/main", timeout=180)
        row["fetched"] = True
    theirs = ref(p, "refs/heads/github/main")
    ours = ref(p, "refs/heads/main")
    row.update(github=theirs, main=ours)
    if ours and ours != theirs and not is_ancestor(p, theirs, ours):
        try:
            row["screen"] = reading(p, ours, theirs)
        except Exception as e:          # a reading that fails never holds the take
            row["screen"] = {"error": str(e)[-200:]}

    if ours is None:
        git(p, "update-ref", "refs/heads/main", theirs, "")
        row.update(state="seeded", main=theirs, did="main created from github/main")
    elif ours == theirs:
        row["state"] = "even"
    elif is_ancestor(p, ours, theirs):
        git(p, "update-ref", "refs/heads/main", theirs, ours)
        row.update(state="even", main=theirs, did="fast-forwarded to github/main")
    elif is_ancestor(p, theirs, ours):
        row["state"] = "ahead"          # ours has what GitHub has, and more
    else:
        # by our main's own .gitattributes, which a bare repository does not read by itself
        m = git(p, "--attr-source=" + ours, "merge-tree", "--write-tree", "--name-only", ours, theirs, check=False)
        if m.returncode == 0:
            tree = m.stdout.split("\n", 1)[0].strip()
            msg = "Merge GitHub's main into origin's main"
            commit = git(p, *WHO, "commit-tree", tree, "-p", ours, "-p", theirs, "-m", msg).stdout.strip()
            git(p, "update-ref", "refs/heads/main", commit, ours)
            row.update(state="ahead", main=commit, did="merged github/main cleanly")
        else:
            # after the tree: the conflicted paths, a blank line, then git's messages
            files = m.stdout.split("\n\n", 1)[0].splitlines()[1:]
            row.update(state="conflict", conflicts=files[:50],
                       did="github/main does not merge clean; main left alone")
    return row


def beat(at=None):
    """The ten minutes of the clock a moment is in, by its start."""
    at = time.time() if at is None else at
    return datetime.datetime.fromtimestamp(at - at % BEAT, datetime.timezone.utc).isoformat(timespec="seconds")


def last():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def due(was):
    """One pass in each ten minutes of the clock."""
    return "--now" in sys.argv or was.get("beat") != beat()


def asking(was):
    """Whether this beat asks GitHub: every beat while dev is on; off, weekly, and until it has answered."""
    if "--now" in sys.argv or os.path.exists(DEV) or was.get("github") != "ok":
        return True
    try:
        since = datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(was["checked"])
    except (KeyError, ValueError, TypeError):
        return True
    return since >= WEEK


def scope(*parts):
    """One flat line (../scopes.py): parts joined by dots, a dot inside a part doubled."""
    return ".".join(" ".join(str(p).split()).replace(".", "..") for p in parts)


def adds_nothing(p, tip, main):
    """Whether merging tip into main would change nothing: all it holds, main holds."""
    m = git(p, "merge-tree", "--write-tree", main, tip, check=False)
    return m.returncode == 0 and m.stdout.split("\n", 1)[0].strip() == ref(p, main + "^{tree}")


def brought(p, tip, main):
    """The merge that brought tip into main, followed down through a merge of GitHub's main to the one
    that names tip itself; None when tip is on main's own line (a fast-forward)."""
    by, at = None, main
    while True:
        span = "%s..%s" % (tip, at)
        path = set(git(p, "rev-list", "--ancestry-path", span).stdout.split())
        first = next((c for c in reversed(git(p, "rev-list", "--first-parent", span).stdout.split()) if c in path), None)
        parents = git(p, "rev-parse", first + "^@").stdout.split() if first else []
        if not parents or parents[0] == tip:
            return by
        by = first
        at = next((q for q in parents[1:] if q != tip and is_ancestor(p, tip, q)), None)
        if not at:
            return by


def record(p, full, name, tip, how, main, stamp):
    """A landed branch as flat lines: what it was, and how main came to hold it."""
    lines = [scope("branch", name), scope("repository", *full.split("/", 1)), scope("tip", tip), scope("landed", how)]
    by = brought(p, tip, main) if how == "merged" else None
    if by:
        when, said = git(p, "show", "-s", "--format=%cI%n%s", by).stdout.split("\n", 1)
        lines += [scope("landed", "by", by), scope("landed", "on", when)]
        pull = re.match(r"Merge pull request #(\d+) ", said)
        if pull:
            lines.append(scope("github", "pull", pull.group(1)))
    if by or how == "spent":            # its own commits: since the line it was merged into, or beyond main
        ahead = "%s^1..%s" % (by, tip) if by else "%s..%s" % (main, tip)
        lines.append(scope("commits", git(p, "rev-list", "--count", ahead).stdout.strip()))
    return "\n".join(lines + [scope("removed", stamp), scope("main", main)]) + "\n"


def keep(files, message):
    """One commit on the origin's own record (RECORD in BOOK): each file's lines, after what it already says."""
    book = os.path.join(ORIGIN, BOOK)
    old = ref(book, RECORD)
    index = os.path.join(STATE_DIR, "record.index")
    env = dict(os.environ, GIT_INDEX_FILE=index)
    if os.path.exists(index):
        os.remove(index)
    if old:
        git(book, "read-tree", old, env=env)
        files = {path: git(book, "cat-file", "-p", "%s:%s" % (old, path), check=False).stdout + text
                 for path, text in files.items()}
    else:
        files = {"README.md": README, **files}
    entries = ["100644 blob %s\t%s\n" % (git(book, "hash-object", "-w", "--stdin", input=text).stdout.strip(), path)
               for path, text in sorted(files.items())]
    git(book, "update-index", "--add", "--index-info", input="".join(entries), env=env)
    tree = git(book, "write-tree", env=env).stdout.strip()
    commit = git(book, *WHO, "commit-tree", tree, *(["-p", old] if old else []), "-m", message).stdout.strip()
    git(book, "update-ref", RECORD, commit, old or "")
    os.remove(index)


def keeping():
    """KEPT as BOOK's main has it: {(owner/repo, branch)}. Never main, github/* or the library's branches."""
    text = git(os.path.join(ORIGIN, BOOK), "show", "refs/heads/main:" + KEPT, check=False).stdout
    out = set()
    for line in text.splitlines():
        w = line.split("#", 1)[0].split()
        if len(w) == 2 and w[1] != "main" and not w[1].startswith("github/") and not lan_only("refs/heads/" + w[1]):
            out.add((w[0], w[1]))
    return out


def keep_up(pairs):
    """Each kept branch takes in its repository's main. Returns its rows."""
    rows = []
    for full, name in sorted(pairs):
        p, r = os.path.join(ORIGIN, full), "refs/heads/" + name
        row = {"repo": full, "ref": r}
        tip = ref(p, r) if os.path.isfile(os.path.join(p, "HEAD")) else None
        main = tip and ref(p, "refs/heads/main")
        if not main:
            row["state"] = "missing"
        elif is_ancestor(p, main, tip):
            row["state"] = "current"
        elif is_ancestor(p, tip, main):
            ok = git(p, "update-ref", r, main, tip, check=False).returncode == 0
            row.update(state="kept" if ok else "left", sha=main if ok else tip,
                       did="fast-forwarded to main" if ok else "it moved while this pass looked; left as it is")
        else:
            m = git(p, "--attr-source=" + tip, "merge-tree", "--write-tree", "--name-only", tip, main, check=False)
            if m.returncode == 0:
                tree = m.stdout.split("\n", 1)[0].strip()
                commit = git(p, *WHO, "commit-tree", tree, "-p", tip, "-p", main,
                             "-m", "Keep %s current: main merged in" % name).stdout.strip()
                ok = git(p, "update-ref", r, commit, tip, check=False).returncode == 0
                row.update(state="kept" if ok else "left", sha=commit if ok else tip,
                           did="main merged in cleanly" if ok else "it moved while this pass looked; left as it is")
            else:
                files = m.stdout.split("\n\n", 1)[0].splitlines()[1:]
                row.update(state="collides", sha=tip, conflicts=files[:50],
                           did="main does not merge in clean; the branch left alone")
        rows.append(row)
    return rows


def land(names, was, held=frozenset()):
    """Branches whose work main already holds, let go: each one's record kept first, then the branch
    removed. `was` is the open branches as last looked at, `held` the kept ones; returns (rows, the open branches now)."""
    if not os.path.isfile(os.path.join(ORIGIN, BOOK, "HEAD")):
        return [], was                  # nowhere to keep a record: nothing is removed
    going, still, stamp = [], {}, now()
    for full in names:
        p = os.path.join(ORIGIN, full)
        main = ref(p, "refs/heads/main")
        if not main or not git(p, "config", "remote.github.url", check=False).stdout.strip():
            continue                    # began here: its branches are its own
        heads = git(p, "for-each-ref", "--format=%(refname) %(objectname)", "refs/heads").stdout.splitlines()
        for r, tip in (l.split() for l in heads):
            name = r[len("refs/heads/"):]
            if name == "main" or name.startswith("github/") or lan_only(r) or (full, name) in held:
                continue
            looked = was.get(full, {}).get(name) == [tip, main]
            if tip != main and is_ancestor(p, tip, main):
                going.append((full, name, tip, "merged", main))
            elif tip != main and not looked and adds_nothing(p, tip, main):
                going.append((full, name, tip, "spent", main))
            else:
                still.setdefault(full, {})[name] = [tip, main]
    if not going:
        return [], still
    keep({"branches/%s/%s/origin.scopes" % (full, name.replace("/", "~")):
          record(os.path.join(ORIGIN, full), full, name, tip, how, main, stamp) for full, name, tip, how, main in going},
         "%d branch%s landed and let go" % (len(going), "" if len(going) == 1 else "es"))
    rows = []
    for full, name, tip, how, main in going:
        p = os.path.join(ORIGIN, full)
        row = {"repo": full, "ref": "refs/heads/" + name, "sha": tip, "how": how}
        held = how == "merged" or git(p, "update-ref", "refs/landed/" + name, tip, check=False).returncode == 0
        if held and git(p, "update-ref", "-d", "refs/heads/" + name, tip, check=False).returncode == 0:
            row.update(state="landed", did="main holds it (%s): the branch let go, its record on retain/origin" % how)
        else:
            row.update(state="left", did="it moved while this pass looked; left as it is")
            still.setdefault(full, {})[name] = [ref(p, "refs/heads/" + name), main]
        rows.append(row)
    return rows, still


def switched_on(size):
    """Where in the door's log relay was last switched on (just after that line), else its end."""
    at, pos = size, 0
    if os.path.exists(DOOR_LOG):
        with open(DOOR_LOG, "rb") as f:
            for line in f:
                pos += len(line)
                if b'"verb": "relay"' in line and b'"state": "on"' in line:
                    at = pos
    return at


def carry_main(names):
    """Main, out to GitHub in each repository where ours is ahead of GitHub's (relay on)."""
    rows = []
    for full in names:
        p = os.path.join(ORIGIN, full)
        ours, theirs = ref(p, "refs/heads/main"), ref(p, "refs/heads/github/main")
        if not ours or not theirs or ours == theirs or not is_ancestor(p, theirs, ours):
            continue
        out = git(p, *CRED, "push", "-q", "github", "%s:refs/heads/main" % ours, check=False, timeout=180)
        row = {"repo": full, "ref": "refs/heads/main", "sha": ours}
        if out.returncode == 0:
            git(p, "update-ref", "refs/heads/github/main", ours, theirs)
            row.update(state="carried", did="carried out to GitHub")
        elif "non-fast-forward" in out.stderr or "fetch first" in out.stderr:
            row.update(state="diverged", did="GitHub's main moved since this pass looked; merged on the next")
        else:
            row.update(state="error", error=out.stderr.strip()[-300:])
        rows.append(row)
    return rows


def carry():
    """Branches and tags pushed through the door since the last pass, out to GitHub (relay on)."""
    try:
        with open(CARRY) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    size = os.path.getsize(DOOR_LOG) if os.path.exists(DOOR_LOG) else 0
    if "offset" not in st:              # the first pass: from when relay was switched on; what was here before stays here
        st = {"offset": switched_on(size), "pending": []}
    pending = {tuple(p) for p in st.get("pending", [])}
    if os.path.exists(DOOR_LOG) and size >= st["offset"]:
        with open(DOOR_LOG) as f:
            f.seek(st["offset"])
            for line in f:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if row.get("verb") != "push" or not row.get("ok"):
                    continue
                for r, (_, after) in (row.get("moved") or {}).items():
                    if after and (r.startswith("refs/tags/") or (r.startswith("refs/heads/")
                                  and r != "refs/heads/main" and not r.startswith("refs/heads/github/"))):
                        pending.add((row["repo"], r))
        st["offset"] = size
    rows, left = [], []
    for full, r in sorted(pending):
        p = os.path.join(ORIGIN, full)
        if not git(p, "config", "remote.github.url", check=False).stdout.strip():
            continue                    # began here: it stays here
        if lan_only(r):
            rows.append({"repo": full, "ref": r, "state": "lan only", "did": "the library's: kept here, never carried"})
            continue
        sha = ref(p, r)
        if not sha:
            continue
        out = git(p, *CRED, "push", "-q", "github", "%s:%s" % (sha, r), check=False, timeout=180)
        row = {"repo": full, "ref": r, "sha": sha}
        if out.returncode == 0:
            row.update(state="carried", did="carried out to GitHub")
        elif "non-fast-forward" in out.stderr or "fetch first" in out.stderr:   # not a bare "rejected": GitHub's refusals say that too
            row.update(state="diverged", did="GitHub's %s does not fast-forward to ours; left for a person" % r)
        else:
            row.update(state="error", error=out.stderr.strip()[-300:])
            left.append([full, r])      # out of reach, or refused (a missing `workflow` scope): again next pass
        rows.append(row)
    st["pending"] = left
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CARRY + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, CARRY)
    return rows


def main():
    if not os.path.isdir(ORIGIN) or not any(not d.startswith(".") for d in os.listdir(ORIGIN)):
        return 0                        # nothing here (an unmounted disk): nothing to take into
    os.makedirs(STATE_DIR, exist_ok=True)
    if "--status" in sys.argv:
        print(open(STATE).read() if os.path.exists(STATE) else "no state yet")
        return 0
    was = last()
    if not due(was):
        return 0
    with open(os.path.join(STATE_DIR, "lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0                    # the last run is still going
        names = repos()
        rows = [{"repo": n, "state": "not kept", "main": ref(os.path.join(ORIGIN, n), "refs/heads/main")}
                for n in names if not kept(n)]     # here from before KEEP said otherwise: left as they are
        names = [n for n in names if kept(n)]
        ask, remote, offline = asking(was), {}, None
        if ask:
            try:
                names += discover(set(names))
            except Exception:
                pass                    # GitHub out of reach: the next asking beat asks again
            try:
                remote = github_mains(names)
            except Exception as e:      # offline, GitHub down: say so, change nothing
                offline = repr(e)
            else:
                offline = None if remote else "GitHub did not answer"
            for full in names:
                p = os.path.join(ORIGIN, full)
                if full not in remote:
                    ours = not git(p, "config", "remote.github.url", check=False).stdout.strip()
                    rows.append({"repo": full, "state": "here only" if ours and not offline else "unchecked",
                                 "main": ref(p, "refs/heads/main")})
                    continue
                adopt(full)
                try:
                    row = take(full, remote[full])
                except Exception as e:
                    row = {"repo": full, "state": "error", "error": str(e)[-500:]}
                rows.append(row)
        try:
            ordered = traffic.land(names, WHO)
        except Exception as e:          # an order that cannot be read or landed waits for the next beat
            ordered = [{"repo": "orders", "state": "error", "error": str(e)[-500:]}]
        try:
            held = keeping()
            kept_rows = keep_up(held)
        except Exception as e:          # KEPT unread: nothing is kept up this beat, and nothing kept is let go
            held, kept_rows = None, [{"repo": BOOK, "ref": KEPT, "state": "error", "error": str(e)[-500:]}]
        try:
            if held is None:
                raise RuntimeError("KEPT could not be read; nothing is let go this beat")
            landed, still = land(names, was.get("open") or {}, held)
        except Exception as e:          # the record could not be kept: nothing was removed
            landed, still = [{"repo": BOOK, "ref": RECORD, "state": "error", "error": str(e)[-500:]}], was.get("open") or {}
        carried = []
        if ask and os.path.exists(RELAY) and not offline:
            carried = carry_main([n for n in names if n in remote]) + carry()
        stamp = now()
        with open(ACTIONS, "a") as log:
            for row in rows + ordered + kept_rows + landed + carried:
                if row.get("did") or row["state"] == "error":
                    log.write(json.dumps({"at": stamp, **row}) + "\n")
        asked = {"checked": stamp, "github": "unreachable: " + offline if offline else "ok", "repos": rows}
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:       # a quiet beat keeps what GitHub last said
            json.dump({"beat": beat(), **(asked if ask else {k: was.get(k) for k in asked}),
                       "relay": os.path.exists(RELAY), "ordered": ordered, "kept": kept_rows, "carried": carried, "landed": landed,
                       "open": still}, f, indent=1)
        os.replace(tmp, STATE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
