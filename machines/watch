#!/bin/sh
# watch -- what `fcpm` alone does: show this machine's state, then offer install. Doc: docs/station.md, fcpm.

set -u
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/.." && pwd)

line() { printf '%-7s %s\n' "$1" "$2"; }
ps1() { f=$1; shift; powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$f" 2>/dev/null || echo "$f")" "$@"; }
ask() { printf '%s ' "$1"; read -r REPLY || REPLY=""; }

SYNC=$(SYNC_CHECK=0 "$HERE/sync" 2>&1)
profile=$(printf '%s\n' "$SYNC" | awk '$1 == "profile" { print $2; exit }')
called=""
[ -n "$profile" ] && [ -f "$HERE/$profile/called" ] && called=$(head -n 1 "$HERE/$profile/called" | tr -d '\r ')

if [ -z "$profile" ]; then
  line "--" "this machine (${COMPUTERNAME:-$(hostname)}) wears no FCPM profile. Nothing to watch."
  exit 0
fi
line ok "this is ${called:-$profile} (profile $profile, Windows name ${COMPUTERNAME:-?})"

behind=0
url=$(git -C "$REPO" remote get-url origin 2>/dev/null)
case "$url" in
  *github.com*) line NEEDS "this checkout still names GitHub: fcpm install brings it from the origin"; behind=1 ;;
  *)
    if git -C "$REPO" fetch -q origin main 2>/dev/null; then
      behind=$(git -C "$REPO" rev-list --count HEAD..origin/main)
      at="$(git -C "$REPO" log -1 --format="%h, %cr" 2>/dev/null)"
      if [ "$behind" -gt 0 ]; then line behind "this checkout ($REPO) is $behind change(s) behind the origin's main: fcpm install"
      else line ok "this checkout ($REPO) has the origin's main ($at)"; fi
    else
      line NEEDS "the origin did not answer ($url)"
    fi ;;
esac

differs=$(printf '%s\n' "$SYNC" | grep -cE '^(differs|stray)')
if [ "$differs" -gt 0 ]; then line update "$differs thing(s) placed from this checkout are out of date or no longer mapped: fcpm install"
else line ok "what is placed from this checkout matches it"; fi

if grep -qs '^held  *\.\./pool\.ps1' "$HERE/$profile/MANIFEST"; then
  s=$(ps1 "$HERE/pool.ps1" status 2>/dev/null | tr -d '\r' | awk '$1 == "server" { $1 = ""; print; exit }')
  case "$s" in
    *up*) line ok "the root's server is$s" ;;
    *"(off"*) line "--" "the root's server is off, as you set it (fcpm pool on starts it)" ;;
    '') line NEEDS "this computer's startup is out of date: Install the updates" ;;
    *) line NEEDS "the root's server is$s: fcpm pool on" ;;
  esac
fi
if [ -f "$REPO/troves/kiosk-screen/screen.ps1" ]; then
  s=$(ps1 "$REPO/troves/kiosk-screen/screen.ps1" status 2>/dev/null | tr -d '\r' | head -n 1 | sed 's/^screen *//')
  line "--" "screen: $s"
fi

echo
[ "$behind" -gt 0 ] || [ "$differs" -gt 0 ] || { echo "Nothing to do. All good."; exit 0; }
printf '  1  Bring in the latest and install it on this computer\n  q  quit\n\n'
[ -t 0 ] || exit 0
ask "Which? [1]"
case "$REPLY" in
  ''|1) exec "$HERE/fcpm" install ;;
  *) exit 0 ;;
esac
