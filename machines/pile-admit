#!/usr/bin/env python3
"""admit CHANNEL -- this pile's shape, played by the origin (lines-gate) for each entry its writer pushes,
from the pile as it stood before: admitted only if shape/hears names CHANNEL. Born with the pile and signed
in with it; the reader changes shape/hears, never this. Nothing named, nothing heard."""
import pathlib
import sys

hears = pathlib.Path("shape/hears")
heard = hears.read_text().split() if hears.exists() else []
said = sys.argv[1] if len(sys.argv) > 1 else "(none)"
sys.exit(0 if said in heard else f"hears {', '.join(heard) or 'nothing'}, not {said}")
