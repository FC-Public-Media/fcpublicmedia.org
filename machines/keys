#!/usr/bin/env python3
"""keys -- the keychain this machine holds for the jobs it wears: machines/<job>/keys.yml, for each job
this machine's name is in (machines/binding). Never prints a value. The same on Linux and Windows.

  keys                  each key: held or WANTED, and where it lives
  keys check            the same in `fcpm check`'s words; exit 1 if any is wanted
  keys take GROUP KEY   ask for one value in a window on this screen, check its prefix, store it
  keys offer GROUP DEVICE   ask for GROUP's wanted keys on a one-time page only DEVICE on the tailnet can open
  keys run GROUP [GROUP...] -- CMD...   run CMD with those groups' env keys in its environment, and the
                        folders of the job's gear called by `at:` (a bay's Node) first on its PATH
  keys birth            this machine's own key, made here once: the private half never leaves (on Windows,
                        it is held by the OpenSSH agent and no file keeps it); the public half is shown, as
                        text and as a QR code, and lodged once at this machine's helm, which passes it to
                        the keystore's for a board wizard to grant (docs/keystore.md, Birth)

FCPM_KEYS_LEDGER (one keys.yml) and FCPM_WEARS (a comma list of jobs) stand in for the binding in a test;
FCPM_BIRTH_FILE keeps a born key's private half in a file, as on Linux, so a test never touches the agent;
FCPM_BIRTH_HELM is the helm a test's petition is set down at.
"""
import datetime
import html
import http.server
import json
import os
import re
import secrets
import shutil
import time
import urllib.parse
import urllib.request
import pathlib
import platform
import subprocess
import sys
import tempfile

import yaml

HERE = pathlib.Path(__file__).resolve().parent
SHAPES = {"guid": re.compile(r"[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}"),
          "hex32": re.compile(r"[0-9a-f]{32}")}
WINDOWS = os.name == "nt"


def home(path):
    return pathlib.Path(os.path.expandvars(os.path.expanduser(path)))


def wears():
    """The jobs this machine wears: each profile's `names` against the host's own name."""
    if os.environ.get("FCPM_WEARS") is not None:
        return [j for j in os.environ["FCPM_WEARS"].split(",") if j]
    b = {"__name__": "binding", "__file__": str(HERE / "binding")}      # run as source: no __pycache__
    exec(compile((HERE / "binding").read_text(encoding="utf-8"), str(HERE / "binding"), "exec"), b)
    system = b["this_platform"]()
    fact = b["actual"](system) if system else None
    if not fact:
        return []
    return [p.name for p in b["profiles"]() if (b["declared"](p).get(system) or "").casefold() == fact.casefold()]


def ledgers():
    if os.environ.get("FCPM_KEYS_LEDGER"):
        return [pathlib.Path(os.environ["FCPM_KEYS_LEDGER"])]
    return [HERE / job / "keys.yml" for job in wears() if (HERE / job / "keys.yml").is_file()]


def load():
    """Every group of every ledger this machine holds; a group two jobs name is the first job's."""
    groups = {}
    for path in ledgers():
        ledger = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        for name, group in (ledger.get("groups") or {}).items():
            if name not in groups:
                group["path"] = home(group.get("file") or f"{ledger['dir']}/{name}.env")
                groups[name] = group
    return groups


def gear_folders():
    """The folder of each worn job's gear that is called by `at:`, never from PATH (a bay's Node). Read by
    line, as check.ps1 reads gear.yml: its prose is not always YAML."""
    out = []
    for job in wears():
        f = HERE / job / "gear.yml"
        for line in f.read_text(encoding="utf-8").splitlines() if f.is_file() else []:
            m = re.match(r'\s*at:\s*"?([^"#]+)"?', line)
            folder = pathlib.Path(os.path.expandvars(m.group(1).strip().replace("\\\\", "\\"))).parent if m else None
            if folder and folder.is_absolute() and folder.is_dir() and str(folder) not in out:
                out.append(str(folder))
    return out


def read(group):
    """{key: value} for what the group's file holds; {} when it does not exist."""
    path = group["path"]
    if not path.exists():
        return {}
    text = path.read_text(encoding="utf-8")
    if group["form"] == "raw":
        value = text.strip()
        return {next(iter(group["keys"])): value} if value else {}
    found = {}
    for line in text.splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            found[k.strip()] = v.strip()
    return found


def facts(groups):
    """(ok, what, fix) for every key in the ledger, and for each file's mode."""
    for name, group in groups.items():
        held = read(group)
        path = group["path"]
        for key, spec in group["keys"].items():
            value = held.get(key, "")
            prefix = spec.get("prefix", "")
            where = f"{name} {key}" + (f" ({prefix}…)" if prefix else "")
            if not value:
                yield False, f"key {where} in {short(path)}", f"keys take {name} {key}; get one from {spec['from']}"
            elif not fits(spec, value):
                yield False, f"key {where} in {short(path)} has the wrong kind", f"keys take {name} {key}"
            else:
                yield True, f"key {where} in {short(path)}", None
        if not WINDOWS and path.exists() and path.stat().st_mode & 0o077:
            yield False, f"key file {short(path)} readable only by its owner", f"chmod 600 {path}"


def fits(spec, value):
    shape = SHAPES.get(spec.get("shape"))
    return value.startswith(spec.get("prefix", "")) and (not shape or shape.fullmatch(value))


def short(path):
    text = str(path)
    return "~" + text[len(str(pathlib.Path.home())):] if text.startswith(str(pathlib.Path.home())) else text


def ask(title, text):
    """A hidden entry on this screen; None if the window was closed."""
    if WINDOWS:
        return ask_tk(title, text)
    env = dict(os.environ, DISPLAY=os.environ.get("DISPLAY", ":0"))
    done = subprocess.run(["zenity", "--entry", "--hide-text", "--width", "480", "--title", title, "--text", text],
                          capture_output=True, text=True, env=env)
    return done.stdout.strip() if done.returncode == 0 else None


def ask_tk(title, text):
    """Windows: the same hidden entry, by the Tk that uv's Python carries."""
    import tkinter
    from tkinter import simpledialog
    root = tkinter.Tk()
    root.withdraw()
    root.attributes("-topmost", True)
    value = simpledialog.askstring(title, text, show="*", parent=root)
    root.destroy()
    return value.strip() if value else None


def store(group, key, value):
    """Write the group's file with key set, atomically, mode 600, in a folder only its owner reads."""
    path = group["path"]
    path.parent.mkdir(parents=True, exist_ok=True)
    if not WINDOWS:                       # Windows: the profile folder is this account's alone
        os.chmod(path.parent, 0o700)
    if group["form"] == "raw":
        body = value + "\n"
    else:
        lines = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
        lines = [l for l in lines if l.split("=", 1)[0].strip() != key]
        lines.append(f"{key}={value}")
        body = "\n".join(lines) + "\n"
    temp = path.with_name(path.name + ".new")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as out:
        out.write(body)
    os.replace(temp, path)


def take(groups, name, key):
    group = groups.get(name)
    if not group or key not in group["keys"]:
        sys.exit(f"keys: no {name} {key} in this machine's keys.yml; add it there first")
    spec = group["keys"][key]
    prefix = spec.get("prefix", "")
    text = f"{group['what']}\n\n{key}: {spec['may']}.\nFrom {spec['from']}."
    if prefix:
        text += f"\nIt starts with {prefix}"
    if spec.get("shape"):
        text += {"guid": "\nIt looks like 00000000-0000-0000-0000-000000000000",
                 "hex32": "\nIt is 32 letters and digits, 0-9 and a-f"}[spec["shape"]]
    for _ in range(3):
        value = ask(f"Keychain: {name}", text)
        if value is None:
            sys.exit("keys: the window was closed; nothing stored")
        if fits(spec, value):
            store(group, key, value)
            print(f"keys: stored {name} {key} in {short(group['path'])}")
            return
        kind = f"start with {prefix}" if prefix else f"look like a {spec.get('shape')}"
        text = f"That one does not {kind}. Paste the {key} again.\n\n" + text
    sys.exit("keys: three tries without the right kind of key; nothing stored")


def tailnet(device):
    """(this box's tailnet address, the device's addresses), from tailscale itself."""
    status = json.loads(subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, check=True).stdout)
    for peer in (status.get("Peer") or {}).values():
        if device in (peer.get("HostName"), peer.get("DNSName", "").split(".")[0]):
            return status["Self"]["TailscaleIPs"][0], set(peer["TailscaleIPs"])
    sys.exit(f"keys: no device {device} on the tailnet (tailscale status)")


def offer(groups, name, device, minutes=60):
    """Serve one page, to one tailnet device, asking for the group's wanted keys; stop once all are held."""
    group = groups.get(name)
    if not group:
        sys.exit(f"keys: no group {name} in this machine's keys.yml")
    here, allowed = tailnet(device)
    path = "/" + secrets.token_urlsafe(12)

    def wanted():
        held = read(group)
        return [k for k, spec in group["keys"].items() if not held.get(k) or not fits(spec, held[k])]

    def page(note=""):
        rows = "".join(
            f"<label><b>{html.escape(k)}</b><br><small>{html.escape(group['keys'][k]['may'])}. "
            f"From {html.escape(group['keys'][k]['from'])}.</small><br>"
            f"<input name='{html.escape(k)}' type='password' autocomplete='off' autocapitalize='off' spellcheck='false'></label>"
            for k in wanted())
        body = (f"<form method='post'>{rows}<button>Keep</button></form>" if rows
                else "<p>All held. This page is closed.</p>")
        return (f"<!doctype html><meta name='viewport' content='width=device-width'><title>Keychain: {html.escape(name)}</title>"
                "<style>body{font:17px system-ui;margin:1.5em;max-width:36em}label{display:block;margin:1.2em 0}"
                "input{width:100%;font:16px ui-monospace,monospace;padding:.5em}button{font:17px system-ui;padding:.5em 1.5em}</style>"
                f"<h1>Keychain: {html.escape(name)}</h1><p>{html.escape(group['what'])}</p>{note}{body}").encode()

    class Door(http.server.BaseHTTPRequestHandler):
        def answer(self, status, data=b""):
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def let_in(self):
            if self.client_address[0] not in allowed or self.path != path:
                self.answer(404)
                return False
            return True

        def do_GET(self):
            if self.let_in():
                self.answer(200, page())

        def do_POST(self):
            if not self.let_in():
                return
            form = urllib.parse.parse_qs(self.rfile.read(int(self.headers.get("Content-Length") or 0)).decode())
            notes = []
            for key in wanted():
                value = (form.get(key) or [""])[0].strip()
                if not value:
                    continue
                if fits(group["keys"][key], value):
                    store(group, key, value)
                    notes.append(f"Kept {key}.")
                    print(f"keys: stored {name} {key} in {short(group['path'])}", flush=True)
                else:
                    notes.append(f"{key} was not the right kind; nothing kept for it.")
            self.answer(200, page("".join(f"<p>{html.escape(n)}</p>" for n in notes)))

        def log_message(self, *args):
            pass

    server = http.server.HTTPServer((here, 0), Door)
    server.timeout = 5
    print(f"keys: offering {name} to {device} for {minutes} min at http://{here}:{server.server_port}{path}", flush=True)
    end = time.monotonic() + minutes * 60
    while wanted() and time.monotonic() < end:
        server.handle_request()
    server.server_close()
    left = wanted()
    print(f"keys: {name} still lacks {', '.join(left)}; the page is closed" if left else f"keys: {name} held; the page is closed")
    return 1 if left else 0


def run(groups, names, command):
    env = dict(os.environ)
    for name in names:
        group = groups.get(name)
        if not group:
            sys.exit(f"keys: no group {name} in this machine's keys.yml ({', '.join(wears()) or 'it wears no job'})")
        if group["form"] != "env":
            sys.exit(f"keys: {name} is one raw value; its job reads {short(group['path'])} itself")
        held = read(group)
        missing = [k for k in group["keys"] if not held.get(k)]
        if missing:
            sys.exit(f"keys: {name} lacks {', '.join(missing)}: keys take {name} {missing[0]}")
        env.update({k: held[k] for k in group["keys"]})
    env["PATH"] = os.pathsep.join(gear_folders() + [env.get("PATH", "")])
    exe = shutil.which(command[0], path=env["PATH"])                    # Windows: npx is npx.cmd
    if not exe:
        sys.exit(f"keys: no {command[0]} on this machine")
    if WINDOWS:
        sys.exit(subprocess.run([exe] + command[1:], env=env).returncode)
    os.execve(exe, command, env)

# Windows' own OpenSSH: its agent is a service that keeps a key across restarts, and Git's ssh does not speak to it.
OPENSSH = pathlib.Path(os.environ.get("SystemRoot", r"C:\Windows")) / "System32" / "OpenSSH"


def ssh_tool(name):
    if WINDOWS and (OPENSSH / f"{name}.exe").is_file():
        return str(OPENSSH / f"{name}.exe")
    found = shutil.which(name)
    if not found:
        sys.exit(f"keys: no {name} on this machine")
    return found


def agent_held():
    return WINDOWS and not os.environ.get("FCPM_BIRTH_FILE")


def agent(*args):
    env = {k: v for k, v in os.environ.items() if k != "SSH_AUTH_SOCK"}        # Git's bash may set one of its own
    return subprocess.run([ssh_tool("ssh-add"), *args], capture_output=True, text=True, env=env)


def agent_running():
    done = subprocess.run(["sc", "query", "ssh-agent"], capture_output=True, text=True)
    return "RUNNING" in done.stdout


def start_agent():
    """An administrator's step, once: the agent service on at every start (Windows ships it off)."""
    cmd = "Set-Service ssh-agent -StartupType Automatic; Start-Service ssh-agent"
    print(f"keys: asking Windows for an administrator to run: {cmd}")
    subprocess.run(["powershell", "-NoProfile", "-Command",
                    f"Start-Process powershell -Verb RunAs -Wait -ArgumentList '-NoProfile','-Command','{cmd}'"])
    if not agent_running():
        sys.exit("keys: the OpenSSH agent is not running; nothing was made")


def show_birth(job, pub):
    line = pub.read_text(encoding="utf-8").strip()
    print(f"keys: {job}'s key, public half (safe to show anyone): {short(pub)}\n")
    print(line + "\n")
    try:
        import qrcode
        code = qrcode.QRCode(border=2)
        code.add_data(line)
        code.print_ascii(invert=True)
    except ImportError:
        print("(no QR code: this Python lacks qrcode)")
    lodge(job, pub, line)


def own_helm(job):
    """Where this machine's own helm answers: helms.yml's `at` for its job, else this machine's port 8080."""
    if os.environ.get("FCPM_BIRTH_HELM"):
        return os.environ["FCPM_BIRTH_HELM"]
    helms = (yaml.safe_load((HERE / "helms.yml").read_text(encoding="utf-8")) or {}).get("helms") or {}
    return (helms.get(job) or {}).get("at") or "http://127.0.0.1:8080"


def lodge(job, pub, line):
    """The petition (wizard:keys+birth), set down once at this machine's own helm, which passes it to the
    keystore's (helms.yml). Nobody carries the key: the grant is a board wizard's, at the keystore."""
    mark = pub.with_name(pub.name[:-len(".pub")] + ".lodged")
    if mark.exists():
        print(f"\nLodged with the keystore already ({mark.read_text(encoding='utf-8').strip()}); it waits there")
        print("for a board wizard's grant (docs/keystore.md, Birth).")
        return
    rev = subprocess.run(["git", "-C", str(HERE.parent), "rev-parse", "--short", "HEAD"], capture_output=True, text=True)
    petition = {"schema": "fcpm.reply/v0", "wizard": "wizard:keys+birth", "at": rev.stdout.strip() or "unknown",
                "job": job, "host": os.environ.get("COMPUTERNAME") or platform.node().split(".")[0], "key": line,
                "issued": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
                "nonce": secrets.token_hex(8), "sig": None}
    at = own_helm(job)
    request = urllib.request.Request(at.rstrip("/") + "/drop", json.dumps(petition).encode("utf-8"),
                                     {"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=10) as answer:
            kept = json.load(answer).get("kept")
    except (OSError, ValueError) as exc:
        print(f"\nNot lodged yet: this machine's helm ({at}) did not take it ({exc}).")
        print("Run fcpm keys birth again once the helm is up (fcpm helm status); the key stays as it is.")
        return
    mark.write_text(f"set down at {at} as {kept}, {petition['issued']}\n", encoding="utf-8")
    print(f"\nLodged with the keystore: set down at this machine's helm as {kept}, which passes it on. It")
    print("waits there for a board wizard's grant (docs/keystore.md, Birth). Nothing needs carrying by hand.")


def birth():
    jobs = wears()
    if not jobs:
        sys.exit("keys: this machine wears no job, so its key would have no name (machines/binding)")
    job = jobs[0]
    ssh = pathlib.Path.home() / ".ssh"
    key, pub = ssh / f"fcpm-{job}", ssh / f"fcpm-{job}.pub"
    if pub.exists():
        if agent_held():
            if not agent_running():
                start_agent()
            if pub.read_text(encoding="utf-8").split()[1] not in agent("-L").stdout:
                sys.exit(f"keys: {short(pub)} is here but the agent does not hold its private half; "
                         f"take {short(pub)} away and run keys birth again for a new one")
        elif not key.exists():
            sys.exit(f"keys: {short(pub)} is here but its private half is not; take it away for a new one")
        return show_birth(job, pub)
    if agent_held() and not agent_running():
        start_agent()
    ssh.mkdir(parents=True, exist_ok=True)
    host = os.environ.get("COMPUTERNAME") or platform.node().split(".")[0]
    comment = f"fcpm {job} {host} {time.strftime('%Y-%m-%d')}".strip()
    if agent_held():
        made = pathlib.Path(tempfile.mkdtemp(prefix="fcpm-birth-"))
        try:
            subprocess.run([ssh_tool("ssh-keygen"), "-q", "-t", "ed25519", "-N", "", "-C", comment,
                            "-f", str(made / "key")], check=True)
            added = agent(str(made / "key"))
            if added.returncode:
                sys.exit(f"keys: the agent did not take the key ({added.stderr.strip()}); nothing was kept")
            shutil.copyfile(made / "key.pub", pub)
        finally:
            shutil.rmtree(made, ignore_errors=True)          # the private half now lives in the agent alone
    else:
        subprocess.run([ssh_tool("ssh-keygen"), "-q", "-t", "ed25519", "-N", "", "-C", comment, "-f", str(key)],
                       check=True)
        if not WINDOWS:
            os.chmod(key, 0o600)
    print(f"keys: made {job}'s key here, once")
    return show_birth(job, pub)


def main(argv):
    if WINDOWS:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    if argv == ["birth"]:
        return birth()
    groups = load()
    if not groups and argv[:1] != ["run"]:
        print(f"keys: this machine holds no keychain ({', '.join(wears()) or 'it wears no job'})")
        return 0
    if argv[:1] == ["take"] and len(argv) == 3:
        return take(groups, argv[1], argv[2])
    if argv[:1] == ["offer"] and len(argv) == 3:
        return offer(groups, argv[1], argv[2])
    if argv[:1] == ["run"] and "--" in argv:
        cut = argv.index("--")
        if cut > 1 and argv[cut + 1:]:
            return run(groups, argv[1:cut], argv[cut + 1:])
    if argv in ([], ["check"]):
        wanted = 0
        for ok, what, fix in facts(groups):
            if ok:
                print(f"ok      {what}")
            else:
                wanted += 1
                print(f"WANTED  {what}  -> {fix}")
        return 1 if wanted and argv else 0
    sys.exit(__doc__.strip())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
