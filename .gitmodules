[submodule ".advocate-engine"]
	path = .advocate-engine
	url = https://github.com/FCCN-ANTIBODY/advocate.anecdote.channel.git
[submodule ".contact-sheets-engine"]
	path = .contact-sheets-engine
	url = https://github.com/FC-Public-Media/contact-sheets.git
	# Not part of any build here. The engine is a tool the studio runs, not
	# an input to the site, so a checkout that skips it is correct rather
	# than degraded. It is ALSO private, and publish-member-sites.yml checks
	# out with `submodules: recursive` under a GITHUB_TOKEN scoped to this
	# repository alone — which cannot read another private repo.
	update = none
[submodule ".library-engine"]
	path = .library-engine
	url = https://github.com/FCCN-ANTIBODY/library.anecdote.channel.git
	# Mounted 2026-09-24, as README.md's "Library (`.library-engine`)" already
	# claimed. Mounting an engine is this node's sign that it can do that
	# engine's work, or offer to. FCPM's library itself is the `library`
	# BRANCH, not a folder on main ("a library is a branch": the engine's
	# SHELVES.md). Answering the engine's residency.yml wants (stacks,
	# catalogue, intake, seats, petitions) is the next gesture, and it is not
	# done here. Pinned where station-node pins it.
[submodule ".enhance-engine"]
	path = .enhance-engine
	url = https://github.com/FC-Public-Media/enhance.git
	# Mounted 2026-09-24: recordings out to the enhance suite and back,
	# enhanced or stemmed. A companion to contact-sheets. This node owns
	# the depot, so receipt is ours. Private like contact-sheets, and for
	# the same reason as its entry above: nothing in a build needs it.
	update = none
