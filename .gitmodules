[submodule ".advocate-engine"]
	path = .advocate-engine
	url = https://github.com/FCCN-ANTIBODY/advocate.anecdote.channel.git
[submodule ".contact-sheets-engine"]
	path = .contact-sheets-engine
	url = https://github.com/FC-Public-Media/contact-sheets.git
	# Private and in no build; a repo-scoped GITHUB_TOKEN cannot fetch it, so checkouts skip it.
	update = none
[submodule ".library-engine"]
	path = .library-engine
	url = https://github.com/FCCN-ANTIBODY/library.anecdote.channel.git
	# FCPM's library is the `library` branch, not a folder on main. Pinned where station-node pins it.
[submodule ".enhance-engine"]
	path = .enhance-engine
	url = https://github.com/FC-Public-Media/enhance.git
	# Private and in no build, like contact-sheets.
	update = none
[submodule ".atlas-engine"]
	path = .atlas-engine
	url = https://github.com/FCCN-ANTIBODY/atlas.anecdote.channel.git
	# The directory; `atlas.yml` is who we are. See docs/members.md#directory.
[submodule ".tell-engine"]
	path = .tell-engine
	url = https://github.com/FCCN-ANTIBODY/tell.anecdote.channel.git
	# The hub member data piles register to; `tell.yml`, signed by `keys/tell.fpr`. See docs/members.md#directory.
# Troves: one repository each, all private (troves/README.md). update = none keeps CI's token
# from trying them; bin/refs and the kiosk's door check them out with --checkout. ignore = untracked:
# a trove that runs leaves bytecode beside itself.
[submodule "troves/aja-helo"]
	path = troves/aja-helo
	url = https://github.com/FC-Public-Media/aja-helo.git
	update = none
	ignore = untracked
[submodule "troves/atem-mini-pro"]
	path = troves/atem-mini-pro
	url = https://github.com/FC-Public-Media/atem-mini-pro.git
