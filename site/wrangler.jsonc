// see docs/inline/site/wrangler.jsonc.md#1
{
  "name": "fcpm",
  "compatibility_date": "2026-07-31",

  "assets": {
    "directory": "_site",

    // Serve _site/404.html for anything that does not match a file.
    "not_found_handling": "404-page",

    // see docs/inline/site/wrangler.jsonc.md#2
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": true
  }
}
