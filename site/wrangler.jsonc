// Cloudflare Workers config: static assets only, no `main`. See docs/site.md#deploy.
// Without this file `wrangler deploy` auto-configures and fails re-running the build through npx.
{
  "name": "fcpm",
  "compatibility_date": "2026-07-31",

  "assets": {
    "directory": "_site",
    "not_found_handling": "404-page",
    // Matches Jekyll's pretty permalinks: /classes/ from _site/classes/index.html.
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": true
  }
}
