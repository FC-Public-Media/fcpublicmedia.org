{%- comment -%}
  Azure Static Web Apps configuration.

  The redirect list is generated from _data/redirects.yml, the same file that
  produces Cloudflare's _redirects, so moving between hosts cannot leave one
  of them stale. Everything else here is Azure-specific and hand-written.

  Harmless on Cloudflare Pages, which ignores it.
{%- endcomment -%}
{
  "trailingSlash": "always",

  "routes": [
    { "route": "/login", "rewrite": "/.auth/login/aad" },
    { "route": "/logout", "rewrite": "/.auth/logout" },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },

    { "route": "/members/*", "allowedRoles": ["member"] },
    { "route": "/api/members/*", "allowedRoles": ["member"] }
    {%- for r in site.data.redirects %},
    { "route": "{{ r.from }}", "redirect": "{{ r.to }}", "statusCode": 301 }
    {%- endfor %}
  ],

  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/login" },
    "404": { "rewrite": "/404.html" }
  },

  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/assets/*", "/*.{css,js,png,jpg,jpeg,svg,webp,ico,woff2}"]
  },

  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },

  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },

  "auth": {
    "rolesSource": "/api/GetRoles"
  }
}
