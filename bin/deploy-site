#!/bin/sh
# deploy-site: build site/ and upload it to Cloudflare Pages, project fcpm-new (new.fcpublicmedia.org).
# That is the whole deploy: a direct upload of _site, from a checkout on a box holding the keychain's
# `cloudflare` group. No CI, no git-connected build, no other host. See docs/site.md#deploy.
#
#   bin/deploy-site            build HEAD's site/ and upload it as fcpm-new's production (branch main)
#   bin/deploy-site --build    build and run the publish checks only; upload nothing

set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT/site"
JEKYLL_ENV=production jekyll build
python3 bin/test_nothing_internal_is_published.py
python3 bin/test_site_runs_no_code.py
[ "${1:-}" = --build ] && exit 0

cd "$ROOT"
dirty=false
git diff --quiet HEAD -- site || dirty=true
exec machines/digitization/keys run cloudflare -- npx --yes wrangler@4 pages deploy site/_site \
  --project-name fcpm-new --branch main \
  --commit-hash "$(git rev-parse HEAD)" --commit-message "$(git log -1 --format=%s)" --commit-dirty="$dirty"
