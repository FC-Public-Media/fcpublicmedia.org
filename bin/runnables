#!/bin/sh
# runnables — the census: every runnable this checkout carries, and what each claims.
#
#   bin/runnables              every runnable file, its verbs, and what they default to
#   bin/runnables undeclared   runnable files with no claim at all
#   bin/runnables check        claims for files that are not here. Exit 1 if any
#   bin/runnables compile P    profile P's GRANTS, as harness settings, to stdout
#   bin/runnables prove P H --by WHO [--exercise]
#                              the bay's proof that holder H, at this blob, does
#                              what its read verbs claim on profile P's machine.
#                              Runs them, checks nothing changed, records it.
#                              --exercise also runs the cycle P's GRANTS
#                              declares for H, which is what `admit` allows
#
# THIS IS THE OSTENSIBLY AVAILABLE LIST, AND BEING ON IT GRANTS NOTHING. It
# shows what the repository carries (machines/RUNNABLES says what each verb
# claims to do) so a crew's answer can be read against it. Nothing here writes a
# setting. docs/RUNNABLES.md.
#
# The identity it prints is the file's git blob at HEAD: the same bytes on every
# host that has this commit. A file changed since HEAD is marked, because what
# a claim was proven against is the committed file, never the working copy.
#
# Read-only. Git Bash on Windows; no Python, because a bay may not have one yet.

set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLAIMS="$ROOT/machines/RUNNABLES"
cd "$ROOT" || exit 1

# Where runnables live. A trove's bay procedures and runtime verbs are the
# recorder's and the screens' own; the rest are the repository's.
discover() {
  git ls-files -- bin site/bin machines troves worker/bin 2>/dev/null |
  while IFS= read -r f; do
    case "$f" in
      *.py|*.ps1|*.sh) echo "$f" ;;
      *.md|*.yml|*.yaml|*.json|*.log|*.txt|*/names|*/RUNNABLES|*/GRANTS|*/MANIFEST) ;;
      *) [ "$(head -c2 "$f" 2>/dev/null)" = '#!' ] && echo "$f" ;;
    esac
  done | sort -u
}

# Claims, one per line: holder|run|shape|class|says, trimmed.
claims() {
  sed -e 's/#.*$//' "$CLAIMS" | awk -F'|' 'NF >= 5 {
    for (i = 1; i <= NF; i++) { gsub(/^[ \t]+|[ \t\r]+$/, "", $i) }
    print $1 "|" $2 "|" $3 "|" $4 "|" $5 }'
}

default_for() {
  case "$1" in
    read|inside) echo allow ;;
    outside|desk) echo ask ;;
    secret|service) echo deny ;;
    *) echo "?" ;;
  esac
}

identity() {
  blob=$(git rev-parse --short=12 "HEAD:$1" 2>/dev/null || echo "not-committed")
  if ! git diff --quiet HEAD -- "$1" 2>/dev/null; then blob="$blob+modified"; fi
  echo "$blob"
}

cmd=${1:-list}
case "$cmd" in
  list)
    all=$(discover); c=$(claims)
    n=0; u=0
    for f in $all; do
      n=$((n + 1))
      mine=$(printf '%s\n' "$c" | awk -F'|' -v f="$f" '$1 == f')
      if [ -z "$mine" ]; then u=$((u + 1)); continue; fi
      printf '%s  %s\n' "$f" "$(identity "$f")"
      printf '%s\n' "$mine" | while IFS='|' read -r h run shape class says; do
        printf '    %-6s %-8s %-22s %s\n' "$(default_for "$class")" "$class" "$shape" "$says"
      done
    done
    echo
    echo "$n runnable files; $((n - u)) claimed, $u undeclared (bin/runnables undeclared)."
    ;;
  undeclared)
    c=$(claims | cut -d'|' -f1 | sort -u)
    discover | while IFS= read -r f; do
      printf '%s\n' "$c" | grep -qxF "$f" || printf '%s  %s\n' "$f" "$(identity "$f")"
    done
    ;;
  check)
    bad=0
    for h in $(claims | cut -d'|' -f1 | sort -u); do
      if [ ! -f "$h" ]; then echo "claimed, not here: $h"; bad=1; fi
    done
    claims | while IFS='|' read -r h run shape class says; do
      [ "$(default_for "$class")" = "?" ] && echo "unknown class '$class': $h $shape"
    done
    [ $bad = 0 ] && echo "every claim names a file that is here."
    exit $bad
    ;;
  compile)
    # Boring on purpose: a machine that grants permissions should have no
    # judgment in it. It prints; `machines/sync` is what puts it in place.
    p=${2:-}; G="$ROOT/machines/$p/GRANTS"; PROVEN="$ROOT/machines/$p/bay/runnables.proven"
    [ -n "$p" ] && [ -f "$G" ] || { echo "compile: no machines/$p/GRANTS" >&2; exit 2; }
    [ -f "$PROVEN" ] || PROVEN=/dev/null
    # {LOCALAPPDATA} in a runner is this host's, with forward slashes: a rule
    # matches the text a session types, so the committed file names the place
    # and the compiled one names the path.
    lad=$(printf '%s' "${LOCALAPPDATA:-}" | tr '\\' '/')
    blobs=$(claims | cut -d'|' -f1 | sort -u | while read -r h; do
      printf '%s %s\n' "$h" "$(git rev-parse --short=12 "HEAD:$h" 2>/dev/null)"; done)
    claims | awk -F'|' -v grants="$G" -v proven="$PROVEN" -v blobs="$blobs" -v lad="$lad" '
      function rank(a) { return a == "allow" ? 0 : a == "ask" ? 1 : 2 }
      function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
      function trim(s) { gsub(/^[ \t]+|[ \t\r]+$/, "", s); return s }
      BEGIN {
        while ((getline l < grants) > 0) {
          sub(/#.*$/, "", l); if (l ~ /^[ \t]*$/) continue
          n = split(l, w, /[ \t]+/)
          if (w[1] == "checkout") checkout = w[2]
          else if (w[1] == "wears") { wears[w[2]] = 1; nwears++ }
          else if (w[1] == "runner") {
            pre = ""; for (i = 4; i <= n; i++) pre = pre w[i] " "
            if (pre ~ /\{LOCALAPPDATA\}/) {
              if (lad == "") { print "compile: LOCALAPPDATA unset, runner skipped: " l > "/dev/stderr"; continue }
              gsub(/\{LOCALAPPDATA\}/, lad, pre)
            }
            forms[w[2]] = forms[w[2]] SUBSEP w[3] "\t" pre
          } else if (w[1] == "host") {
            # A command that is not ours: it can be held back, never let through.
            # Only a proven holder of ours is ever allowed.
            r = l; sub(/^[ \t]*host[ \t]+[a-z]+[ \t]+/, "", r); r = trim(r)
            if (w[2] != "ask" && w[2] != "deny") { print "compile: refused, host may only ask or deny: " r > "/dev/stderr"; continue }
            if (!seen[w[2], r]++) list[w[2]] = list[w[2]] (list[w[2]] == "" ? "" : ",\n") "      \"" esc(r) "\""
          } else if (w[1] == "admit") {
            # The one widening. An `outside` verb becomes an allow, and only
            # once the bay has exercised it; the line itself is admitted by the
            # merge that brings it. desk, secret and service are never admitted.
            rest = l; sub(/^[ \t]*admit[ \t]+[a-z]+[ \t]+/, "", rest)
            split(rest, hs, "|")
            if (w[2] != "allow") { print "compile: refused, admit only allows: " rest > "/dev/stderr"; continue }
            admit[trim(hs[1]) "|" trim(hs[2])] = 1
          } else if (w[1] == "narrow") {
            rest = l; sub(/^[ \t]*narrow[ \t]+[a-z]+[ \t]+/, "", rest)
            split(rest, hs, "|"); narrow[trim(hs[1]) "|" trim(hs[2])] = w[2]
          }
        }
        while ((getline l < proven) > 0) {
          n = split(l, w, /[ \t]+/); if (w[1] ~ /^#/ || n < 2) continue
          ok[w[1] " " w[2]] = 1
          for (i = 3; i <= n; i++) if (w[i] ~ /^exercised:/) {
            m = split(substr(w[i], 11), ex, ";")
            for (j = 1; j <= m; j++) { gsub(/\+/, " ", ex[j]); exercised[w[1] " " w[2] "|" ex[j]] = 1 }
          }
        }
        nb = split(blobs, bl, "\n"); for (i = 1; i <= nb; i++) { split(bl[i], w, " "); blob[w[1]] = w[2] }
      }
      {
        h = $1; run = $2; shape = $3; class = $4
        # A profile that names what it wears answers for nothing else: the
        # bays do not run the door, and its rules are not theirs to carry.
        if (nwears && !(h in wears)) next
        a = (class == "read" || class == "inside") ? "allow" : (class == "outside" || class == "desk") ? "ask" : "deny"
        k = h "|" shape
        if (k in narrow) {
          if (rank(narrow[k]) < rank(a)) { print "compile: refused, narrow loosens " k > "/dev/stderr" }
          else a = narrow[k]
        }
        if ((k in admit) && !(k in narrow)) {
          if (class != "outside") {
            print "compile: refused, admit is for outside verbs, not " class ": " k > "/dev/stderr"
          } else if ((h " " blob[h] "|" shape) in exercised) {
            a = "allow"
          } else {
            print "compile: admitted, not exercised at @" blob[h] ", still asks: " k > "/dev/stderr"
          }
        }
        # Unproven is left OFF the list, not turned into `ask`: an ask rule
        # forces a prompt even where the harness would have let it through, and
        # a background session has nobody to answer one.
        if (a == "allow" && !((h " " blob[h]) in ok)) {
          print "compile: unproven, not listed: " h " @" blob[h] " " shape > "/dev/stderr"; next
        }
        if (!(run in forms)) { print "compile: no runner for " run ", skipped: " h > "/dev/stderr"; next }
        nf = split(substr(forms[run], 2), f, SUBSEP)
        for (i = 1; i <= nf; i++) {
          if (a != "deny" && i > 1) break
          split(f[i], tp, "\t"); cmd = tp[2] checkout "/" h
          if (shape == "*") cmd = cmd " *"; else if (shape != "-") cmd = cmd " " shape
          nr = 1; rs[1] = tp[1] "(" cmd ")"
          # A deny also covers the verb with anything after it.
          if (a == "deny" && cmd !~ /\*$/) { nr = 2; rs[2] = tp[1] "(" cmd " *)" }
          for (j = 1; j <= nr; j++) { r = rs[j]
            if (!seen[a, r]++) list[a] = list[a] (list[a] == "" ? "" : ",\n") "      \"" esc(r) "\"" }
        }
      }
      END {
        printf "{\n  \"permissions\": {\n"
        printf "    \"allow\": [\n%s\n    ],\n", list["allow"]
        printf "    \"ask\": [\n%s\n    ],\n", list["ask"]
        printf "    \"deny\": [\n%s\n    ]\n  }\n}\n", list["deny"]
      }'
    ;;
  prove)
    # THE BAY'S QUESTION, ASKED OF OUR OWN BYTES. A payload from outside is
    # proven by the vendor's digest and signature; a tool of ours by its blob,
    # and by doing what it claims on the machine that will run it. This runs
    # every `read` verb of the holder, exactly as the profile's canonical
    # runner starts it, and requires that nothing changed: not this checkout,
    # and not the profile's bay or troves folders. Then it writes one line.
    #
    # It proves the read verbs by running them, and nothing else. An `inside`
    # verb is allowed on the strength of the same line, so `--by` names who
    # read the rest of the holder's code and vouches for it. A proof is a
    # commit, and admission is still the merge.
    p=${2:-}; h=${3:-}; by=""; exercise=""
    shift 3 2>/dev/null || true
    while [ $# -gt 0 ]; do
      case "$1" in --by) by=${2:-}; shift 2 ;; --exercise) exercise=1; shift ;; *) shift ;; esac
    done
    G="$ROOT/machines/$p/GRANTS"
    [ -f "$G" ] && [ -n "$h" ] && [ -n "$by" ] || { echo "usage: bin/runnables prove <profile> <holder> --by <who>" >&2; exit 2; }
    case "$ROOT" in */refs/*) echo "prove: $ROOT is a read-only mirror; prove from a work/ worktree" >&2; exit 2 ;; esac
    if grep -q '^[[:space:]]*wears[[:space:]]' "$G" && ! grep -qE "^[[:space:]]*wears[[:space:]]+$h([[:space:]]|$)" "$G"; then
      echo "prove: $p does not wear $h" >&2; exit 2; fi
    blob=$(git rev-parse --short=12 "HEAD:$h" 2>/dev/null) || { echo "prove: $h is not committed" >&2; exit 2; }
    git diff --quiet HEAD -- "$h" || { echo "prove: $h differs from HEAD; a proof is of committed bytes" >&2; exit 2; }
    run=$(claims | awk -F'|' -v h="$h" '$1 == h { print $2; exit }')
    [ -n "$run" ] || { echo "prove: $h claims nothing (machines/RUNNABLES)" >&2; exit 2; }
    prefix=$(sed -e 's/#.*$//' "$G" | awk -v r="$run" '$1 == "runner" && $2 == r && $3 == "Bash" { for (i = 4; i <= NF; i++) printf "%s ", $i; exit }')
    lad=$(printf '%s' "${LOCALAPPDATA:-}" | tr '\\' '/'); prefix=$(printf '%s' "$prefix" | sed "s|{LOCALAPPDATA}|$lad|g")
    state() {
      git -C "$ROOT" status --porcelain
      for d in bay troves; do
        [ -d "$LOCALAPPDATA/$p/$d" ] && find "$LOCALAPPDATA/$p/$d" -printf '%p %s %T@\n' 2>/dev/null | sort
      done
      [ -f "$LOCALAPPDATA/$p/bay.ndjson" ] && wc -c < "$LOCALAPPDATA/$p/bay.ndjson"
    }
    before=$(state); ran=""
    for shape in $(claims | awk -F'|' -v h="$h" '$1 == h && $4 == "read" { gsub(/ /, "\001", $3); print $3 }'); do
      shape=$(printf '%s' "$shape" | tr '\001' ' ')
      case "$shape" in *'*'*) echo "skip      $shape (takes arguments; proven by reading)"; continue ;; esac
      args=""; [ "$shape" = "-" ] || args=$shape
      echo "run       $prefix$h $args"
      # shellcheck disable=SC2086
      $prefix "$h" $args >/dev/null 2>&1; rc=$?
      [ $rc -le 1 ] || { echo "prove: '$shape' exited $rc; not proven" >&2; exit 1; }
      ran="$ran${ran:+,}$shape"
    done
    after=$(state)
    [ "$before" = "$after" ] || { echo "prove: a read verb changed something; not proven:" >&2
      diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -20 >&2; exit 1; }

    # --exercise: THE CYCLE A TASK WILL RUN, run once, watched. What an
    # `admit` may allow is what this proved. GRANTS declares it as data:
    #   exercise <holder> | <shape> ; <shape> ; ...   the cycle, in order
    #   untouched <path>      must list the same (names, sizes, times) after
    #   quiet <image>         none may run before it starts, none after it ends
    # Files may change under the profile's troves folder and nowhere else the
    # bay watches: not this checkout, not its bay folder or run log.
    exercised=""
    if [ -n "$exercise" ]; then
      cycle=$(sed -e 's/#.*$//' "$G" | awk -v h="$h" '$1 == "exercise" { r = $0; sub(/^[ \t]*exercise[ \t]+/, "", r); split(r, a, "|"); gsub(/^[ \t]+|[ \t]+$/, "", a[1]); if (a[1] == h) print a[2] }')
      [ -n "$cycle" ] || { echo "prove: GRANTS declares no exercise for $h" >&2; exit 2; }
      expand() { printf '%s' "$1" | sed -e "s|{APPDATA}|$(printf '%s' "${APPDATA:-}" | tr '\\' '/')|g" \
        -e "s|{LOCALAPPDATA}|$lad|g" -e "s|{USERPROFILE}|$(printf '%s' "${USERPROFILE:-}" | tr '\\' '/')|g"; }
      untouched=$(sed -e 's/#.*$//' "$G" | awk '$1 == "untouched" { $1 = ""; sub(/^ /, ""); print }')
      quiet=$(sed -e 's/#.*$//' "$G" | awk '$1 == "quiet" { print $2 }')
      # expect <file> <text>: something the cycle appends to <file> must
      # contain <text>, such as a stop that closed rather than killed.
      expects=$(awk '$1 == "expect" { $1 = ""; sub(/^ /, ""); print }' "$G")
      exp_sizes=$(printf '%s\n' "$expects" | while read -r f _; do [ -n "$f" ] || continue
        f=$(expand "$f"); if [ -f "$f" ]; then wc -c < "$f"; else echo 0; fi; done)
      watch() {
        git -C "$ROOT" status --porcelain
        [ -d "$LOCALAPPDATA/$p/bay" ] && find "$LOCALAPPDATA/$p/bay" -printf '%p %s %T@\n' | sort
        [ -f "$LOCALAPPDATA/$p/bay.ndjson" ] && wc -c < "$LOCALAPPDATA/$p/bay.ndjson"
        printf '%s\n' "$untouched" | while IFS= read -r u; do [ -n "$u" ] || continue
          d=$(expand "$u"); if [ -e "$d" ]; then find "$d" -printf '%p %s %T@\n' | sort; else echo "absent $d"; fi; done
      }
      running() { powershell -NoProfile -Command "(@(Get-Process '$1' -ErrorAction SilentlyContinue)).Count" | tr -d '\r'; }
      for q in $quiet; do
        [ "$(running "$q")" = 0 ] || { echo "prove: $q is running. The exercise starts only on a quiet machine, so it cannot mistake theirs for ours" >&2; exit 1; }
      done
      w0=$(watch)
      while IFS= read -r step; do
        step=$(printf '%s' "$step" | sed 's/^ *//; s/ *$//'); [ -n "$step" ] || continue
        echo "exercise  $prefix$h $step"
        # shellcheck disable=SC2086
        $prefix "$h" $step </dev/null; rc=$?
        [ $rc = 0 ] || { echo "prove: exercise '$step' exited $rc; not proven" >&2; exit 1; }
        exercised="$exercised${exercised:+;}$(printf '%s' "$step" | tr ' ' '+')"
      done <<CYCLE
$(printf '%s' "$cycle" | tr ';' '\n')
CYCLE
      for q in $quiet; do
        [ "$(running "$q")" = 0 ] || { echo "prove: $q is still running after the exercise; not proven" >&2; exit 1; }
      done
      i=0
      while read -r f text; do [ -n "$f" ] || continue
        i=$((i + 1)); from=$(printf '%s\n' "$exp_sizes" | sed -n "${i}p"); f=$(expand "$f")
        [ -f "$f" ] && tail -c +"$((from + 1))" "$f" | grep -qF -- "$text" ||
          { echo "prove: the exercise did not write '$text' to $f; not proven" >&2; exit 1; }
      done <<EXPECT
$expects
EXPECT
      w1=$(watch)
      [ "$w0" = "$w1" ] || { echo "prove: the exercise changed something it must not have; not proven:" >&2
        diff <(printf '%s\n' "$w0") <(printf '%s\n' "$w1") | head -20 >&2; exit 1; }
    fi

    out="$ROOT/machines/$p/bay/runnables.proven"
    mkdir -p "$(dirname "$out")"
    [ -f "$out" ] || printf '%s\n' "# runnables.proven: holders the bay has proven on this machine, by blob." \
      "# Written by \`bin/runnables prove\`. docs/RUNNABLES.md, machines/BAY.md." \
      "#" "# holder  blob  date  ran  by" > "$out"
    printf '%s %s %s ran:%s%s by:%s\n' "$h" "$blob" "$(date +%F)" "$(printf '%s' "${ran:-none}" | tr ' ' '+')" \
      "${exercised:+ exercised:$exercised}" "$by" >> "$out"
    echo "proven    $h @$blob on $p (ran: ${ran:-none}${exercised:+; exercised: $exercised}); recorded in machines/$p/bay/runnables.proven"
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
