#!/bin/sh
# runnables — the census: every runnable this checkout carries, and what each claims.
#
#   bin/runnables              every runnable file, its verbs, and what they default to
#   bin/runnables undeclared   runnable files with no claim at all
#   bin/runnables check        claims for files that are not here. Exit 1 if any
#   bin/runnables compile P    profile P's GRANTS, as harness settings, to stdout
#
# THIS IS THE OSTENSIBLY AVAILABLE LIST, AND BEING ON IT GRANTS NOTHING. It
# shows what the repository carries (machines/RUNNABLES says what each verb
# claims to do) so a crew's answer can be read against it. Nothing here writes a
# setting. docs/RUNNABLES.md.
#
# The identity it prints is the file's git blob at HEAD: the same bytes on every
# host that has this commit. A file changed since HEAD is marked, because what
# a claim was proven against is the committed file, never the working copy.
#
# Read-only. Git Bash on Windows; no Python, because a bay may not have one yet.

set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLAIMS="$ROOT/machines/RUNNABLES"
cd "$ROOT" || exit 1

# Where runnables live. A trove's bay procedures are the recorder's and the
# screens' own; the rest are the repository's.
discover() {
  git ls-files -- bin site/bin machines 'troves/*/bay' worker/bin 2>/dev/null |
  while IFS= read -r f; do
    case "$f" in
      *.py|*.ps1|*.sh) echo "$f" ;;
      *.md|*.yml|*.yaml|*.json|*.log|*.txt|*/names|*/RUNNABLES|*/GRANTS|*/MANIFEST) ;;
      *) [ "$(head -c2 "$f" 2>/dev/null)" = '#!' ] && echo "$f" ;;
    esac
  done | sort -u
}

# Claims, one per line: holder|run|shape|class|says, trimmed.
claims() {
  sed -e 's/#.*$//' "$CLAIMS" | awk -F'|' 'NF >= 5 {
    for (i = 1; i <= NF; i++) { gsub(/^[ \t]+|[ \t\r]+$/, "", $i) }
    print $1 "|" $2 "|" $3 "|" $4 "|" $5 }'
}

default_for() {
  case "$1" in
    read|inside) echo allow ;;
    outside|desk) echo ask ;;
    secret|service) echo deny ;;
    *) echo "?" ;;
  esac
}

identity() {
  blob=$(git rev-parse --short=12 "HEAD:$1" 2>/dev/null || echo "not-committed")
  if ! git diff --quiet HEAD -- "$1" 2>/dev/null; then blob="$blob+modified"; fi
  echo "$blob"
}

cmd=${1:-list}
case "$cmd" in
  list)
    all=$(discover); c=$(claims)
    n=0; u=0
    for f in $all; do
      n=$((n + 1))
      mine=$(printf '%s\n' "$c" | awk -F'|' -v f="$f" '$1 == f')
      if [ -z "$mine" ]; then u=$((u + 1)); continue; fi
      printf '%s  %s\n' "$f" "$(identity "$f")"
      printf '%s\n' "$mine" | while IFS='|' read -r h run shape class says; do
        printf '    %-6s %-8s %-22s %s\n' "$(default_for "$class")" "$class" "$shape" "$says"
      done
    done
    echo
    echo "$n runnable files; $((n - u)) claimed, $u undeclared (bin/runnables undeclared)."
    ;;
  undeclared)
    c=$(claims | cut -d'|' -f1 | sort -u)
    discover | while IFS= read -r f; do
      printf '%s\n' "$c" | grep -qxF "$f" || printf '%s  %s\n' "$f" "$(identity "$f")"
    done
    ;;
  check)
    bad=0
    for h in $(claims | cut -d'|' -f1 | sort -u); do
      if [ ! -f "$h" ]; then echo "claimed, not here: $h"; bad=1; fi
    done
    claims | while IFS='|' read -r h run shape class says; do
      [ "$(default_for "$class")" = "?" ] && echo "unknown class '$class': $h $shape"
    done
    [ $bad = 0 ] && echo "every claim names a file that is here."
    exit $bad
    ;;
  compile)
    # Boring on purpose: a machine that grants permissions should have no
    # judgment in it. It prints; `machines/sync` is what puts it in place.
    p=${2:-}; G="$ROOT/machines/$p/GRANTS"; PROVEN="$ROOT/machines/$p/bay/runnables.proven"
    [ -n "$p" ] && [ -f "$G" ] || { echo "compile: no machines/$p/GRANTS" >&2; exit 2; }
    [ -f "$PROVEN" ] || PROVEN=/dev/null
    # {LOCALAPPDATA} in a runner is this host's, with forward slashes: a rule
    # matches the text a session types, so the committed file names the place
    # and the compiled one names the path.
    lad=$(printf '%s' "${LOCALAPPDATA:-}" | tr '\\' '/')
    blobs=$(claims | cut -d'|' -f1 | sort -u | while read -r h; do
      printf '%s %s\n' "$h" "$(git rev-parse --short=12 "HEAD:$h" 2>/dev/null)"; done)
    claims | awk -F'|' -v grants="$G" -v proven="$PROVEN" -v blobs="$blobs" -v lad="$lad" '
      function rank(a) { return a == "allow" ? 0 : a == "ask" ? 1 : 2 }
      function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
      function trim(s) { gsub(/^[ \t]+|[ \t\r]+$/, "", s); return s }
      BEGIN {
        while ((getline l < grants) > 0) {
          sub(/#.*$/, "", l); if (l ~ /^[ \t]*$/) continue
          n = split(l, w, /[ \t]+/)
          if (w[1] == "checkout") checkout = w[2]
          else if (w[1] == "runner") {
            pre = ""; for (i = 4; i <= n; i++) pre = pre w[i] " "
            if (pre ~ /\{LOCALAPPDATA\}/) {
              if (lad == "") { print "compile: LOCALAPPDATA unset, runner skipped: " l > "/dev/stderr"; continue }
              gsub(/\{LOCALAPPDATA\}/, lad, pre)
            }
            forms[w[2]] = forms[w[2]] SUBSEP w[3] "\t" pre
          } else if (w[1] == "host") {
            # A command that is not ours: it can be held back, never let through.
            # Only a proven holder of ours is ever allowed.
            r = l; sub(/^[ \t]*host[ \t]+[a-z]+[ \t]+/, "", r); r = trim(r)
            if (w[2] != "ask" && w[2] != "deny") { print "compile: refused, host may only ask or deny: " r > "/dev/stderr"; continue }
            if (!seen[w[2], r]++) list[w[2]] = list[w[2]] (list[w[2]] == "" ? "" : ",\n") "      \"" esc(r) "\""
          } else if (w[1] == "narrow") {
            rest = l; sub(/^[ \t]*narrow[ \t]+[a-z]+[ \t]+/, "", rest)
            split(rest, hs, "|"); narrow[trim(hs[1]) "|" trim(hs[2])] = w[2]
          }
        }
        while ((getline l < proven) > 0) { split(l, w, /[ \t]+/); if (w[1] !~ /^#/) ok[w[1] " " w[2]] = 1 }
        nb = split(blobs, bl, "\n"); for (i = 1; i <= nb; i++) { split(bl[i], w, " "); blob[w[1]] = w[2] }
      }
      {
        h = $1; run = $2; shape = $3; class = $4
        a = (class == "read" || class == "inside") ? "allow" : (class == "outside" || class == "desk") ? "ask" : "deny"
        k = h "|" shape
        if (k in narrow) {
          if (rank(narrow[k]) < rank(a)) { print "compile: refused, narrow loosens " k > "/dev/stderr" }
          else a = narrow[k]
        }
        # Unproven is left OFF the list, not turned into `ask`: an ask rule
        # forces a prompt even where the harness would have let it through, and
        # a background session has nobody to answer one.
        if (a == "allow" && !((h " " blob[h]) in ok)) {
          print "compile: unproven, not listed: " h " @" blob[h] " " shape > "/dev/stderr"; next
        }
        if (!(run in forms)) { print "compile: no runner for " run ", skipped: " h > "/dev/stderr"; next }
        nf = split(substr(forms[run], 2), f, SUBSEP)
        for (i = 1; i <= nf; i++) {
          if (a != "deny" && i > 1) break
          split(f[i], tp, "\t"); cmd = tp[2] checkout "/" h
          if (shape == "*") cmd = cmd " *"; else if (shape != "-") cmd = cmd " " shape
          nr = 1; rs[1] = tp[1] "(" cmd ")"
          # A deny also covers the verb with anything after it.
          if (a == "deny" && cmd !~ /\*$/) { nr = 2; rs[2] = tp[1] "(" cmd " *)" }
          for (j = 1; j <= nr; j++) { r = rs[j]
            if (!seen[a, r]++) list[a] = list[a] (list[a] == "" ? "" : ",\n") "      \"" esc(r) "\"" }
        }
      }
      END {
        printf "{\n  \"permissions\": {\n"
        printf "    \"allow\": [\n%s\n    ],\n", list["allow"]
        printf "    \"ask\": [\n%s\n    ],\n", list["ask"]
        printf "    \"deny\": [\n%s\n    ]\n  }\n}\n", list["deny"]
      }'
    ;;
  *)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
