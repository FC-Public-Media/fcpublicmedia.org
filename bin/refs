#!/usr/bin/env bash
# refs: the read-only mirrors in ~/code/refs (the kiosk's ~/code/ref), and worktrees beside them in ~/code/work.
#
#   bin/refs pull [REPO...]    fetch, and fast-forward the clean ones; a dirty, off-branch or diverged one is left
#   bin/refs status            one line per repo: branch, behind/ahead, dirty
#   bin/refs work REPO BRANCH  new worktree at work/REPO@BRANCH, cut from origin/main
#   bin/refs done REPO BRANCH  remove that worktree (the branch is kept)
#   bin/refs clone OWNER/REPO  a new mirror, from the origin
#   bin/refs point [REPO...]   point mirrors (and their submodules) at the origin, fetching nothing
#   bin/refs origin            where code comes from: our origin, and nothing else
#
# Every fetch, clone and push is the origin's (origin.local's door, machines/origin); GitHub is never
# asked from here. A mirror still pointed at GitHub, or its submodules, is pointed at the origin before
# it is fetched. FCPM_CODE names another root, FCPM_ORIGIN_URL another origin. See docs/station.md, Sessions.

set -u
ROOT=${FCPM_CODE:-$HOME/code}
REF="$ROOT/refs"; [ -d "$REF" ] || [ ! -d "$ROOT/ref" ] || REF="$ROOT/ref"
WORK="$ROOT/work"

# The one place a machine's code names the origin. Windows holds the key in its own OpenSSH agent, which
# Git's ssh does not speak to (machines/keys), so its git is told to use Windows' ssh.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) ORIGIN=${FCPM_ORIGIN_URL:-ssh://git@origin.local/srv/origin}
                        ORIGIN_SSH="C:/Windows/System32/OpenSSH/ssh.exe -o BatchMode=yes" ;;
  *)                    ORIGIN=${FCPM_ORIGIN_URL:-fcpm-origin:/srv/origin}; ORIGIN_SSH="" ;;
esac
export GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never
[ -z "$ORIGIN_SSH" ] || export GIT_SSH_COMMAND="$ORIGIN_SSH"

# GitHub's owner/repo is the origin's path.
origin_path() { printf '%s\n' "$1" | sed -n 's#^https://\([^@/]*@\)\{0,1\}github\.com/\([^/]*/[^/]*\)$#\2#p' | sed 's#\.git$##'; }

# A checkout's origin, its submodules' URLs and each checked-out submodule's origin, at our origin.
to_origin() {
  local d=$1 u p key url sp
  u=$(git -C "$d" remote get-url origin 2>/dev/null) || return 0
  p=$(origin_path "$u"); [ -z "$p" ] || git -C "$d" remote set-url origin "$ORIGIN/$p"
  [ -z "$ORIGIN_SSH" ] || git -C "$d" config core.sshCommand "$ORIGIN_SSH"
  [ -f "$d/.gitmodules" ] || return 0
  git -C "$d" config -f .gitmodules --get-regexp '^submodule\..*\.url$' | while read -r key url; do
    p=$(origin_path "$url"); [ -n "$p" ] || continue
    git -C "$d" config "$key" "$ORIGIN/$p"
    sp=$(git -C "$d" config -f .gitmodules --get "${key%.url}.path") || continue
    [ -e "$d/$sp/.git" ] || continue
    git -C "$d/$sp" remote set-url origin "$ORIGIN/$p"
    [ -z "$ORIGIN_SSH" ] || git -C "$d/$sp" config core.sshCommand "$ORIGIN_SSH"
  done
}

default_branch() {
  git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || echo main
}

# troves/ are submodules: check each out at the commit this repo pins. --checkout reaches the
# private ones, which say `update = none` so that CI's token never tries them.
troves_one() {
  local d=$1
  to_origin "$d"
  # The rest first, and theirs inside them: `update = none` (troves/, wix, the engines) keeps a plain
  # update off those, which --checkout below reaches.
  if [ -f "$d/.gitmodules" ]; then
    git -C "$d" submodule update --init --recursive --quiet >/dev/null 2>&1 \
      || printf '%-34s submodules: UPDATE FAILED\n' "$(basename "$d")"
  fi
  git -C "$d" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | grep -q ' troves/' || return 0
  git -C "$d" submodule update --init --checkout --quiet -- troves >/dev/null 2>&1 \
    || printf '%-34s troves: SUBMODULE UPDATE FAILED\n' "$(basename "$d")"
}

# A fetch from the origin, never a prompt: nobody may be at the machine.
fetch_quiet() {
  to_origin "$1"
  git -C "$1" fetch --prune --quiet 2>/dev/null
}

each() { for d in "$REF"/*/; do [ -e "$d/.git" ] && "$@" "${d%/}"; done; }

line() {
  local d=$1 name br def up behind ahead dirty
  name=$(basename "$d"); br=$(git -C "$d" branch --show-current)
  def=$(default_branch "$d"); def=${def:-main}
  behind=$(git -C "$d" rev-list --count "HEAD..origin/$def" 2>/dev/null || echo ?)
  ahead=$(git -C "$d" rev-list --count "origin/$def..HEAD" 2>/dev/null || echo ?)
  dirty=$(git -C "$d" status --porcelain | wc -l | tr -d ' ')
  printf '%-34s %-8s behind=%-3s ahead=%-3s dirty=%s\n' "$name" "$br" "$behind" "$ahead" "$dirty"
}

pull_one() {
  local d=$1 name def br
  name=$(basename "$d")
  if ! fetch_quiet "$d"; then
    printf '%-34s FETCH FAILED from %s\n' "$name" "$(git -C "$d" remote get-url origin 2>/dev/null)"; return
  fi
  def=$(default_branch "$d"); def=${def:-main}
  br=$(git -C "$d" branch --show-current)
  if [ "$br" != "$def" ]; then printf '%-34s skipped: on %s, not %s\n' "$name" "$br" "$def"; return; fi
  if [ -n "$(git -C "$d" status --porcelain --ignore-submodules=all)" ]; then printf '%-34s skipped: dirty\n' "$name"; return; fi
  local before after
  before=$(git -C "$d" rev-parse --short HEAD)
  if git -C "$d" merge --ff-only --quiet "origin/$def" 2>/dev/null; then
    after=$(git -C "$d" rev-parse --short HEAD)
    if [ "$before" = "$after" ]; then printf '%-34s current   %s\n' "$name" "$after"
    else printf '%-34s UPDATED   %s -> %s  (%s)\n' "$name" "$before" "$after" \
      "$(git -C "$d" log -1 --format=%s)"; fi
    troves_one "$d"
  else
    printf '%-34s skipped: diverged from origin/%s\n' "$name" "$def"
  fi
}

case "${1:-status}" in
  pull)   shift; if [ $# -gt 0 ]; then for r in "$@"; do
             [ -e "$REF/$r/.git" ] || { echo "no such repo: $REF/$r" >&2; exit 1; }
             pull_one "$REF/$r"; done
           else each pull_one; fi ;;
  status) each line ;;
  origin) echo "$ORIGIN" ;;
  point)  shift; if [ $# -gt 0 ]; then for r in "$@"; do [ -e "$REF/$r/.git" ] && to_origin "$REF/$r"; done
          else each to_origin; fi ;;
  clone)
    p=${2:?owner/repo}; dest="$REF/$(basename "$p")"
    [ -e "$dest/.git" ] && { echo "$dest is already here" >&2; exit 0; }
    mkdir -p "$REF" && git clone --quiet "$ORIGIN/$p" "$dest" && to_origin "$dest" && echo "$dest" ;;
  work)
    repo=${2:?repo name}; branch=${3:?branch name}
    src="$REF/$repo"; [ -e "$src/.git" ] || { echo "no such repo: $src" >&2; exit 1; }
    fetch_quiet "$src" || echo "fetch failed; cutting from the origin/main already here" >&2
    def=$(default_branch "$src"); def=${def:-main}
    dest="$WORK/$repo@${branch//\//-}"
    mkdir -p "$WORK"
    git -C "$src" worktree add -b "$branch" "$dest" "origin/$def" && troves_one "$dest" && echo "$dest" ;;
  done)
    repo=${2:?repo name}; branch=${3:?branch name}
    wt="$WORK/$repo@${branch//\//-}"
    # Git will not remove a worktree that has ever had a submodule checked out, clean or not, and only
    # --force skips that. Ours are pins (troves_one), so the check is ours: nothing uncommitted here or
    # in a submodule, and no commit a submodule's remotes lack. Then --force, and only then.
    if [ -d "$wt" ] && [ -d "$(git -C "$wt" rev-parse --git-dir 2>/dev/null)/modules" ]; then
      [ -z "$(git -C "$wt" status --porcelain --ignore-submodules=none)" ] ||
        { echo "refs: left $wt: it has changes (git status)" >&2; exit 1; }
      own=$(git -C "$wt" submodule foreach --quiet --recursive \
        '[ -z "$(git rev-list -n1 HEAD --branches --not --remotes 2>/dev/null)" ] || echo "$displaypath"')
      [ -z "$own" ] || { echo "refs: left $wt: commits only these submodules have: $(echo $own)" >&2; exit 1; }
      exec git -C "$REF/$repo" worktree remove --force "$wt"
    fi
    git -C "$REF/$repo" worktree remove "$wt" ;;
  *) sed -n '2,11p' "$0"; exit 1 ;;
esac
